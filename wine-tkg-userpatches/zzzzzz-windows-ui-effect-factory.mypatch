+done:
+    if (bitmap) ID2D1Bitmap_Release( bitmap );
+    if (image) ID2D1Image_Release( image );
+    if (output) ID2D1DeviceContext_Release( output );
+    if (target) ID2D1BitmapRenderTarget_Release( target );
+    return hr;
+}
