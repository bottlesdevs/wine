--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -6133,6 +6133,9 @@ ULONG get_type_size( WS_TYPE type, const void *desc )
     case WS_XML_QNAME_TYPE:
         return sizeof(WS_XML_QNAME);

+    case WS_XML_BUFFER_TYPE:
+        return sizeof(WS_XML_BUFFER *);
+
     case WS_DESCRIPTION_TYPE:
         return sizeof(WS_STRUCT_DESCRIPTION *);

@@ -6147,7 +6150,7 @@ ULONG get_type_size( WS_TYPE type, const void *desc )
         return desc_union->size;
     }
     case WS_ANY_ATTRIBUTES_TYPE:
-        return 0;
+        return sizeof(WS_ANY_ATTRIBUTES);

     default:
         ERR( "unhandled type %u\n", type );
@@ -6188,6 +6191,7 @@ static WS_READ_OPTION get_field_read_option( WS_TYPE type, ULONG options )
     case WS_STRUCT_TYPE:
     case WS_ENUM_TYPE:
     case WS_UNION_TYPE:
