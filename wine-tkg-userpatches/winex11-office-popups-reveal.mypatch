winex11: reveal staged Office popups on surface flush.

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index cc3b618..08ab9a6 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -456,6 +456,17 @@ static BOOL thickframe_managed( DWORD style )
     return cached;
 }

+static BOOL is_office_popup( HWND hwnd )
+{
+    static const WCHAR office_popup[] = u"Net UI Tool Window";
+    WCHAR class_name[64];
+    UNICODE_STRING name = {.Buffer = class_name, .MaximumLength = sizeof(class_name)};
+
+    return NtUserGetClassName( hwnd, FALSE, &name ) == ARRAY_SIZE(office_popup) - 1 &&
+           !wcsncmp( class_name, office_popup, ARRAY_SIZE(office_popup) - 1 ) &&
+           !(NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_CAPTION) &&
+           !NtUserInternalGetWindowText( hwnd, class_name, ARRAY_SIZE(class_name) );
+}

 /***********************************************************************
  *		is_window_managed
@@ -467,6 +478,7 @@ static BOOL is_window_managed( HWND hwnd, UINT swp_flags, BOOL fullscreen )
     DWORD style, ex_style;

     if (!managed_mode) return FALSE;
+    if (is_office_popup( hwnd )) return FALSE;

     /* child windows are not managed */
     style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
@@ -1625,7 +1637,7 @@ static void window_set_config( struct x11drv_win_data *data, RECT rect, BOOL abo
         changes.stack_mode = Below;
         mask |= CWStackMode;
     }
-    else if (above)
+    else if (above && !data->reveal_on_surface_flush)
     {
         changes.stack_mode = Above;
         mask |= CWStackMode;
@@ -1918,6 +1930,58 @@ static void window_set_wm_state( struct x11drv_win_data *data, UINT new_state, B
     if (x11drv_thread_data()->ignore_focus_hack && new_state == WithdrawnState) data->wm_state_serial = 0;
 }

+static BOOL surface_image_has_content( XImage *image, const RECT *dirty )
+{
+    unsigned long colors[32];
+    unsigned long color_mask = image->red_mask | image->green_mask | image->blue_mask;
+    unsigned int color_count = 0;
+    int x, y, i;
+
+    if (dirty->left >= dirty->right || dirty->top >= dirty->bottom) return FALSE;
+    for (y = dirty->top; y < dirty->bottom; y++)
+        for (x = dirty->left; x < dirty->right; x++)
+        {
+            unsigned long color = XGetPixel( image, x, y ) & color_mask;
+
+            for (i = 0; i < color_count; i++) if (colors[i] == color) break;
+            if (i == color_count)
+            {
+                colors[color_count++] = color;
+                if (color_count == ARRAY_SIZE(colors)) return TRUE;
+            }
+        }
+    return FALSE;
+}
+
+BOOL prepare_window_surface_flush( HWND hwnd, Window window, XImage *image, const RECT *dirty )
+{
+    struct x11drv_win_data *data;
+    BOOL reveal = FALSE;
+
+    if (!(data = get_win_data( hwnd ))) return FALSE;
+    if (data->whole_window == window && data->reveal_on_surface_flush)
+    {
+        XLowerWindow( gdi_display, window );
+        reveal = surface_image_has_content( image, dirty );
+    }
+    release_win_data( data );
+    return reveal;
+}
+
+void reveal_window_after_surface_flush( HWND hwnd, Window window )
+{
+    struct x11drv_win_data *data;
+
+    XSync( gdi_display, False );
+    if (!(data = get_win_data( hwnd ))) return;
+    if (data->whole_window == window && data->reveal_on_surface_flush)
+    {
+        data->reveal_on_surface_flush = FALSE;
+        XRaiseWindow( gdi_display, window );
+    }
+    release_win_data( data );
+}
+
 static void window_set_managed( struct x11drv_win_data *data, BOOL new_managed )
 {
     XSetWindowAttributes attr = {.override_redirect = !new_managed};
@@ -3681,8 +3745,11 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
 {
     struct x11drv_win_data *data;
     UINT ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ), new_style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+    UINT desired_state;
     struct window_rects old_rects;
-    BOOL is_managed, was_fullscreen, activate = !(swp_flags & SWP_NOACTIVATE), fullscreen = !!(swp_flags & WINE_SWP_FULLSCREEN);
+    BOOL is_managed, was_fullscreen, stage_office_popup = FALSE;
+    BOOL activate = !(swp_flags & SWP_NOACTIVATE);
+    BOOL fullscreen = !!(swp_flags & WINE_SWP_FULLSCREEN);

     if ((is_managed = is_window_managed( hwnd, swp_flags, fullscreen ))) make_owner_managed( hwnd );
     set_surface_window_rects( surface, new_rects );
@@ -3780,7 +3847,27 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
 #endif
     }

-    window_set_wm_state( data, get_desired_wm_state( new_style, new_rects ), activate );
+    desired_state = get_desired_wm_state( new_style, new_rects );
+    if (data->pending_state.wm_state == WithdrawnState && surface && desired_state == NormalState &&
+        is_office_popup( hwnd ) && (new_style & WS_POPUP) && (ex_style & WS_EX_TOOLWINDOW) &&
+        !(ex_style & WS_EX_LAYERED) &&
+        new_rects->window.right - new_rects->window.left < 800 &&
+        new_rects->window.bottom - new_rects->window.top < 500)
+    {
+        data->reveal_on_surface_flush = TRUE;
+        stage_office_popup = TRUE;
+    }
+    else if (desired_state != NormalState && data->reveal_on_surface_flush)
+    {
+        data->reveal_on_surface_flush = FALSE;
+    }
+    window_set_wm_state( data, desired_state, activate );
+    if (stage_office_popup)
+    {
+        XLowerWindow( data->display, data->whole_window );
+        XSync( data->display, False );
+    }
+
     if (!data->wm_state_serial && data->pending_state.wm_state != WithdrawnState)
     {
         if (swp_flags & (SWP_FRAMECHANGED | SWP_STATECHANGED)) set_wm_hints( data );
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 1e3f213..caa7440 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -700,6 +700,7 @@ struct x11drv_win_data
     UINT        is_resizable : 1; /* window is allowed to be resized by the window manager */
     UINT        net_wm_state_hack : 1; /* hacking around KWin sticky fullscreen windows */
     UINT        force_below_hack : 1; /* hacking fullscreen black window which is supposed to be order after another window */
+    UINT        reveal_on_surface_flush : 1; /* reveal an Office popup after its contents are painted */
     Window      embedder;       /* window id of embedder */
     Pixmap         icon_pixmap;
     Pixmap         icon_mask;
@@ -728,6 +729,8 @@ extern Window X11DRV_get_whole_window( HWND hwnd );
 extern Window get_dummy_parent(void);

 extern void set_surface_window_rects( struct window_surface *window_surface, const struct window_rects *rects );
+extern BOOL prepare_window_surface_flush( HWND hwnd, Window window, XImage *image, const RECT *dirty );
+extern void reveal_window_after_surface_flush( HWND hwnd, Window window );
 extern BOOL window_is_reparenting( HWND hwnd );
 extern BOOL window_should_take_focus( HWND hwnd, Time time );
 extern BOOL window_has_pending_wm_state( HWND hwnd, UINT state );
diff --git a/dlls/winex11.drv/event.c b/dlls/winex11.drv/event.c
index ab408e3..6d9b687 100644
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -652,6 +652,7 @@ static void set_input_focus( struct x11drv_win_data *data )
     DWORD timestamp;

     if (!data->whole_window) return;
+    if (data->reveal_on_surface_flush) return;

     if (EVENT_x11_time_to_win32_time(0))
         /* ICCCM says don't use CurrentTime, so try to use last message time if possible */
@@ -1845,7 +1846,6 @@ static void handle_xdnd_leave_event( HWND hwnd, XClientMessageEvent *event )
     drag_drop_leave();
 }

-
 struct client_message_handler
 {
     int    atom;                                  /* protocol atom */
diff --git a/dlls/winex11.drv/bitblt.c b/dlls/winex11.drv/bitblt.c
index ad3a863..0d3d475 100644
--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -1805,6 +1805,7 @@ static BOOL x11drv_surface_flush( struct window_surface *window_surface, const R
 {
     UINT alpha_mask = window_surface->alpha_mask, alpha_bits = window_surface->alpha_bits;
     struct x11drv_window_surface *surface = get_x11_surface( window_surface );
+    BOOL reveal;
     XImage *ximage = surface->image->ximage;
     const unsigned char *src = color_bits;
     unsigned char *dst = (unsigned char *)ximage->data;
@@ -1866,11 +1867,13 @@ static BOOL x11drv_surface_flush( struct window_surface *window_surface, const R
 #endif /* HAVE_LIBXSHAPE */
     }

+    reveal = prepare_window_surface_flush( window_surface->hwnd, surface->window, ximage, dirty );
     if (!put_shm_image( ximage, &surface->image->shminfo, surface->window, surface->gc, &rect, dirty ))
         XPutImage( gdi_display, surface->window, surface->gc, ximage, dirty->left,
                    dirty->top, rect.left + dirty->left, rect.top + dirty->top,
                    dirty->right - dirty->left, dirty->bottom - dirty->top );

+    if (reveal) reveal_window_after_surface_flush( window_surface->hwnd, surface->window );
     XFlush( gdi_display );

     return TRUE;
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 6dbf3be..0073cb8 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -1796,10 +1796,17 @@ HDC WINAPI NtUserBeginPaint( HWND hwnd, PAINTSTRUCT *ps )
 BOOL WINAPI NtUserEndPaint( HWND hwnd, const PAINTSTRUCT *ps )
 {
     struct window_surface *surface;
+    DWORD style, ex_style;

     NtUserShowCaret( hwnd );
     flush_window_surfaces( FALSE );
-    if ((surface = window_surface_get( hwnd ))) window_surface_release( surface );
+    if ((surface = window_surface_get( hwnd )))
+    {
+        style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+        ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
+        if ((style & WS_POPUP) && (ex_style & WS_EX_TOOLWINDOW)) window_surface_flush( surface );
+        window_surface_release( surface );
+    }
     else                                        user_driver->pProcessEvents( 0 );
     if (!ps) return FALSE;
     release_dc( hwnd, ps->hdc, TRUE );
