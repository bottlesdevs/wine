+        bounds.left = min(inputs[0].left, inputs[1].left);
+        bounds.top = min(inputs[0].top, inputs[1].top);
+        bounds.right = max(inputs[0].right, inputs[1].right);
+        bounds.bottom = max(inputs[0].bottom, inputs[1].bottom);
+    }
+    return bounds;
 }
 
