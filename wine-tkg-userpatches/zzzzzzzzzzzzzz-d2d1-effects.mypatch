+    "                + colour.b * color_matrix[2] + colour.a * color_matrix[3] + color_matrix[4];\n"
+    "        if (clamp_output) colour = saturate(colour);\n"
+    "        if (color_matrix_mode == 1) colour.rgb *= colour.a;\n"
     "    }\n"
