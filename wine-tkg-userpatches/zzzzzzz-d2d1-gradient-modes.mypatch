     "    uint i;\n"
     "\n"
+    "    if (extend_mode == 1) position = frac(position);\n"
+    "    else if (extend_mode == 2)\n"
+    "    {\n"
+    "        position = frac(position * 0.5) * 2.0;\n"
+    "        if (position > 1.0) position = 2.0 - position;\n"
+    "    }\n"
     "    p_low = gradient.Load(0).x;\n"
     "    c_low = gradient.Load(1);\n"
     "    c_high = c_low;\n"
