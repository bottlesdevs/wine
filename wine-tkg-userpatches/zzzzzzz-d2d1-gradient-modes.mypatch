+    "float srgb_to_linear(float value)\n"
+    "{\n"
+    "    return value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4);\n"
+    "}\n"
+    "float linear_to_srgb(float value)\n"
+    "{\n"
+    "    return value <= 0.0031308 ? value * 12.92 : 1.055 * pow(value, 1.0 / 2.4) - 0.055;\n"
+    "}\n"
+    "float4 interpolate_gradient(float4 low, float4 high, float amount, uint gamma)\n"
+    "{\n"
+    "    float4 result;\n"
+    "    if (gamma == 0) return lerp(low, high, amount);\n"
+    "    low.rgb = float3(srgb_to_linear(low.r), srgb_to_linear(low.g), srgb_to_linear(low.b));\n"
+    "    high.rgb = float3(srgb_to_linear(high.r), srgb_to_linear(high.g), srgb_to_linear(high.b));\n"
+    "    result = lerp(low, high, amount);\n"
+    "    result.rgb = float3(linear_to_srgb(result.r), linear_to_srgb(result.g), linear_to_srgb(result.b));\n"
+    "    return result;\n"
+    "}\n"
+    "float4 sample_gradient(Buffer<float4> gradient, uint stop_count, float position, uint gamma, uint extend_mode)\n"
     "{\n"
     "    float4 c_low, c_high;\n"
