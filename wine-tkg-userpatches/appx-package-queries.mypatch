 static inline struct package_manager *impl_from_IPackageManager( IPackageManager *iface )
 {
-    return CONTAINING_RECORD( iface, struct package_manager, IPackageManager_iface );
+    return CONTAINING_RECORD( iface, struct package_manager, IPackageManager_iface );
+}
