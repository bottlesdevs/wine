index 0000000..9921c2a
--- /dev/null
+++ b/dlls/appxdeploymentclient/stage_options.c
@@ -0,0 +1,299 @@
+/* WinRT Windows.Management.Deployment.StagePackageOptions Implementation
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
