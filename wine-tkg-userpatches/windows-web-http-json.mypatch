+    return cert_vector_GetAt( &impl_from_cert_view( iface )->IVector_ChainValidationResult_iface, index, value );
+}
+
+static HRESULT WINAPI cert_view_get_Size( IVectorView_ChainValidationResult *iface, UINT32 *value )
