+static HRESULT WINAPI method_statics_QueryInterface( IHttpMethodStatics *iface, REFIID iid, void **out )
+{
+    return method_factory_query_interface( impl_from_IHttpMethodStatics( iface ), iid, out );
+}
+
+static ULONG WINAPI method_statics_AddRef( IHttpMethodStatics *iface )
+{
+    return InterlockedIncrement( &impl_from_IHttpMethodStatics( iface )->ref );
+}
+
+static ULONG WINAPI method_statics_Release( IHttpMethodStatics *iface )
+{
+    return InterlockedDecrement( &impl_from_IHttpMethodStatics( iface )->ref );
+}
+
+static HRESULT WINAPI method_statics_GetIids( IHttpMethodStatics *iface, ULONG *count, IID **iids )
+{
+    return method_factory_GetIids( &impl_from_IHttpMethodStatics( iface )->IActivationFactory_iface, count, iids );
+}
+
+static HRESULT WINAPI method_statics_GetRuntimeClassName( IHttpMethodStatics *iface, HSTRING *class_name )
+{
+    return method_factory_get_runtime_class_name( class_name );
+}
+
+static HRESULT WINAPI method_statics_GetTrustLevel( IHttpMethodStatics *iface, TrustLevel *trust_level )
+{
+    return method_factory_get_trust_level( trust_level );
+}
+
+static HRESULT create_standard_method( const WCHAR *value, IHttpMethod **method )
+{
+    HSTRING string = NULL;
+    HRESULT hr;
+
+    if (SUCCEEDED( hr = WindowsCreateString( value, wcslen( value ), &string ) ))
+        hr = http_method_create( string, method );
+    WindowsDeleteString( string );
+    return hr;
+}
+
+#define DEFINE_HTTP_METHOD_STATIC( name, value )                                                                       \
+    static HRESULT WINAPI method_statics_get_##name( IHttpMethodStatics *iface, IHttpMethod **method )                 \
+    {                                                                                                                  \
+        return create_standard_method( value, method );                                                                \
+    }
+
+DEFINE_HTTP_METHOD_STATIC( Delete, L"DELETE" )
+DEFINE_HTTP_METHOD_STATIC( Get, L"GET" )
+DEFINE_HTTP_METHOD_STATIC( Head, L"HEAD" )
+DEFINE_HTTP_METHOD_STATIC( Options, L"OPTIONS" )
+DEFINE_HTTP_METHOD_STATIC( Patch, L"PATCH" )
+DEFINE_HTTP_METHOD_STATIC( Post, L"POST" )
+DEFINE_HTTP_METHOD_STATIC( Put, L"PUT" )
+
+#undef DEFINE_HTTP_METHOD_STATIC
+
+static const IHttpMethodStaticsVtbl method_statics_vtbl = {
+    method_statics_QueryInterface,
+    method_statics_AddRef,
+    method_statics_Release,
+    method_statics_GetIids,
+    method_statics_GetRuntimeClassName,
+    method_statics_GetTrustLevel,
+    method_statics_get_Delete,
+    method_statics_get_Get,
+    method_statics_get_Head,
+    method_statics_get_Options,
+    method_statics_get_Patch,
+    method_statics_get_Post,
+    method_statics_get_Put,
+};
+
+static struct http_method_factory http_method_factory_impl = {
+    { &method_activation_factory_vtbl },
+    { &method_specific_factory_vtbl },
+    { &method_statics_vtbl },
+    1,
+};
+
+IActivationFactory *http_method_factory = &http_method_factory_impl.IActivationFactory_iface;
