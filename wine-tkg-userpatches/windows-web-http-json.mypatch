+static HRESULT create_event_args( IAppCapabilityAccessChangedEventArgs **ret )
+{
+    struct app_capability_event_args *impl;
+
+    *ret = NULL;
+    if (!( impl = calloc( 1, sizeof( *impl ) ) ))
