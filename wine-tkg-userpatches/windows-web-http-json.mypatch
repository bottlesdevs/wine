diff --git a/include/windows.web.http.idl b/include/windows.web.http.idl
new file mode 100644
index 00000000000..a83ee3891e9
--- /dev/null
+++ b/include/windows.web.http.idl
@@ -0,0 +1,619 @@
+/* Windows.Web.Http interface definitions
+ *
+ * Copyright 2026 Wine contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifdef __WIDL__
+#pragma winrt ns_prefix
+#endif
+
+import "inspectable.idl";
+import "windows.foundation.idl";
+import "windows.storage.streams.idl";
+import "windows.security.credentials.idl";
+namespace Windows.Security.Cryptography.Certificates
+{
+    typedef enum ChainValidationResult
+    {
+        Success = 0,
+        Untrusted = 1,
+        Revoked = 2,
+        Expired = 3,
+        IncompleteChain = 4,
+        InvalidSignature = 5,
+        WrongUsage = 6,
+        InvalidName = 7,
+        InvalidCertificateAuthorityPolicy = 8,
+        BasicConstraintsError = 9,
+        UnknownCriticalExtension = 10,
+        RevocationInformationMissing = 11,
+        RevocationFailure = 12,
+        OtherErrors = 13,
+    } ChainValidationResult;
+}
+
+namespace Windows.Security.Credentials
+{
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        uuid(6ab18989-c720-41a7-a6c1-feadb36329a0)
+    ]
+    interface IPasswordCredential : IInspectable
+    {
+        [propget] HRESULT Resource([out, retval] HSTRING *value);
+        [propput] HRESULT Resource([in] HSTRING value);
+        [propget] HRESULT UserName([out, retval] HSTRING *value);
+        [propput] HRESULT UserName([in] HSTRING value);
+        [propget] HRESULT Password([out, retval] HSTRING *value);
+        [propput] HRESULT Password([in] HSTRING value);
+    }
+    [contract(Windows.Foundation.UniversalApiContract, 1.0), marshaling_behavior(agile), threading(both)]
+    runtimeclass PasswordCredential
+    {
+        [default] interface Windows.Security.Credentials.IPasswordCredential;
+    }
+}
+
+namespace Windows.Web.Http.Headers
+{
+    declare {
+        interface Windows.Foundation.Collections.IKeyValuePair<HSTRING, HSTRING>;
+        interface Windows.Foundation.Collections.IIterable<Windows.Foundation.Collections.IKeyValuePair<HSTRING, HSTRING> *>;
+        interface Windows.Foundation.Collections.IMap<HSTRING, HSTRING>;
+    }
+    interface IHttpRequestHeaderCollection;
+    interface IHttpResponseHeaderCollection;
+    interface IHttpContentHeaderCollection;
+    runtimeclass HttpRequestHeaderCollection;
+    runtimeclass HttpResponseHeaderCollection;
+    runtimeclass HttpContentHeaderCollection;
+}
