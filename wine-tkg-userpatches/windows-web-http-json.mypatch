+    return cert_vector_get_Size( &impl_from_cert_view( iface )->IVector_ChainValidationResult_iface, value );
+}
+
+static HRESULT WINAPI cert_view_IndexOf( IVectorView_ChainValidationResult *iface, ChainValidationResult value,
+                                         UINT32 *index, boolean *found )
