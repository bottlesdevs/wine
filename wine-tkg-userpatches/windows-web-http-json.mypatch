+static HRESULT WINAPI capability_operation_info_Cancel( IAsyncInfo *iface )
+{
+    return capability_operation_is_closed( impl_from_capability_operation_info( iface ) ) ? E_ILLEGAL_METHOD_CALL
+                                                                                          : S_OK;
+}
