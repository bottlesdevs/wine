+    impl->IAsyncInfo_iface.lpVtbl = &capability_operation_info_vtbl;
+    InitializeSRWLock( &impl->lock );
+    impl->ref = 1;
+    impl->result = result;
+    *out = &impl->IAsyncOperation_AppCapabilityAccessStatus_iface;
+    return S_OK;
+}
