+struct http_method_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IHttpMethodFactory IHttpMethodFactory_iface;
+    IHttpMethodStatics IHttpMethodStatics_iface;
+    LONG ref;
+};
