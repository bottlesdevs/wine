+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (( *handler = impl->handler ))
+        IAsyncOperationCompletedHandler_AppCapabilityAccessStatus_AddRef( *handler );
+    ReleaseSRWLockShared( &impl->lock );
+    return S_OK;
+}
