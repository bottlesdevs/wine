+            break;
+        default:
+            __FIAsyncOperationWithProgressCompletedHandler_2_Windows__CStorage__CStreams__CIInputStream_HttpProgress_Invoke(
+                (void *)completed, &impl->input_iface, status );
+            break;
+        }
+        IUnknown_Release( completed );
+    }
