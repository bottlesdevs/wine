+        case HTTP_ASYNC_STRING:
+            __FIAsyncOperationWithProgressCompletedHandler_2_HSTRING_HttpProgress_Invoke( (void *)completed,
+                                                                                          &impl->string_iface, status );
+            break;
+        case HTTP_ASYNC_BUFFER:
