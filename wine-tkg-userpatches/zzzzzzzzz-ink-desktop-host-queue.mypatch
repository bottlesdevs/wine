new file mode 100644
--- /dev/null
+++ b/dlls/inkobjcore/inkobjcore.rgs
@@ -0,0 +1,13 @@
+HKCR
+{
+    NoRemove CLSID
+    {
+        ForceRemove '{062584A6-F830-4BDC-A4D2-0A10AB062B1D}' = s 'Ink Desktop Host'
+        {
+            InprocServer32 = s '%MODULE%'
+            {
+                val ThreadingModel = s 'Both'
+            }
+        }
+    }
+}
