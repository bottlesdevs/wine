+DEFINE_IINSPECTABLE( shape_visual, IShapeVisual, struct sprite_visual, ISpriteVisual_iface )
+
+static HRESULT WINAPI shape_visual_get_Shapes( IShapeVisual *iface, IVector_CompositionShape **value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IShapeVisual(iface)->shapes;
+    IVector_CompositionShape_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_visual_get_ViewBox( IShapeVisual *iface, ICompositionViewBox **value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IShapeVisual(iface)->view_box;
+    if (*value) ICompositionViewBox_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_visual_put_ViewBox( IShapeVisual *iface, ICompositionViewBox *value )
+{
+    struct sprite_visual *impl = impl_from_IShapeVisual( iface );
+
+    if (value) ICompositionViewBox_AddRef( value );
+    if (impl->view_box) ICompositionViewBox_Release( impl->view_box );
+    impl->view_box = value;
+    return S_OK;
+}
+
+static const IShapeVisualVtbl shape_visual_vtbl =
