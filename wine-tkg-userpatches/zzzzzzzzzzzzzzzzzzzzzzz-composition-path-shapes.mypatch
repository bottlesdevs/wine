+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+#include "private.h"
+#include "d2d1_1.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+struct sprite_shape
+{
+    ICompositionSpriteShape ICompositionSpriteShape_iface;
+    ICompositionShape ICompositionShape_iface;
+    ICompositionObject ICompositionObject_iface;
+    LONG ref;
+    ICompositor *compositor;
+    ICompositionPropertySet *properties;
+    struct Vector2 center;
+    struct Vector2 offset;
+    FLOAT rotation;
+    FLOAT rotation_degrees;
+    struct Vector2 scale;
+    struct Matrix3x2 transform;
+    ICompositionBrush *fill;
+    ICompositionGeometry *geometry;
+    boolean non_scaling;
+    ICompositionBrush *stroke;
+    __FIVector_1_float *dashes;
+    enum CompositionStrokeCap dash_cap;
+    FLOAT dash_offset;
+    enum CompositionStrokeCap end_cap;
+    enum CompositionStrokeLineJoin join;
+    FLOAT miter_limit;
+    enum CompositionStrokeCap start_cap;
+    FLOAT thickness;
+};
+
+static inline struct sprite_shape *impl_from_ICompositionSpriteShape( ICompositionSpriteShape *iface )
+{
+    return CONTAINING_RECORD( iface, struct sprite_shape, ICompositionSpriteShape_iface );
+}
+
+static HRESULT WINAPI sprite_shape_QueryInterface( ICompositionSpriteShape *iface, REFIID iid, void **out )
+{
+    struct sprite_shape *impl = impl_from_ICompositionSpriteShape( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_ICompositionSpriteShape )) *out = iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionShape )) *out = &impl->ICompositionShape_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject )) *out = &impl->ICompositionObject_iface;
+    else return E_NOINTERFACE;
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI sprite_shape_AddRef( ICompositionSpriteShape *iface )
+{
+    return InterlockedIncrement( &impl_from_ICompositionSpriteShape(iface)->ref );
+}
+
+static ULONG WINAPI sprite_shape_Release( ICompositionSpriteShape *iface )
+{
+    struct sprite_shape *impl = impl_from_ICompositionSpriteShape( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->fill) ICompositionBrush_Release( impl->fill );
+        if (impl->stroke) ICompositionBrush_Release( impl->stroke );
+        if (impl->geometry) ICompositionGeometry_Release( impl->geometry );
+        ICompositionPropertySet_Release( impl->properties );
+        ICompositor_Release( impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI sprite_shape_GetIids( ICompositionSpriteShape *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = CoTaskMemAlloc( 3 * sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_ICompositionSpriteShape;
+    (*iids)[1] = IID_ICompositionShape;
+    (*iids)[2] = IID_ICompositionObject;
+    *count = 3;
+    return S_OK;
+}
+
+static HRESULT WINAPI sprite_shape_GetRuntimeClassName( ICompositionSpriteShape *iface, HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_UI_Composition_CompositionSpriteShape;
+
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen(class_name), name );
+}
+
+static HRESULT WINAPI sprite_shape_GetTrustLevel( ICompositionSpriteShape *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+DEFINE_IINSPECTABLE( shape, ICompositionShape, struct sprite_shape, ICompositionSpriteShape_iface )
+DEFINE_IINSPECTABLE( shape_object, ICompositionObject, struct sprite_shape, ICompositionSpriteShape_iface )
+
+static HRESULT WINAPI shape_object_get_Compositor( ICompositionObject *iface, ICompositor **value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICompositionObject(iface)->compositor;
+    ICompositor_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_object_get_Dispatcher( ICompositionObject *iface,
+        ICoreDispatcher **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI shape_object_get_Properties( ICompositionObject *iface, ICompositionPropertySet **value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICompositionObject(iface)->properties;
+    ICompositionPropertySet_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_object_StartAnimation( ICompositionObject *iface, HSTRING name,
+        ICompositionAnimation *animation )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI shape_object_StopAnimation( ICompositionObject *iface, HSTRING name )
+{
+    return E_NOTIMPL;
+}
+
+static const ICompositionObjectVtbl shape_object_vtbl =
+{
+    shape_object_QueryInterface,
+    shape_object_AddRef,
+    shape_object_Release,
+    shape_object_GetIids,
+    shape_object_GetRuntimeClassName,
+    shape_object_GetTrustLevel,
+    shape_object_get_Compositor,
+    shape_object_get_Dispatcher,
+    shape_object_get_Properties,
+    shape_object_StartAnimation,
+    shape_object_StopAnimation,
+};
+
+static HRESULT WINAPI shape_get_CenterPoint( ICompositionShape *iface, struct Vector2 *value )
+{
+    struct sprite_shape *impl = impl_from_ICompositionShape( iface );
+
+    if (!value) return E_POINTER;
+    *value = impl->center;
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_put_CenterPoint( ICompositionShape *iface, struct Vector2 value )
+{
+    struct sprite_shape *impl = impl_from_ICompositionShape( iface );
+
+    impl->center = value;
+    return S_OK;
