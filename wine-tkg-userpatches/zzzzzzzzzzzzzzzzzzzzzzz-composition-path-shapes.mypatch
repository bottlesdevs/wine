+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "d2d1.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ui);
+
+static const GUID iid_geometry_interop =
+    {0x0657af73,0x53fd,0x47cf,{0x84,0xff,0xc8,0x49,0x2d,0x2a,0x80,0xa3}};
+
+struct geometry_interop_iface;
+struct geometry_interop_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( struct geometry_interop_iface *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( struct geometry_interop_iface * );
+    ULONG (WINAPI *Release)( struct geometry_interop_iface * );
+    HRESULT (WINAPI *GetGeometry)( struct geometry_interop_iface *, ID2D1Geometry ** );
+    HRESULT (WINAPI *TryGetGeometryUsingFactory)( struct geometry_interop_iface *, ID2D1Factory *, ID2D1Geometry ** );
+};
+
+struct geometry_interop_iface
+{
+    const struct geometry_interop_vtbl *lpVtbl;
+};
+
+struct composition_path
+{
+    ICompositionPath ICompositionPath_iface;
+    IGeometrySource2D IGeometrySource2D_iface;
+    struct geometry_interop_iface interop_iface;
+    LONG ref;
+    ID2D1Geometry *geometry;
+};
+
+static inline struct composition_path *impl_from_ICompositionPath( ICompositionPath *iface )
+{
+    return CONTAINING_RECORD( iface, struct composition_path, ICompositionPath_iface );
+}
+
+static HRESULT geometry_clone( ID2D1Geometry *geometry, ID2D1Factory *factory, ID2D1Geometry **result )
+{
+    ID2D1PathGeometry *path;
+    ID2D1GeometrySink *sink;
+    HRESULT hr, close_hr;
+
+    *result = NULL;
+    if (FAILED(hr = ID2D1Factory_CreatePathGeometry( factory, &path ))) return hr;
+    if (SUCCEEDED(hr = ID2D1PathGeometry_Open( path, &sink )))
+    {
+        hr = ID2D1Geometry_Simplify( geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_CUBICS_AND_LINES,
+                NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, (ID2D1SimplifiedGeometrySink *)sink );
+        close_hr = ID2D1GeometrySink_Close( sink );
+        ID2D1GeometrySink_Release( sink );
+        if (SUCCEEDED(hr)) hr = close_hr;
+    }
+    if (FAILED(hr)) ID2D1PathGeometry_Release( path );
+    else *result = (ID2D1Geometry *)path;
+    return hr;
+}
+
+static HRESULT WINAPI path_QueryInterface( ICompositionPath *iface, REFIID iid, void **out )
+{
+    struct composition_path *impl = impl_from_ICompositionPath( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_ICompositionPath )) *out = iface;
+    else if (IsEqualGUID( iid, &IID_IGeometrySource2D )) *out = &impl->IGeometrySource2D_iface;
+    else if (IsEqualGUID( iid, &iid_geometry_interop )) *out = &impl->interop_iface;
+    else return E_NOINTERFACE;
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI path_AddRef( ICompositionPath *iface )
+{
+    return InterlockedIncrement( &impl_from_ICompositionPath( iface )->ref );
+}
+
+static ULONG WINAPI path_Release( ICompositionPath *iface )
+{
+    struct composition_path *impl = impl_from_ICompositionPath( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        ID2D1Geometry_Release( impl->geometry );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI path_GetIids( ICompositionPath *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = CoTaskMemAlloc( 2 * sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_ICompositionPath;
+    (*iids)[1] = IID_IGeometrySource2D;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT path_class_name( HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_UI_Composition_CompositionPath;
+
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen(class_name), name );
+}
+
+static HRESULT WINAPI path_GetRuntimeClassName( ICompositionPath *iface, HSTRING *name )
+{
+    return path_class_name( name );
+}
+
+static HRESULT WINAPI path_GetTrustLevel( ICompositionPath *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const ICompositionPathVtbl path_vtbl =
+{
+    path_QueryInterface,
+    path_AddRef,
+    path_Release,
+    path_GetIids,
+    path_GetRuntimeClassName,
+    path_GetTrustLevel,
+};
+
+DEFINE_IINSPECTABLE( path_source, IGeometrySource2D, struct composition_path, ICompositionPath_iface )
+
+static const IGeometrySource2DVtbl path_source_vtbl =
+{
+    path_source_QueryInterface,
+    path_source_AddRef,
+    path_source_Release,
+    path_source_GetIids,
+    path_source_GetRuntimeClassName,
+    path_source_GetTrustLevel,
+};
+
+static inline struct composition_path *impl_from_path_interop( struct geometry_interop_iface *iface )
+{
+    return CONTAINING_RECORD( iface, struct composition_path, interop_iface );
+}
+
+static HRESULT WINAPI path_interop_QueryInterface( struct geometry_interop_iface *iface, REFIID iid, void **out )
+{
+    return path_QueryInterface( &impl_from_path_interop(iface)->ICompositionPath_iface, iid, out );
+}
+
+static ULONG WINAPI path_interop_AddRef( struct geometry_interop_iface *iface )
+{
+    return path_AddRef( &impl_from_path_interop(iface)->ICompositionPath_iface );
+}
+
+static ULONG WINAPI path_interop_Release( struct geometry_interop_iface *iface )
+{
+    return path_Release( &impl_from_path_interop(iface)->ICompositionPath_iface );
+}
+
+static HRESULT WINAPI path_interop_GetGeometry( struct geometry_interop_iface *iface, ID2D1Geometry **result )
+{
+    struct composition_path *impl = impl_from_path_interop( iface );
+
+    if (!result) return E_POINTER;
+    *result = impl->geometry;
+    ID2D1Geometry_AddRef( *result );
+    return S_OK;
+}
+
+static HRESULT WINAPI path_interop_TryGetGeometryUsingFactory( struct geometry_interop_iface *iface,
+        ID2D1Factory *factory, ID2D1Geometry **result )
+{
+    struct composition_path *impl = impl_from_path_interop( iface );
+    ID2D1Factory *owner;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!factory) return E_INVALIDARG;
+    ID2D1Geometry_GetFactory( impl->geometry, &owner );
+    if (owner == factory) hr = path_interop_GetGeometry( iface, result );
+    else hr = geometry_clone( impl->geometry, factory, result );
+    ID2D1Factory_Release( owner );
+    return hr;
+}
+
+static const struct geometry_interop_vtbl path_interop_vtbl =
+{
+    path_interop_QueryInterface,
+    path_interop_AddRef,
+    path_interop_Release,
+    path_interop_GetGeometry,
+    path_interop_TryGetGeometryUsingFactory,
+};
+
+struct path_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    ICompositionPathFactory ICompositionPathFactory_iface;
+    LONG ref;
+};
+
+static inline struct path_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct path_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI path_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct path_factory *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionPathFactory ))
+        *out = &impl->ICompositionPathFactory_iface;
+    else return E_NOINTERFACE;
+
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI path_factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI path_factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI path_factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = CoTaskMemAlloc( sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    **iids = IID_ICompositionPathFactory;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI path_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return path_class_name( name );
+}
+
+static HRESULT WINAPI path_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI path_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl path_factory_vtbl =
+{
+    path_factory_QueryInterface,
+    path_factory_AddRef,
+    path_factory_Release,
+    path_factory_GetIids,
+    path_factory_GetRuntimeClassName,
+    path_factory_GetTrustLevel,
+    path_factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( path_constructor, ICompositionPathFactory, struct path_factory,
+                    IActivationFactory_iface )
+
+static HRESULT WINAPI path_constructor_Create( ICompositionPathFactory *iface,
+        IGeometrySource2D *source, ICompositionPath **result )
+{
+    struct geometry_interop_iface *interop;
+    struct composition_path *impl;
+    ID2D1Geometry *geometry = NULL;
+    ID2D1Factory *factory;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!source) return E_INVALIDARG;
+    hr = IGeometrySource2D_QueryInterface( source, &iid_geometry_interop, (void **)&interop );
+    if (FAILED(hr)) return E_INVALIDARG;
+    hr = interop->lpVtbl->GetGeometry( interop, &geometry );
+    interop->lpVtbl->Release( interop );
+    if (FAILED(hr)) return hr;
+    if (!geometry) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        ID2D1Geometry_Release( geometry );
+        return E_OUTOFMEMORY;
+    }
+    hr = D2D1CreateFactory( D2D1_FACTORY_TYPE_MULTI_THREADED, &IID_ID2D1Factory, NULL, (void **)&factory );
+    if (SUCCEEDED(hr))
+    {
+        hr = geometry_clone( geometry, factory, &impl->geometry );
+        ID2D1Factory_Release( factory );
+    }
+    ID2D1Geometry_Release( geometry );
+    if (FAILED(hr))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->ICompositionPath_iface.lpVtbl = &path_vtbl;
+    impl->IGeometrySource2D_iface.lpVtbl = &path_source_vtbl;
+    impl->interop_iface.lpVtbl = &path_interop_vtbl;
+    impl->ref = 1;
+    *result = &impl->ICompositionPath_iface;
+    return S_OK;
+}
+
+static const ICompositionPathFactoryVtbl path_constructor_vtbl =
+{
+    path_constructor_QueryInterface,
+    path_constructor_AddRef,
+    path_constructor_Release,
+    path_constructor_GetIids,
+    path_constructor_GetRuntimeClassName,
+    path_constructor_GetTrustLevel,
+    path_constructor_Create,
+};
+
+static struct path_factory path_factory_impl =
+{
+    {&path_factory_vtbl},
+    {&path_constructor_vtbl},
+    1,
+};
+
+IActivationFactory *composition_path_factory = &path_factory_impl.IActivationFactory_iface;
+
+struct path_geometry
+{
+    ICompositionPathGeometry ICompositionPathGeometry_iface;
+    ICompositionGeometry ICompositionGeometry_iface;
+    ICompositionObject ICompositionObject_iface;
+    LONG ref;
+    ICompositor *compositor;
+    ICompositionPropertySet *properties;
+    ICompositionPath *path;
+    FLOAT trim_end, trim_offset, trim_start;
+};
+
+static inline struct path_geometry *impl_from_ICompositionPathGeometry( ICompositionPathGeometry *iface )
+{
+    return CONTAINING_RECORD( iface, struct path_geometry, ICompositionPathGeometry_iface );
+}
+
+static HRESULT WINAPI path_geometry_QueryInterface( ICompositionPathGeometry *iface, REFIID iid, void **out )
+{
+    struct path_geometry *impl = impl_from_ICompositionPathGeometry( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_ICompositionPathGeometry )) *out = iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionGeometry )) *out = &impl->ICompositionGeometry_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject )) *out = &impl->ICompositionObject_iface;
+    else return E_NOINTERFACE;
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI path_geometry_AddRef( ICompositionPathGeometry *iface )
+{
+    return InterlockedIncrement( &impl_from_ICompositionPathGeometry(iface)->ref );
+}
+
+static ULONG WINAPI path_geometry_Release( ICompositionPathGeometry *iface )
+{
+    struct path_geometry *impl = impl_from_ICompositionPathGeometry( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->path) ICompositionPath_Release( impl->path );
+        ICompositionPropertySet_Release( impl->properties );
+        ICompositor_Release( impl->compositor );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI path_geometry_GetIids( ICompositionPathGeometry *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = CoTaskMemAlloc( 3 * sizeof(**iids) );
+    if (!*iids) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_ICompositionPathGeometry;
+    (*iids)[1] = IID_ICompositionGeometry;
+    (*iids)[2] = IID_ICompositionObject;
+    *count = 3;
+    return S_OK;
+}
+
+static HRESULT WINAPI path_geometry_GetRuntimeClassName( ICompositionPathGeometry *iface, HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_UI_Composition_CompositionPathGeometry;
+
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen(class_name), name );
+}
+
+static HRESULT WINAPI path_geometry_GetTrustLevel( ICompositionPathGeometry *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI path_geometry_get_Path( ICompositionPathGeometry *iface, ICompositionPath **value )
+{
+    struct path_geometry *impl = impl_from_ICompositionPathGeometry( iface );
+
+    if (!value) return E_POINTER;
+    *value = impl->path;
+    if (*value) ICompositionPath_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI path_geometry_put_Path( ICompositionPathGeometry *iface, ICompositionPath *value )
+{
+    struct path_geometry *impl = impl_from_ICompositionPathGeometry( iface );
+
+    if (!value) return E_INVALIDARG;
+    ICompositionPath_AddRef( value );
+    if (impl->path) ICompositionPath_Release( impl->path );
+    impl->path = value;
+    return S_OK;
+}
+
+static const ICompositionPathGeometryVtbl path_geometry_vtbl =
+{
+    path_geometry_QueryInterface,
+    path_geometry_AddRef,
+    path_geometry_Release,
+    path_geometry_GetIids,
+    path_geometry_GetRuntimeClassName,
+    path_geometry_GetTrustLevel,
+    path_geometry_get_Path,
+    path_geometry_put_Path,
+};
+
+DEFINE_IINSPECTABLE( geometry, ICompositionGeometry, struct path_geometry, ICompositionPathGeometry_iface )
+DEFINE_IINSPECTABLE( geometry_object, ICompositionObject, struct path_geometry, ICompositionPathGeometry_iface )
+
+static HRESULT WINAPI geometry_get_TrimEnd( ICompositionGeometry *iface, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICompositionGeometry(iface)->trim_end;
+    return S_OK;
+}
+
+static HRESULT WINAPI geometry_put_TrimEnd( ICompositionGeometry *iface, FLOAT value )
+{
+    impl_from_ICompositionGeometry(iface)->trim_end = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI geometry_get_TrimOffset( ICompositionGeometry *iface, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICompositionGeometry(iface)->trim_offset;
+    return S_OK;
+}
+
+static HRESULT WINAPI geometry_put_TrimOffset( ICompositionGeometry *iface, FLOAT value )
+{
+    impl_from_ICompositionGeometry(iface)->trim_offset = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI geometry_get_TrimStart( ICompositionGeometry *iface, FLOAT *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICompositionGeometry(iface)->trim_start;
+    return S_OK;
+}
+
+static HRESULT WINAPI geometry_put_TrimStart( ICompositionGeometry *iface, FLOAT value )
+{
+    impl_from_ICompositionGeometry(iface)->trim_start = value;
+    return S_OK;
+}
+
+static const ICompositionGeometryVtbl geometry_vtbl =
+{
+    geometry_QueryInterface,
+    geometry_AddRef,
+    geometry_Release,
+    geometry_GetIids,
+    geometry_GetRuntimeClassName,
+    geometry_GetTrustLevel,
+    geometry_get_TrimEnd,
+    geometry_put_TrimEnd,
+    geometry_get_TrimOffset,
+    geometry_put_TrimOffset,
+    geometry_get_TrimStart,
+    geometry_put_TrimStart,
+};
+
+static HRESULT WINAPI geometry_object_get_Compositor( ICompositionObject *iface, ICompositor **value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICompositionObject(iface)->compositor;
+    ICompositor_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI geometry_object_get_Dispatcher( ICompositionObject *iface,
+        ICoreDispatcher **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI geometry_object_get_Properties( ICompositionObject *iface, ICompositionPropertySet **value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICompositionObject(iface)->properties;
+    ICompositionPropertySet_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI geometry_object_StartAnimation( ICompositionObject *iface, HSTRING name,
+        ICompositionAnimation *animation )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI geometry_object_StopAnimation( ICompositionObject *iface, HSTRING name )
+{
+    return E_NOTIMPL;
+}
+
+static const ICompositionObjectVtbl geometry_object_vtbl =
+{
+    geometry_object_QueryInterface,
+    geometry_object_AddRef,
+    geometry_object_Release,
+    geometry_object_GetIids,
+    geometry_object_GetRuntimeClassName,
+    geometry_object_GetTrustLevel,
+    geometry_object_get_Compositor,
+    geometry_object_get_Dispatcher,
+    geometry_object_get_Properties,
+    geometry_object_StartAnimation,
+    geometry_object_StopAnimation,
+};
+
+HRESULT composition_path_geometry_create( ICompositor *compositor, ICompositionPath *path,
+        ICompositionPathGeometry **result )
+{
+    struct path_geometry *impl;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = composition_property_set_create( compositor, &impl->properties )))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->ICompositionPathGeometry_iface.lpVtbl = &path_geometry_vtbl;
+    impl->ICompositionGeometry_iface.lpVtbl = &geometry_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &geometry_object_vtbl;
+    impl->ref = 1;
+    impl->trim_end = 1.0f;
+    impl->compositor = compositor;
+    ICompositor_AddRef( compositor );
+    impl->path = path;
+    if (path) ICompositionPath_AddRef( path );
+    *result = &impl->ICompositionPathGeometry_iface;
+    return S_OK;
+}
+
+HRESULT composition_path_geometry_get_geometry( ICompositionGeometry *geometry,
+        ID2D1Factory *factory, ID2D1Geometry **result )
+{
+    ICompositionPathGeometry *path_geometry;
+    struct geometry_interop_iface *interop;
+    ICompositionPath *path = NULL;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    hr = ICompositionGeometry_QueryInterface( geometry, &IID_ICompositionPathGeometry, (void **)&path_geometry );
+    if (FAILED(hr)) return hr;
+    hr = ICompositionPathGeometry_get_Path( path_geometry, &path );
+    ICompositionPathGeometry_Release( path_geometry );
+    if (FAILED(hr) || !path) return hr;
+    hr = ICompositionPath_QueryInterface( path, &iid_geometry_interop, (void **)&interop );
+    ICompositionPath_Release( path );
+    if (FAILED(hr)) return hr;
+    hr = interop->lpVtbl->TryGetGeometryUsingFactory( interop, factory, result );
+    interop->lpVtbl->Release( interop );
+    return hr;
+}
diff --git a/dlls/windows.ui/composition_shape_collection.c b/dlls/windows.ui/composition_shape_collection.c
new file mode 100644
--- /dev/null
+++ b/dlls/windows.ui/composition_shape_collection.c
@@ -0,0 +1,585 @@
+/* WinRT Windows.UI.Composition shape collection
+ *
+ * Copyright (C) 2026 Mirko Brombin
