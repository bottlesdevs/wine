+HRESULT composition_sprite_shape_create( ICompositor *compositor, ICompositionGeometry *geometry,
+        ICompositionSpriteShape **result )
+{
+    struct sprite_shape *impl;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = composition_property_set_create( compositor, &impl->properties )))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->ICompositionSpriteShape_iface.lpVtbl = &sprite_shape_vtbl;
+    impl->ICompositionShape_iface.lpVtbl = &shape_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &shape_object_vtbl;
+    impl->ref = 1;
+    impl->scale.X = impl->scale.Y = 1.0f;
+    impl->transform.M11 = impl->transform.M22 = 1.0f;
+    impl->thickness = 1.0f;
+    impl->miter_limit = 1.0f;
+    impl->compositor = compositor;
+    ICompositor_AddRef( compositor );
+    impl->geometry = geometry;
+    if (geometry) ICompositionGeometry_AddRef( geometry );
+    *result = &impl->ICompositionSpriteShape_iface;
+    return S_OK;
+}
