+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdint.h>
+#include "private.h"
+
+struct shape_collection
+{
+    IVector_CompositionShape IVector_CompositionShape_iface;
+    IVectorView_CompositionShape IVectorView_CompositionShape_iface;
+    IIterable_CompositionShape IIterable_CompositionShape_iface;
+    LONG ref;
+    UINT32 count, capacity, version;
+    ICompositionShape **items;
+    CRITICAL_SECTION lock;
+};
+
+static inline struct shape_collection *impl_from_IVector_CompositionShape( IVector_CompositionShape *iface )
+{
+    return CONTAINING_RECORD( iface, struct shape_collection, IVector_CompositionShape_iface );
+}
+
+static HRESULT WINAPI shape_collection_QueryInterface( IVector_CompositionShape *iface, REFIID iid, void **out )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IVector_CompositionShape )) *out = iface;
+    else if (IsEqualGUID( iid, &IID_IVectorView_CompositionShape )) *out = &impl->IVectorView_CompositionShape_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_CompositionShape )) *out = &impl->IIterable_CompositionShape_iface;
+    else return E_NOINTERFACE;
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI shape_collection_AddRef( IVector_CompositionShape *iface )
+{
+    return InterlockedIncrement( &impl_from_IVector_CompositionShape(iface)->ref );
+}
+
+static ULONG WINAPI shape_collection_Release( IVector_CompositionShape *iface )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; ++i) ICompositionShape_Release( impl->items[i] );
+        free( impl->items );
+        DeleteCriticalSection( &impl->lock );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI shape_collection_GetIids( IVector_CompositionShape *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc( 3 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IVector_CompositionShape;
+    (*iids)[1] = IID_IVectorView_CompositionShape;
+    (*iids)[2] = IID_IIterable_CompositionShape;
+    *count = 3;
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_collection_GetRuntimeClassName( IVector_CompositionShape *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    *name = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_collection_GetTrustLevel( IVector_CompositionShape *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_collection_GetAt( IVector_CompositionShape *iface, UINT32 index, ICompositionShape **value )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    HRESULT hr = E_BOUNDS;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection( &impl->lock );
+    if (index < impl->count)
+    {
+        *value = impl->items[index];
+        ICompositionShape_AddRef( *value );
+        hr = S_OK;
+    }
+    LeaveCriticalSection( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_collection_get_Size( IVector_CompositionShape *iface, UINT32 *value )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &impl->lock );
+    *value = impl->count;
+    LeaveCriticalSection( &impl->lock );
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_collection_GetView( IVector_CompositionShape *iface, IVectorView_CompositionShape **value )
+{
+    return shape_collection_QueryInterface( iface, &IID_IVectorView_CompositionShape, (void **)value );
+}
+
+static HRESULT WINAPI shape_collection_IndexOf( IVector_CompositionShape *iface, ICompositionShape *value,
+        UINT32 *index, boolean *found )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    UINT32 i;
+
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    EnterCriticalSection( &impl->lock );
+    for (i = 0; i < impl->count; ++i)
+        if (impl->items[i] == value)
+        {
+            *index = i;
+            *found = TRUE;
+            break;
+        }
+    LeaveCriticalSection( &impl->lock );
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_collection_SetAt( IVector_CompositionShape *iface, UINT32 index, ICompositionShape *value )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    ICompositionShape *old = NULL;
+    HRESULT hr = E_BOUNDS;
+
+    if (!value) return E_INVALIDARG;
+    EnterCriticalSection( &impl->lock );
+    if (index < impl->count)
+    {
+        ICompositionShape_AddRef( value );
+        old = impl->items[index];
+        impl->items[index] = value;
+        ++impl->version;
+        hr = S_OK;
+    }
+    LeaveCriticalSection( &impl->lock );
+    if (old) ICompositionShape_Release( old );
+    return hr;
+}
+
+static HRESULT WINAPI shape_collection_InsertAt( IVector_CompositionShape *iface, UINT32 index, ICompositionShape *value )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    ICompositionShape **items;
+    UINT32 capacity;
+    HRESULT hr = S_OK;
+
+    if (!value) return E_INVALIDARG;
+    EnterCriticalSection( &impl->lock );
+    if (index > impl->count) hr = E_BOUNDS;
+    else if (impl->count == UINT32_MAX) hr = E_OUTOFMEMORY;
+    else
+    {
+        if (impl->count == impl->capacity)
+        {
+            capacity = impl->capacity <= UINT32_MAX / 2 ? max( 8, impl->capacity * 2 ) : UINT32_MAX;
+            if ((SIZE_T)capacity > ~(SIZE_T)0 / sizeof(*items) ||
+                !(items = realloc( impl->items, (SIZE_T)capacity * sizeof(*items) ))) hr = E_OUTOFMEMORY;
+            else
+            {
+                impl->items = items;
+                impl->capacity = capacity;
+            }
+        }
+        if (SUCCEEDED(hr))
+        {
+            memmove( impl->items + index + 1, impl->items + index, (impl->count - index) * sizeof(*impl->items) );
+            ICompositionShape_AddRef( value );
+            impl->items[index] = value;
+            ++impl->count;
+            ++impl->version;
+        }
+    }
+    LeaveCriticalSection( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_collection_RemoveAt( IVector_CompositionShape *iface, UINT32 index )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    ICompositionShape *old = NULL;
+    HRESULT hr = E_BOUNDS;
+
+    EnterCriticalSection( &impl->lock );
+    if (index < impl->count)
+    {
+        old = impl->items[index];
+        --impl->count;
+        memmove( impl->items + index, impl->items + index + 1, (impl->count - index) * sizeof(*impl->items) );
+        ++impl->version;
+        hr = S_OK;
+    }
+    LeaveCriticalSection( &impl->lock );
+    if (old) ICompositionShape_Release( old );
+    return hr;
+}
+
+static HRESULT WINAPI shape_collection_Append( IVector_CompositionShape *iface, ICompositionShape *value )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    HRESULT hr;
+
+    EnterCriticalSection( &impl->lock );
+    hr = shape_collection_InsertAt( iface, impl->count, value );
+    LeaveCriticalSection( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_collection_RemoveAtEnd( IVector_CompositionShape *iface )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    HRESULT hr;
+
+    EnterCriticalSection( &impl->lock );
+    hr = impl->count ? shape_collection_RemoveAt( iface, impl->count - 1 ) : E_BOUNDS;
+    LeaveCriticalSection( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_collection_Clear( IVector_CompositionShape *iface )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    ICompositionShape **items;
+    UINT32 count, i;
+
+    EnterCriticalSection( &impl->lock );
+    items = impl->items;
+    count = impl->count;
+    impl->items = NULL;
+    impl->count = impl->capacity = 0;
+    ++impl->version;
+    LeaveCriticalSection( &impl->lock );
+    for (i = 0; i < count; ++i) ICompositionShape_Release( items[i] );
+    free( items );
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_collection_GetMany( IVector_CompositionShape *iface, UINT32 start, UINT32 capacity,
+        ICompositionShape **items, UINT32 *count )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    UINT32 i;
+    HRESULT hr = S_OK;
+
+    if (!count || (capacity && !items)) return E_POINTER;
+    *count = 0;
+    EnterCriticalSection( &impl->lock );
+    if (start > impl->count) hr = E_BOUNDS;
+    else
+    {
+        *count = min( capacity, impl->count - start );
+        for (i = 0; i < *count; ++i)
+        {
+            items[i] = impl->items[start + i];
+            ICompositionShape_AddRef( items[i] );
+        }
+    }
+    LeaveCriticalSection( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_collection_ReplaceAll( IVector_CompositionShape *iface, UINT32 count, ICompositionShape **values )
+{
+    struct shape_collection *impl = impl_from_IVector_CompositionShape( iface );
+    ICompositionShape **items = NULL, **old;
+    UINT32 i, old_count;
+
+    if (count && !values) return E_POINTER;
+    if ((SIZE_T)count > ~(SIZE_T)0 / sizeof(*items)) return E_OUTOFMEMORY;
+    if (count && !(items = malloc( (SIZE_T)count * sizeof(*items) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; ++i)
+    {
+        if (!values[i])
+        {
+            while (i) ICompositionShape_Release( items[--i] );
+            free( items );
+            return E_INVALIDARG;
+        }
+        items[i] = values[i];
+        ICompositionShape_AddRef( items[i] );
+    }
+    EnterCriticalSection( &impl->lock );
+    old = impl->items;
+    old_count = impl->count;
+    impl->items = items;
+    impl->count = impl->capacity = count;
+    ++impl->version;
+    LeaveCriticalSection( &impl->lock );
+    for (i = 0; i < old_count; ++i) ICompositionShape_Release( old[i] );
+    free( old );
+    return S_OK;
+}
+
+DEFINE_IINSPECTABLE( shape_view, IVectorView_CompositionShape, struct shape_collection, IVector_CompositionShape_iface )
+
+static HRESULT WINAPI shape_view_GetAt( IVectorView_CompositionShape *iface, UINT32 index, ICompositionShape **value )
+{
+    return shape_collection_GetAt( &impl_from_IVectorView_CompositionShape(iface)->IVector_CompositionShape_iface, index, value );
+}
+
+static HRESULT WINAPI shape_view_get_Size( IVectorView_CompositionShape *iface, UINT32 *value )
+{
+    return shape_collection_get_Size( &impl_from_IVectorView_CompositionShape(iface)->IVector_CompositionShape_iface, value );
+}
+
+static HRESULT WINAPI shape_view_IndexOf( IVectorView_CompositionShape *iface, ICompositionShape *value, UINT32 *index, boolean *found )
+{
+    return shape_collection_IndexOf( &impl_from_IVectorView_CompositionShape(iface)->IVector_CompositionShape_iface, value, index, found );
+}
+
+static HRESULT WINAPI shape_view_GetMany( IVectorView_CompositionShape *iface, UINT32 start, UINT32 capacity, ICompositionShape **items, UINT32 *count )
+{
+    return shape_collection_GetMany( &impl_from_IVectorView_CompositionShape(iface)->IVector_CompositionShape_iface, start, capacity, items, count );
+}
+
+static const IVectorView_CompositionShapeVtbl shape_view_vtbl =
+{
+    shape_view_QueryInterface,
+    shape_view_AddRef,
+    shape_view_Release,
+    shape_view_GetIids,
+    shape_view_GetRuntimeClassName,
+    shape_view_GetTrustLevel,
+    shape_view_GetAt,
+    shape_view_get_Size,
+    shape_view_IndexOf,
+    shape_view_GetMany,
+};
+
+struct shape_iterator
+{
+    IIterator_CompositionShape IIterator_CompositionShape_iface;
+    struct shape_collection *collection;
+    UINT32 index, version;
+    LONG ref;
+};
+
+static inline struct shape_iterator *impl_from_IIterator_CompositionShape( IIterator_CompositionShape *iface )
+{
+    return CONTAINING_RECORD( iface, struct shape_iterator, IIterator_CompositionShape_iface );
+}
+
+static HRESULT WINAPI shape_iterator_QueryInterface( IIterator_CompositionShape *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_CompositionShape ))
+    {
+        *out = iface;
+        IIterator_CompositionShape_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI shape_iterator_AddRef( IIterator_CompositionShape *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator_CompositionShape( iface )->ref );
+}
+
+static ULONG WINAPI shape_iterator_Release( IIterator_CompositionShape *iface )
+{
+    struct shape_iterator *impl = impl_from_IIterator_CompositionShape( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IVector_CompositionShape_Release( &impl->collection->IVector_CompositionShape_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI shape_iterator_GetIids( IIterator_CompositionShape *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;
+    **iids = IID_IIterator_CompositionShape;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_iterator_GetRuntimeClassName( IIterator_CompositionShape *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_UI_Composition_CompositionShape,
+                                ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_CompositionShape) - 1, name );
+}
+
+static HRESULT WINAPI shape_iterator_GetTrustLevel( IIterator_CompositionShape *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI shape_iterator_get_Current( IIterator_CompositionShape *iface, ICompositionShape **value )
+{
+    struct shape_iterator *impl = impl_from_IIterator_CompositionShape( iface );
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection( &impl->collection->lock );
+    if (impl->version != impl->collection->version) hr = E_CHANGED_STATE;
+    else hr = shape_collection_GetAt( &impl->collection->IVector_CompositionShape_iface, impl->index, value );
+    LeaveCriticalSection( &impl->collection->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_iterator_get_HasCurrent( IIterator_CompositionShape *iface, boolean *value )
+{
+    struct shape_iterator *impl = impl_from_IIterator_CompositionShape( iface );
+    HRESULT hr = S_OK;
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    EnterCriticalSection( &impl->collection->lock );
+    if (impl->version != impl->collection->version) hr = E_CHANGED_STATE;
+    else *value = impl->index < impl->collection->count;
+    LeaveCriticalSection( &impl->collection->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_iterator_MoveNext( IIterator_CompositionShape *iface, boolean *value )
+{
+    struct shape_iterator *impl = impl_from_IIterator_CompositionShape( iface );
+    HRESULT hr = S_OK;
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    EnterCriticalSection( &impl->collection->lock );
+    if (impl->version != impl->collection->version) hr = E_CHANGED_STATE;
+    else
+    {
+        if (impl->index < impl->collection->count) ++impl->index;
+        *value = impl->index < impl->collection->count;
+    }
+    LeaveCriticalSection( &impl->collection->lock );
+    return hr;
+}
+
+static HRESULT WINAPI shape_iterator_GetMany( IIterator_CompositionShape *iface, UINT32 capacity,
+        ICompositionShape **items, UINT32 *count )
+{
+    struct shape_iterator *impl = impl_from_IIterator_CompositionShape( iface );
+    HRESULT hr;
+
+    if (!count || (capacity && !items)) return E_POINTER;
+    *count = 0;
+    EnterCriticalSection( &impl->collection->lock );
+    if (impl->version != impl->collection->version) hr = E_CHANGED_STATE;
+    else
+    {
+        hr = shape_collection_GetMany( &impl->collection->IVector_CompositionShape_iface,
+                impl->index, capacity, items, count );
+        if (SUCCEEDED(hr)) impl->index += *count;
+    }
+    LeaveCriticalSection( &impl->collection->lock );
+    return hr;
+}
+
+static const IIterator_CompositionShapeVtbl shape_iterator_vtbl =
+{
+    shape_iterator_QueryInterface,
+    shape_iterator_AddRef,
+    shape_iterator_Release,
+    shape_iterator_GetIids,
+    shape_iterator_GetRuntimeClassName,
+    shape_iterator_GetTrustLevel,
+    shape_iterator_get_Current,
+    shape_iterator_get_HasCurrent,
+    shape_iterator_MoveNext,
+    shape_iterator_GetMany,
+};
+
+DEFINE_IINSPECTABLE_( shape_collection_iterable, IIterable_CompositionShape, struct shape_collection,
+                      impl_from_IIterable_CompositionShape, IIterable_CompositionShape_iface,
+                      &impl->IVector_CompositionShape_iface )
+
+static HRESULT WINAPI shape_collection_iterable_First( IIterable_CompositionShape *iface,
+        IIterator_CompositionShape **value )
+{
+    struct shape_collection *collection = impl_from_IIterable_CompositionShape( iface );
+    struct shape_iterator *iterator;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(iterator = calloc( 1, sizeof(*iterator) ))) return E_OUTOFMEMORY;
+    iterator->IIterator_CompositionShape_iface.lpVtbl = &shape_iterator_vtbl;
+    iterator->collection = collection;
+    EnterCriticalSection( &collection->lock );
+    iterator->version = collection->version;
+    LeaveCriticalSection( &collection->lock );
+    iterator->ref = 1;
+    IVector_CompositionShape_AddRef( &collection->IVector_CompositionShape_iface );
+    *value = &iterator->IIterator_CompositionShape_iface;
+    return S_OK;
+}
+
+static const IIterable_CompositionShapeVtbl shape_collection_iterable_vtbl =
+{
+    shape_collection_iterable_QueryInterface,
+    shape_collection_iterable_AddRef,
+    shape_collection_iterable_Release,
+    shape_collection_iterable_GetIids,
+    shape_collection_iterable_GetRuntimeClassName,
+    shape_collection_iterable_GetTrustLevel,
+    shape_collection_iterable_First,
+};
+
+static const IVector_CompositionShapeVtbl shape_collection_vtbl =
+{
+    shape_collection_QueryInterface,
+    shape_collection_AddRef,
+    shape_collection_Release,
+    shape_collection_GetIids,
+    shape_collection_GetRuntimeClassName,
+    shape_collection_GetTrustLevel,
+    shape_collection_GetAt,
+    shape_collection_get_Size,
+    shape_collection_GetView,
+    shape_collection_IndexOf,
+    shape_collection_SetAt,
+    shape_collection_InsertAt,
+    shape_collection_RemoveAt,
+    shape_collection_Append,
+    shape_collection_RemoveAtEnd,
+    shape_collection_Clear,
+    shape_collection_GetMany,
+    shape_collection_ReplaceAll,
+};
+
+HRESULT composition_shape_collection_create( IVector_CompositionShape **result )
+{
+    struct shape_collection *impl;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVector_CompositionShape_iface.lpVtbl = &shape_collection_vtbl;
+    impl->IVectorView_CompositionShape_iface.lpVtbl = &shape_view_vtbl;
+    impl->IIterable_CompositionShape_iface.lpVtbl = &shape_collection_iterable_vtbl;
+    impl->ref = 1;
+    InitializeCriticalSection( &impl->lock );
+    *result = &impl->IVector_CompositionShape_iface;
+    return S_OK;
+}
diff --git a/dlls/windows.ui/composition_shapes.c b/dlls/windows.ui/composition_shapes.c
new file mode 100644
--- /dev/null
+++ b/dlls/windows.ui/composition_shapes.c
@@ -0,0 +1,568 @@
