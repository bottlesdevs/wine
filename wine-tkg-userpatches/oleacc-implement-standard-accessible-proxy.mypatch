diff --git a/dlls/oleacc/oleacc.spec b/dlls/oleacc/oleacc.spec
--- a/dlls/oleacc/oleacc.spec
+++ b/dlls/oleacc/oleacc.spec
@@ -6,2 +6,2 @@
-@ stub CreateStdAccessibleProxyA
-@ stub CreateStdAccessibleProxyW
+@ stdcall CreateStdAccessibleProxyA(ptr str long ptr ptr)
+@ stdcall CreateStdAccessibleProxyW(ptr wstr long ptr ptr)
diff --git a/dlls/oleacc/main.c b/dlls/oleacc/main.c
--- a/dlls/oleacc/main.c
+++ b/dlls/oleacc/main.c
@@ -103,0 +104,44 @@
+HRESULT WINAPI CreateStdAccessibleProxyW( HWND hwnd, LPCWSTR class_name, LONG object_id,
+        REFIID iid, void **object )
+{
+    TRACE("%p %s %ld %s %p\n", hwnd, debugstr_w(class_name), object_id,
+          debugstr_guid(iid), object);
+
+    if (!class_name)
+        return E_INVALIDARG;
+
+    switch (object_id)
+    {
+    case OBJID_CLIENT:
+        return create_client_object_for_class(hwnd, class_name, iid, object);
+    case OBJID_WINDOW:
+        return create_window_object(hwnd, iid, object);
+    default:
+        FIXME("unhandled object id: %ld\n", object_id);
+        return E_NOTIMPL;
+    }
+}
+
+HRESULT WINAPI CreateStdAccessibleProxyA( HWND hwnd, LPCSTR class_name, LONG object_id,
+        REFIID iid, void **object )
+{
+    WCHAR *class_nameW;
+    HRESULT hr;
+    int len;
+
+    TRACE("%p %s %ld %s %p\n", hwnd, debugstr_a(class_name), object_id,
+          debugstr_guid(iid), object);
+
+    if (!class_name)
+        return E_INVALIDARG;
+
+    len = MultiByteToWideChar(CP_ACP, 0, class_name, -1, NULL, 0);
+    if (!(class_nameW = malloc(len * sizeof(*class_nameW))))
+        return E_OUTOFMEMORY;
+    MultiByteToWideChar(CP_ACP, 0, class_name, -1, class_nameW, len);
+
+    hr = CreateStdAccessibleProxyW(hwnd, class_nameW, object_id, iid, object);
+    free(class_nameW);
+    return hr;
+}
+
diff --git a/dlls/oleacc/client.c b/dlls/oleacc/client.c
--- a/dlls/oleacc/client.c
+++ b/dlls/oleacc/client.c
@@ -903 +903,2 @@
-HRESULT create_client_object(HWND hwnd, const IID *iid, void **obj)
+static HRESULT create_client_object_with_data(HWND hwnd, const struct win_class_data *data,
+        const IID *iid, void **obj)
@@ -905 +905,0 @@
-    const struct win_class_data *data;
@@ -916,2 +915,0 @@
-    data = find_class_data(hwnd, classes);
-
@@ -934,0 +933,22 @@
+}
+
+HRESULT create_client_object(HWND hwnd, const IID *iid, void **obj)
+{
+    return create_client_object_with_data(hwnd, find_class_data(hwnd, classes), iid, obj);
+}
+
+HRESULT create_client_object_for_class(HWND hwnd, const WCHAR *class_name, const IID *iid, void **obj)
+{
+    const struct win_class_data *data = NULL;
+    int i;
+
+    for (i = 0; classes[i].name; i++)
+    {
+        if (!wcsicmp(class_name, classes[i].name))
+        {
+            data = &classes[i];
+            break;
+        }
+    }
+
+    return create_client_object_with_data(hwnd, data, iid, obj);
diff --git a/dlls/oleacc/oleacc_private.h b/dlls/oleacc/oleacc_private.h
--- a/dlls/oleacc/oleacc_private.h
+++ b/dlls/oleacc/oleacc_private.h
@@ -30,0 +31 @@
+HRESULT create_client_object_for_class(HWND, const WCHAR*, const IID*, void**);
diff --git a/dlls/oleacc/tests/main.c b/dlls/oleacc/tests/main.c
--- a/dlls/oleacc/tests/main.c
+++ b/dlls/oleacc/tests/main.c
@@ -1650,0 +1651,30 @@
+static void test_CreateStdAccessibleProxy(void)
+{
+    VARIANT child, role;
+    IAccessible *acc;
+    HRESULT hr;
+    HWND hwnd;
+
+    hwnd = CreateWindowA("oleacc_test", "test", WS_OVERLAPPEDWINDOW,
+            0, 0, 0, 0, NULL, NULL, NULL, NULL);
+    ok(hwnd != NULL, "CreateWindow failed\n");
+
+    hr = CreateStdAccessibleProxyW(hwnd, L"Edit", OBJID_CLIENT, &IID_IAccessible, (void **)&acc);
+    ok(hr == S_OK, "CreateStdAccessibleProxyW failed %lx\n", hr);
+    V_VT(&child) = VT_I4;
+    V_I4(&child) = CHILDID_SELF;
+    VariantInit(&role);
+    hr = IAccessible_get_accRole(acc, child, &role);
+    ok(hr == S_OK, "get_accRole failed %lx\n", hr);
+    ok(V_VT(&role) == VT_I4, "unexpected role type %u\n", V_VT(&role));
+    ok(V_I4(&role) == ROLE_SYSTEM_TEXT, "unexpected role %#lx\n", V_I4(&role));
+    VariantClear(&role);
+    IAccessible_Release(acc);
+
+    hr = CreateStdAccessibleProxyA(hwnd, "Edit", OBJID_CLIENT, &IID_IAccessible, (void **)&acc);
+    ok(hr == S_OK, "CreateStdAccessibleProxyA failed %lx\n", hr);
+    IAccessible_Release(acc);
+
+    DestroyWindow(hwnd);
+}
+
@@ -2061,0 +2092 @@
+    test_CreateStdAccessibleProxy();
