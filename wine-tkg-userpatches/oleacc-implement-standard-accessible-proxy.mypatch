diff --git a/dlls/oleacc/client.c b/dlls/oleacc/client.c
index d16285a139c..9efc9dc7d7e 100644
--- a/dlls/oleacc/client.c
+++ b/dlls/oleacc/client.c
@@ -902,5 +902,5 @@ static const struct win_class_data classes[] = {

-HRESULT create_client_object(HWND hwnd, const IID *iid, void **obj)
+static HRESULT create_client_object_with_data(HWND hwnd, const struct win_class_data *data,
+        const IID *iid, void **obj)
 {
-    const struct win_class_data *data;
     Client *client;
@@ -915,4 +915,2 @@ HRESULT create_client_object(HWND hwnd, const IID *iid, void **obj)

-    data = find_class_data(hwnd, classes);
-
     client->IAccessible_iface.lpVtbl = &ClientVtbl;
@@ -935 +933,23 @@ HRESULT create_client_object(HWND hwnd, const IID *iid, void **obj)
 }
+
+HRESULT create_client_object(HWND hwnd, const IID *iid, void **obj)
+{
+    return create_client_object_with_data(hwnd, find_class_data(hwnd, classes), iid, obj);
+}
+
+HRESULT create_client_object_for_class(HWND hwnd, const WCHAR *class_name, const IID *iid, void **obj)
+{
+    const struct win_class_data *data = NULL;
+    int i;
+
+    for (i = 0; classes[i].name; i++)
+    {
+        if (!wcsicmp(class_name, classes[i].name))
+        {
+            data = &classes[i];
+            break;
+        }
+    }
+
+    return create_client_object_with_data(hwnd, data, iid, obj);
+}
diff --git a/dlls/oleacc/main.c b/dlls/oleacc/main.c
index b2096d5d557..0e38ef4bd90 100644
--- a/dlls/oleacc/main.c
+++ b/dlls/oleacc/main.c
@@ -103,2 +103,46 @@ HRESULT WINAPI CreateStdAccessibleObject( HWND hwnd, LONG idObject,

+HRESULT WINAPI CreateStdAccessibleProxyW( HWND hwnd, LPCWSTR class_name, LONG object_id,
+        REFIID iid, void **object )
+{
+    TRACE("%p %s %ld %s %p\n", hwnd, debugstr_w(class_name), object_id,
+          debugstr_guid(iid), object);
+
+    if (!class_name)
+        return E_INVALIDARG;
+
+    switch (object_id)
+    {
+    case OBJID_CLIENT:
+        return create_client_object_for_class(hwnd, class_name, iid, object);
+    case OBJID_WINDOW:
+        return create_window_object(hwnd, iid, object);
+    default:
+        FIXME("unhandled object id: %ld\n", object_id);
+        return E_NOTIMPL;
+    }
+}
+
+HRESULT WINAPI CreateStdAccessibleProxyA( HWND hwnd, LPCSTR class_name, LONG object_id,
+        REFIID iid, void **object )
+{
+    WCHAR *class_nameW;
+    HRESULT hr;
+    int len;
+
+    TRACE("%p %s %ld %s %p\n", hwnd, debugstr_a(class_name), object_id,
+          debugstr_guid(iid), object);
+
+    if (!class_name)
+        return E_INVALIDARG;
+
+    len = MultiByteToWideChar(CP_ACP, 0, class_name, -1, NULL, 0);
+    if (!(class_nameW = malloc(len * sizeof(*class_nameW))))
+        return E_OUTOFMEMORY;
+    MultiByteToWideChar(CP_ACP, 0, class_name, -1, class_nameW, len);
+
+    hr = CreateStdAccessibleProxyW(hwnd, class_nameW, object_id, iid, object);
+    free(class_nameW);
+    return hr;
+}
+
 HRESULT WINAPI ObjectFromLresult( LRESULT result, REFIID riid, WPARAM wParam, void **ppObject )
