 };
 
+struct string_pair
+{
+    IKeyValuePair_HSTRING_HSTRING IKeyValuePair_iface;
+    LONG ref;
+    HSTRING key;
+    HSTRING value;
+};
+
+static inline struct string_pair *impl_from_IKeyValuePair( IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_pair, IKeyValuePair_iface );
+}
+
+static HRESULT WINAPI pair_QueryInterface( IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IInspectable ) &&
+        !IsEqualGUID( iid, &IID_IAgileObject ) && !IsEqualGUID( iid, &IID_IKeyValuePair_HSTRING_HSTRING ))
+        return E_NOINTERFACE;
+    *out = iface;
+    IKeyValuePair_HSTRING_HSTRING_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI pair_AddRef( IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    return InterlockedIncrement( &impl_from_IKeyValuePair( iface )->ref );
+}
+
+static ULONG WINAPI pair_Release( IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    struct string_pair *impl = impl_from_IKeyValuePair( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->key );
+        WindowsDeleteString( impl->value );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI pair_GetIids( IKeyValuePair_HSTRING_HSTRING *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 1;
+    if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;
+    **iids = IID_IKeyValuePair_HSTRING_HSTRING;
+    return S_OK;
+}
+
+static HRESULT WINAPI pair_GetRuntimeClassName( IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *name )
+{
+    return map_get_class_name( name );
+}
+
+static HRESULT WINAPI pair_GetTrustLevel( IKeyValuePair_HSTRING_HSTRING *iface, TrustLevel *level )
+{
+    return map_get_trust_level( level );
+}
+
+static HRESULT WINAPI pair_get_Key( IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( impl_from_IKeyValuePair( iface )->key, value );
+}
+
+static HRESULT WINAPI pair_get_Value( IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( impl_from_IKeyValuePair( iface )->value, value );
+}
+
+static const IKeyValuePair_HSTRING_HSTRINGVtbl pair_vtbl =
+{
+    pair_QueryInterface,
+    pair_AddRef,
+    pair_Release,
+    pair_GetIids,
+    pair_GetRuntimeClassName,
+    pair_GetTrustLevel,
+    pair_get_Key,
+    pair_get_Value,
+};
+
+static HRESULT pair_create( HSTRING key, HSTRING value, IKeyValuePair_HSTRING_HSTRING **out )
+{
+    struct string_pair *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IKeyValuePair_iface.lpVtbl = &pair_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = WindowsDuplicateString( key, &impl->key )) ||
+        FAILED(hr = WindowsDuplicateString( value, &impl->value )))
+    {
+        pair_Release( &impl->IKeyValuePair_iface );
+        return hr;
+    }
+    *out = &impl->IKeyValuePair_iface;
+    return S_OK;
+}
+
+struct string_map_iterator
+{
+    IIterator_IKeyValuePair_HSTRING_HSTRING IIterator_iface;
+    LONG ref;
+    struct string_map *map;
+    UINT32 index;
+};
+
+static inline struct string_map_iterator *impl_from_IIterator( IIterator_IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_map_iterator, IIterator_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid,
+                                               void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IInspectable ) &&
+        !IsEqualGUID( iid, &IID_IAgileObject ) && !IsEqualGUID( iid, &IID_IIterator_IKeyValuePair_HSTRING_HSTRING ))
+        return E_NOINTERFACE;
+    *out = iface;
+    IIterator_IKeyValuePair_HSTRING_HSTRING_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    struct string_map_iterator *impl = impl_from_IIterator( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        map_release( impl->map );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 1;
+    if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;
+    **iids = IID_IIterator_IKeyValuePair_HSTRING_HSTRING;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *name )
+{
+    return map_get_class_name( name );
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, TrustLevel *level )
+{
+    return map_get_trust_level( level );
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_IKeyValuePair_HSTRING_HSTRING *iface,
+                                            IKeyValuePair_HSTRING_HSTRING **value )
+{
+    struct string_map_iterator *iterator = impl_from_IIterator( iface );
+    struct string_map *map = iterator->map;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection( &map->cs );
+    if (iterator->index < map->count)
+        hr = pair_create( map->entries[iterator->index].key, map->entries[iterator->index].value, value );
+    else
+        hr = E_BOUNDS;
+    LeaveCriticalSection( &map->cs );
+    return hr;
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, boolean *value )
+{
+    struct string_map_iterator *iterator = impl_from_IIterator( iface );
+    struct string_map *map = iterator->map;
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &map->cs );
+    *value = iterator->index < map->count;
+    LeaveCriticalSection( &map->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, boolean *value )
+{
+    struct string_map_iterator *iterator = impl_from_IIterator( iface );
+    struct string_map *map = iterator->map;
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &map->cs );
+    if (iterator->index < map->count) ++iterator->index;
+    *value = iterator->index < map->count;
+    LeaveCriticalSection( &map->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_IKeyValuePair_HSTRING_HSTRING *iface, UINT32 capacity,
+                                        IKeyValuePair_HSTRING_HSTRING **items, UINT32 *count )
+{
+    HRESULT hr = S_OK;
+
+    if (!count || (capacity && !items)) return E_POINTER;
+    *count = 0;
+    while (*count < capacity)
+    {
+        boolean has_current;
+        if (FAILED(hr = iterator_get_HasCurrent( iface, &has_current )) || !has_current) break;
+        if (FAILED(hr = iterator_get_Current( iface, &items[*count] ))) break;
+        ++*count;
+        if (FAILED(hr = iterator_MoveNext( iface, &has_current ))) break;
+    }
+    return hr;
+}
+
+static const IIterator_IKeyValuePair_HSTRING_HSTRINGVtbl iterator_vtbl =
+{
+    iterator_QueryInterface,
+    iterator_AddRef,
+    iterator_Release,
+    iterator_GetIids,
+    iterator_GetRuntimeClassName,
+    iterator_GetTrustLevel,
+    iterator_get_Current,
+    iterator_get_HasCurrent,
+    iterator_MoveNext,
+    iterator_GetMany,
+};
+
+static HRESULT WINAPI iterable_QueryInterface( IIterable_IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid,
+                                               void **out )
+{
+    return map_query_interface( impl_from_IIterable( iface ), iid, out );
+}
+
+static ULONG WINAPI iterable_AddRef( IIterable_IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterable( iface )->ref );
+}
+
+static ULONG WINAPI iterable_Release( IIterable_IKeyValuePair_HSTRING_HSTRING *iface )
+{
+    return map_release( impl_from_IIterable( iface ) );
+}
+
+static HRESULT WINAPI iterable_GetIids( IIterable_IKeyValuePair_HSTRING_HSTRING *iface, ULONG *count, IID **iids )
+{
+    return map_get_iids( count, iids );
+}
+
+static HRESULT WINAPI iterable_GetRuntimeClassName( IIterable_IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *name )
+{
+    return map_get_class_name( name );
+}
+
+static HRESULT WINAPI iterable_GetTrustLevel( IIterable_IKeyValuePair_HSTRING_HSTRING *iface, TrustLevel *level )
+{
+    return map_get_trust_level( level );
+}
+
+static HRESULT WINAPI iterable_First( IIterable_IKeyValuePair_HSTRING_HSTRING *iface,
+                                      IIterator_IKeyValuePair_HSTRING_HSTRING **value )
+{
+    struct string_map_iterator *iterator;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(iterator = calloc( 1, sizeof(*iterator) ))) return E_OUTOFMEMORY;
+    iterator->IIterator_iface.lpVtbl = &iterator_vtbl;
+    iterator->ref = 1;
+    iterator->map = impl_from_IIterable( iface );
+    InterlockedIncrement( &iterator->map->ref );
+    *value = &iterator->IIterator_iface;
+    return S_OK;
+}
+
+static const IIterable_IKeyValuePair_HSTRING_HSTRINGVtbl iterable_vtbl =
+{
+    iterable_QueryInterface,
+    iterable_AddRef,
+    iterable_Release,
+    iterable_GetIids,
+    iterable_GetRuntimeClassName,
+    iterable_GetTrustLevel,
+    iterable_First,
+};
+
 HRESULT string_map_create( IMap_HSTRING_HSTRING **out )
 {
     struct string_map *impl;
@@ -373,6 +683,7 @@ HRESULT string_map_create( IMap_HSTRING_HSTRING **out )
     if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
     impl->IMap_iface.lpVtbl = &map_vtbl;
     impl->IMapView_iface.lpVtbl = &view_vtbl;
+    impl->IIterable_iface.lpVtbl = &iterable_vtbl;
     impl->ref = 1;
     InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
     impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": string_map.cs");
