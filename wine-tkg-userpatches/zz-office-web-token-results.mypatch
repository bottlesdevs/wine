+    if (FAILED(hr = string_map_create( &impl->properties )))
+        goto failed;
     *out = &impl->IWebProviderError_iface;
     return S_OK;
+
+failed:
+    provider_error_Release( &impl->IWebProviderError_iface );
+    return hr;
 }
 
