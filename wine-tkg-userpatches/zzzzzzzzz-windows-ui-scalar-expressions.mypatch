+static HRESULT expression_parse( struct expression_parser *parser, UINT precedence, BOOL evaluate, FLOAT *value )
+{
+    static const struct
+    {
+        const WCHAR *name;
+        UINT precedence;
+    } operators[] =
+    {
+        {L"||", 1}, {L"&&", 2}, {L"==", 3}, {L"!=", 3},
+        {L"<=", 4}, {L">=", 4}, {L"<", 4}, {L">", 4},
+        {L"+", 5}, {L"-", 5}, {L"*", 6}, {L"/", 6}, {L"%", 6},
+    };
