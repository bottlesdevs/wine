diff --git a/dlls/winegstreamer/wm_reader.c b/dlls/winegstreamer/wm_reader.c
--- a/dlls/winegstreamer/wm_reader.c
+++ b/dlls/winegstreamer/wm_reader.c
@@ -64,6 +64,11 @@ struct wm_reader
     WORD stream_count;
 };
 
+static bool is_kirikiri_media_reader(void)
+{
+    return GetModuleHandleW(L"krmovie.dll") != NULL;
+}
+
 static struct wm_stream *get_stream_by_output_number(struct wm_reader *reader, DWORD output)
 {
     if (output < reader->stream_count)
@@ -558,6 +563,31 @@ static HRESULT WINAPI stream_props_GetMediaType(IWMMediaProps *iface, WM_MEDIA_
     wg_parser_stream_get_codec_format(config->stream->wg_stream, &codec_format);
     format = (codec_format.major_type != WG_MAJOR_TYPE_UNKNOWN && config->stream->demux_compressed) ? &codec_format : &config->stream->format;
 
+    if (is_kirikiri_media_reader())
+    {
+        if (format->major_type == WG_MAJOR_TYPE_VIDEO
+                && codec_format.major_type == WG_MAJOR_TYPE_VIDEO_WMV)
+        {
+            enum wg_video_format video_format = codec_format.u.video.format;
+
+            codec_format = config->stream->format;
+            codec_format.major_type = WG_MAJOR_TYPE_VIDEO_WMV;
+            codec_format.u.video.format = video_format;
+            codec_format.u.video.height = abs(codec_format.u.video.height);
+            format = &codec_format;
+        }
+        else if (format->major_type == WG_MAJOR_TYPE_AUDIO
+                && codec_format.major_type == WG_MAJOR_TYPE_AUDIO_WMA)
+        {
+            unsigned int version = codec_format.u.audio.version;
+
+            codec_format = config->stream->format;
+            codec_format.major_type = WG_MAJOR_TYPE_AUDIO_WMA;
+            codec_format.u.audio.version = version;
+            format = &codec_format;
+        }
+    }
+
 {
     const char *sgi = getenv("SteamGameId");
     if (format->major_type == WG_MAJOR_TYPE_VIDEO && sgi && (0
@@ -1539,14 +1569,14 @@ static HRESULT init_stream(struct wm_reader *reader)
 
 {
     const char *sgi = getenv("SteamGameId");
-    if (sgi && (0
+    if (is_kirikiri_media_reader() || (sgi && (0
         || !strcmp(sgi, "802870")
         || !strcmp(sgi, "1083650")
         || !strcmp(sgi, "1097880")
         || !strcmp(sgi, "1230140")
         || !strcmp(sgi, "2515070")
         || !strcmp(sgi, "3625380")
-    ))
+    )))
     enable_opengl = FALSE;
 }
 
@@ -1682,14 +1712,14 @@ static HRESULT reinit_stream(struct wm_reader *reader, bool read_compressed)
 
 {
     const char *sgi = getenv("SteamGameId");
-    if (sgi && (0
+    if (is_kirikiri_media_reader() || (sgi && (0
         || !strcmp(sgi, "802870")
         || !strcmp(sgi, "1083650")
         || !strcmp(sgi, "1097880")
         || !strcmp(sgi, "1230140")
         || !strcmp(sgi, "2515070")
         || !strcmp(sgi, "3625380")
-    ))
+    )))
     enable_opengl = FALSE;
 }
 
@@ -2680,13 +2710,13 @@ static HRESULT WINAPI reader_SetReadStreamSamples(IWMSyncReader2 *iface, WORD st
     {
         const char *sgi = getenv("SteamGameId");
-        if (sgi && (0
+        if (is_kirikiri_media_reader() || (sgi && (0
             || !strcmp(sgi, "638160")
             || !strcmp(sgi, "802870")
             || !strcmp(sgi, "1083650")
             || !strcmp(sgi, "1097880")
             || !strcmp(sgi, "1230140")
             || !strcmp(sgi, "2515070")
             || !strcmp(sgi, "3625380")
-            ))
+            )))
             compressed = FALSE;
     }
 
