+#ifndef __WINE_INKOBJCORE_PRIVATE_H
+#define __WINE_INKOBJCORE_PRIVATE_H
+
+#include <stdarg.h>
+#include <stdlib.h>
+#define COBJMACROS
+#include "windef.h"
