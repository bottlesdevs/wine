+
+#pragma makedep register
+#pragma winrt ns_prefix
+
+import "windows.ui.input.inking.idl";
+
+namespace Windows.UI.Input.Inking {
+    runtimeclass InkPoint;
+    runtimeclass InkDrawingAttributes;
