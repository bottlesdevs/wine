@@ -96,8 +96,33 @@ static HRESULT STDMETHODCALLTYPE uri_GetTrustLevel(IUriRuntimeClass *iface, Trus

+static HRESULT uri_prop_to_hstring(IUri *uri, Uri_PROPERTY prop, HSTRING *out)
+{
+    BSTR bstr = NULL;
+    HRESULT hr;
+
+    hr = IUri_GetPropertyBSTR(uri, prop, &bstr, 0);
+    if (FAILED(hr))
+    {
+        *out = NULL;
+        return hr;
+    }
+
+    if (hr == S_FALSE || !SysStringLen(bstr))
+    {
+        SysFreeString(bstr);
+        *out = NULL;
+        return S_OK;
+    }
+
+    hr = WindowsCreateString(bstr, SysStringLen(bstr), out);
+    SysFreeString(bstr);
+    return hr;
+}
+
