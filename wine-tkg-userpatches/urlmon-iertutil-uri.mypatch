diff --git a/dlls/urlmon/http.c b/dlls/urlmon/http.c
index e592f697485..521a8b7b704 100644
--- a/dlls/urlmon/http.c
+++ b/dlls/urlmon/http.c
@@ -503,2 +503,10 @@ static BOOL is_redirect_response(DWORD status_code)

+static BOOL is_non_http_absolute_url(const WCHAR *url)
+{
+    const WCHAR *separator;
+
+    if (!url || !(separator = wcschr(url, ':')) || separator == url) return FALSE;
+    return wcsnicmp(url, L"http:", 5) && wcsnicmp(url, L"https:", 6);
+}
+
 static HRESULT HttpProtocol_start_downloading(Protocol *prot)
@@ -522,12 +530,16 @@ static HRESULT HttpProtocol_start_downloading(Protocol *prot)

-        if((This->base.bind_info.dwOptions & BINDINFO_OPTIONS_DISABLEAUTOREDIRECTS) && is_redirect_response(status_code)) {
+        if(is_redirect_response(status_code)) {
             WCHAR *location;

-            TRACE("Got redirect with disabled auto redirects\n");
-
             location = query_http_info(This, HTTP_QUERY_LOCATION);
-            This->base.flags |= FLAG_RESULT_REPORTED | FLAG_LAST_DATA_REPORTED;
-            IInternetProtocolSink_ReportResult(This->base.protocol_sink, INET_E_REDIRECT_FAILED, 0, location);
+            if((This->base.bind_info.dwOptions & BINDINFO_OPTIONS_DISABLEAUTOREDIRECTS) ||
+               is_non_http_absolute_url(location)) {
+                TRACE("Reporting redirect to %s\n", debugstr_w(location));
+                This->base.flags |= FLAG_RESULT_REPORTED | FLAG_LAST_DATA_REPORTED;
+                IInternetProtocolSink_ReportResult(This->base.protocol_sink,
+                        INET_E_REDIRECT_FAILED, 0, location);
+                free(location);
+                return INET_E_REDIRECT_FAILED;
+            }
             free(location);
-            return INET_E_REDIRECT_FAILED;
         }
diff --git a/dlls/urlmon/tests/protocol.c b/dlls/urlmon/tests/protocol.c
index a7692319c35..9c093d1ef32 100644
--- a/dlls/urlmon/tests/protocol.c
+++ b/dlls/urlmon/tests/protocol.c
@@ -2996,2 +2996,54 @@ static void test_file_protocol_url(LPCWSTR url)

+static void test_file_protocol_delete(void)
+{
+    static const char html_doc[] = "<HTML></HTML>";
+    IInternetProtocol *protocol;
+    BYTE buf[sizeof(html_doc) - 1];
+    DWORD size;
+    ULONG read;
+    HANDLE file;
+    HRESULT hres;
+    BOOL ret;
+
+    file = CreateFileW(L"delete.html", GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+            FILE_ATTRIBUTE_NORMAL, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "CreateFile failed: %lu\n", GetLastError());
+    if(file == INVALID_HANDLE_VALUE)
+        return;
+
+    ret = WriteFile(file, html_doc, sizeof(html_doc) - 1, &size, NULL);
+    ok(ret, "WriteFile failed: %lu\n", GetLastError());
+    CloseHandle(file);
+
+    file_name = L"delete.html";
+    bindf = 0;
+    hres = CoCreateInstance(&CLSID_FileProtocol, NULL, CLSCTX_INPROC_SERVER | CLSCTX_INPROC_HANDLER,
+            &IID_IInternetProtocol, (void **)&protocol);
+    ok(hres == S_OK, "CoCreateInstance failed: %08lx\n", hres);
+    if(SUCCEEDED(hres)) {
+        if(file_protocol_start(protocol, L"file:delete.html", NULL, NULL, TRUE)) {
+            hres = IInternetProtocol_Read(protocol, buf, sizeof(buf), &read);
+            ok(hres == S_OK, "Read failed: %08lx\n", hres);
+            ok(read == sizeof(buf), "read %lu bytes\n", read);
+
+            hres = IInternetProtocol_Read(protocol, buf, sizeof(buf), &read);
+            ok(hres == S_FALSE, "Read failed: %08lx\n", hres);
+            ok(!read, "read %lu bytes\n", read);
+
+            SetLastError(0xdeadbeef);
+            ret = DeleteFileW(L"delete.html");
+            ok(ret, "DeleteFile failed: %lu\n", GetLastError());
+
+            file = CreateFileW(L"delete.html", GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                    FILE_ATTRIBUTE_NORMAL, NULL);
+            ok(file != INVALID_HANDLE_VALUE, "CreateFile failed: %lu\n", GetLastError());
+            if(file != INVALID_HANDLE_VALUE)
+                CloseHandle(file);
+        }
+        IInternetProtocol_Release(protocol);
+    }
+
+    DeleteFileW(L"delete.html");
+}
+
 static void test_file_protocol_fail(void)
@@ -3168,2 +3220,5 @@ static void test_file_protocol(void) {

+    init_test(FILE_TEST, 0);
+    test_file_protocol_delete();
+
     DeleteFileW(L"index.html#frag#abc");
