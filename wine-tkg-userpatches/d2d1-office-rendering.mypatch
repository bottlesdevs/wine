+
+static void svg_skip_separators(const WCHAR **p)
+{
+    while (**p == ' ' || **p == '\t' || **p == '\r' || **p == '\n' || **p == ',') ++*p;
+}
+
+static BOOL svg_read_float(const WCHAR **p, float *value)
+{
+    WCHAR *end;
+
+    svg_skip_separators(p);
+    *value = wcstof(*p, &end);
+    if (end == *p) return FALSE;
+    *p = end;
+    return TRUE;
+}
+
+static D2D1_POINT_2F svg_absolute_point(D2D1_POINT_2F point, D2D1_POINT_2F current, BOOL relative)
+{
+    if (relative)
+    {
+        point.x += current.x;
+        point.y += current.y;
+    }
+    return point;
+}
+
+static HRESULT d2d_svg_path_create_geometry(ID2D1Factory *factory, const WCHAR *path,
+        ID2D1PathGeometry **geometry)
+{
+    D2D1_POINT_2F current = {0.0f, 0.0f}, start = {0.0f, 0.0f}, point;
+    D2D1_BEZIER_SEGMENT bezier;
+    ID2D1GeometrySink *sink;
+    WCHAR command = 0;
+    BOOL figure_open = FALSE, relative;
+    HRESULT hr;
+
+    if (FAILED(hr = ID2D1Factory_CreatePathGeometry(factory, geometry))) return hr;
+    if (FAILED(hr = ID2D1PathGeometry_Open(*geometry, &sink)))
+    {
+        ID2D1PathGeometry_Release(*geometry);
+        *geometry = NULL;
+        return hr;
+    }
+
+    while (*path)
+    {
+        svg_skip_separators(&path);
+        if (!*path) break;
+        if ((*path >= 'A' && *path <= 'Z') || (*path >= 'a' && *path <= 'z')) command = *path++;
+        if (!command) { hr = E_INVALIDARG; goto done; }
+        relative = command >= 'a' && command <= 'z';
+
+        switch (command)
+        {
+            case 'M': case 'm':
+                if (!svg_read_float(&path, &point.x) || !svg_read_float(&path, &point.y))
+                {
+                    hr = E_INVALIDARG;
+                    goto done;
+                }
+                point = svg_absolute_point(point, current, relative);
+                if (figure_open) ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+                ID2D1GeometrySink_BeginFigure(sink, point, D2D1_FIGURE_BEGIN_FILLED);
+                current = start = point;
+                figure_open = TRUE;
+                command = relative ? 'l' : 'L';
+                break;
+
+            case 'L': case 'l':
+                if (!svg_read_float(&path, &point.x) || !svg_read_float(&path, &point.y))
+                {
+                    hr = E_INVALIDARG;
+                    goto done;
+                }
+                current = svg_absolute_point(point, current, relative);
+                ID2D1GeometrySink_AddLine(sink, current);
+                break;
+
+            case 'H': case 'h':
+                if (!svg_read_float(&path, &point.x)) { hr = E_INVALIDARG; goto done; }
+                current.x = relative ? current.x + point.x : point.x;
+                ID2D1GeometrySink_AddLine(sink, current);
+                break;
+
+            case 'V': case 'v':
+                if (!svg_read_float(&path, &point.y)) { hr = E_INVALIDARG; goto done; }
+                current.y = relative ? current.y + point.y : point.y;
+                ID2D1GeometrySink_AddLine(sink, current);
+                break;
+
+            case 'C': case 'c':
+                if (!svg_read_float(&path, &bezier.point1.x) || !svg_read_float(&path, &bezier.point1.y)
+                        || !svg_read_float(&path, &bezier.point2.x) || !svg_read_float(&path, &bezier.point2.y)
+                        || !svg_read_float(&path, &bezier.point3.x) || !svg_read_float(&path, &bezier.point3.y))
+                {
+                    hr = E_INVALIDARG;
+                    goto done;
+                }
+                bezier.point1 = svg_absolute_point(bezier.point1, current, relative);
+                bezier.point2 = svg_absolute_point(bezier.point2, current, relative);
+                bezier.point3 = svg_absolute_point(bezier.point3, current, relative);
+                current = bezier.point3;
+                ID2D1GeometrySink_AddBezier(sink, &bezier);
+                break;
+
+            case 'Z': case 'z':
+                if (figure_open) ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+                current = start;
+                figure_open = FALSE;
+                command = 0;
+                break;
+
+            default:
+                FIXME("SVG path command %lc is not implemented.\n", command);
+                hr = E_NOTIMPL;
+                goto done;
+        }
+    }
+
+    hr = S_OK;
+done:
+    if (figure_open) ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+    if (SUCCEEDED(hr)) hr = ID2D1GeometrySink_Close(sink);
+    ID2D1GeometrySink_Release(sink);
+    if (FAILED(hr))
+    {
+        ID2D1PathGeometry_Release(*geometry);
+        *geometry = NULL;
+    }
+    return hr;
 }

