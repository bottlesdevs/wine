+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_document_Deserialize(ID2D1SvgDocument *iface,
+        IStream *stream, IUnknown **subtree)
+{
+    FIXME("iface %p, stream %p, subtree %p stub!\n", iface, stream, subtree);
+    if (subtree) *subtree = NULL;
+    return E_NOTIMPL;
+}
