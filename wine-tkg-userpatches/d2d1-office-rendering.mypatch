+static const GUID IID_ID2D1SvgDocument =
+    {0x86b88e4d, 0xafa4, 0x4d7b, {0x88, 0xe4, 0x68, 0xa5, 0x1c, 0x4a, 0x0a, 0xec}};
+static const GUID IID_ID2D1SvgElement =
+    {0xac7b67a6, 0x183e, 0x49c1, {0xa8, 0x23, 0x0e, 0xbe, 0x40, 0xb0, 0xdb, 0x29}};
+
+struct d2d_svg_element
+{
+    IUnknown IUnknown_iface;
+    LONG refcount;
+    struct d2d_svg_document *document;
+    struct d2d_svg_element *parent;
+    struct d2d_svg_element *first_child;
+    struct d2d_svg_element *last_child;
+    struct d2d_svg_element *next;
+    struct d2d_svg_element *previous;
+    WCHAR *tag;
+    WCHAR *path_data;
+    D2D1_COLOR_F color;
+    float opacity;
+    BOOL has_color;
+};
+
+struct d2d_svg_document
+{
+    ID2D1SvgDocument ID2D1SvgDocument_iface;
+    LONG refcount;
+    ID2D1Factory *factory;
+    D2D1_SIZE_F viewport_size;
+    IUnknown *root;
+};
+
+static inline struct d2d_svg_element *impl_from_ID2D1SvgElement(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_svg_element, IUnknown_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_QueryInterface(IUnknown *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (!out) return E_POINTER;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_ID2D1Resource)
+            || IsEqualGUID(iid, &IID_ID2D1SvgElement))
+    {
+        *out = iface;
+        IUnknown_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_element_AddRef(IUnknown *iface)
+{
+    return InterlockedIncrement(&impl_from_ID2D1SvgElement(iface)->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_element_Release(IUnknown *iface)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    ULONG refcount = InterlockedDecrement(&element->refcount);
+
+    if (!refcount)
+    {
+        struct d2d_svg_element *child, *next;
+
+        for (child = element->first_child; child; child = next)
+        {
+            next = child->next;
+            child->parent = NULL;
+            IUnknown_Release(&child->IUnknown_iface);
+        }
+        free(element->path_data);
+        free(element->tag);
+        free(element);
+    }
+    return refcount;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetFactory(IUnknown *iface, ID2D1Factory **factory)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    *factory = element->document->factory;
+    ID2D1Factory_AddRef(*factory);
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetDocument(IUnknown *iface, ID2D1SvgDocument **document)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, document %p.\n", iface, document);
+    *document = &element->document->ID2D1SvgDocument_iface;
+    (*document)->lpVtbl->AddRef(*document);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetTagName(IUnknown *iface, WCHAR *name, UINT32 count)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    UINT32 length = wcslen(element->tag);
+
+    TRACE("iface %p, name %p, count %u.\n", iface, name, count);
+    if (!name || count <= length) return E_INVALIDARG;
+    memcpy(name, element->tag, (length + 1) * sizeof(*name));
+    return S_OK;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_svg_element_GetTagNameLength(IUnknown *iface)
+{
+    return wcslen(impl_from_ID2D1SvgElement(iface)->tag);
+}
+
+static BOOL STDMETHODCALLTYPE d2d_svg_element_IsTextContent(IUnknown *iface)
+{
+    return !wcscmp(impl_from_ID2D1SvgElement(iface)->tag, L"");
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetParent(IUnknown *iface, IUnknown **parent)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, parent %p.\n", iface, parent);
+    if ((*parent = element->parent ? &element->parent->IUnknown_iface : NULL)) IUnknown_AddRef(*parent);
+}
+
+static BOOL STDMETHODCALLTYPE d2d_svg_element_HasChildren(IUnknown *iface)
+{
+    TRACE("iface %p.\n", iface);
+    return !!impl_from_ID2D1SvgElement(iface)->first_child;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetFirstChild(IUnknown *iface, IUnknown **child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, child %p.\n", iface, child);
+    if ((*child = element->first_child ? &element->first_child->IUnknown_iface : NULL)) IUnknown_AddRef(*child);
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetLastChild(IUnknown *iface, IUnknown **child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, child %p.\n", iface, child);
+    if ((*child = element->last_child ? &element->last_child->IUnknown_iface : NULL)) IUnknown_AddRef(*child);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetPreviousChild(IUnknown *iface,
+        IUnknown *reference, IUnknown **child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(reference);
+
+    TRACE("iface %p, reference %p, child %p.\n", iface, reference, child);
+    if (!child) return E_POINTER;
+    *child = element->previous ? &element->previous->IUnknown_iface : NULL;
+    if (*child) IUnknown_AddRef(*child);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetNextChild(IUnknown *iface,
+        IUnknown *reference, IUnknown **child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(reference);
+
+    TRACE("iface %p, reference %p, child %p.\n", iface, reference, child);
+    if (!child) return E_POINTER;
+    *child = element->next ? &element->next->IUnknown_iface : NULL;
+    if (*child) IUnknown_AddRef(*child);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_InsertChildBefore(IUnknown *iface,
+        IUnknown *child, IUnknown *reference)
+{
+    TRACE("iface %p, child %p, reference %p.\n", iface, child, reference);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_AppendChild(IUnknown *iface, IUnknown *child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct d2d_svg_element *new_child = impl_from_ID2D1SvgElement(child);
+
+    TRACE("iface %p, child %p.\n", iface, child);
+    if (!child || new_child->document != element->document || new_child->parent) return E_INVALIDARG;
+    new_child->parent = element;
+    new_child->previous = element->last_child;
+    if (element->last_child) element->last_child->next = new_child;
+    else element->first_child = new_child;
+    element->last_child = new_child;
+    IUnknown_AddRef(child);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_ReplaceChild(IUnknown *iface,
+        IUnknown *new_child, IUnknown *old_child)
+{
+    TRACE("iface %p, new_child %p, old_child %p.\n", iface, new_child, old_child);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_RemoveChild(IUnknown *iface, IUnknown *child)
+{
+    TRACE("iface %p, child %p.\n", iface, child);
+    return S_OK;
+}
+
+static HRESULT d2d_svg_element_create(struct d2d_svg_document *document,
+        const WCHAR *tag, IUnknown **element);
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_CreateChild(IUnknown *iface,
+        const WCHAR *tag, IUnknown **child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, tag %s, child %p.\n", iface, debugstr_w(tag), child);
+    if (FAILED(hr = d2d_svg_element_create(element->document, tag, child))) return hr;
+    if (FAILED(hr = d2d_svg_element_AppendChild(iface, *child)))
+    {
+        IUnknown_Release(*child);
+        *child = NULL;
+    }
+    return hr;
+}
