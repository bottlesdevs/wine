+            iface, debugstr_w(name), debugstr_guid(iid), value);
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetAttributeValuePod(IUnknown *iface,
