+static HRESULT STDMETHODCALLTYPE d2d_svg_document_SetRoot(ID2D1SvgDocument *iface, IUnknown *root)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+
+    TRACE("iface %p, root %p.\n", iface, root);
+
+    if (root) IUnknown_AddRef(root);
+    if (document->root) IUnknown_Release(document->root);
+    document->root = root;
+    return S_OK;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_document_GetRoot(ID2D1SvgDocument *iface, IUnknown **root)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+
+    TRACE("iface %p, root %p.\n", iface, root);
+
+    *root = document->root;
+    if (*root) IUnknown_AddRef(*root);
+}
