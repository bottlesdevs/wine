+static HRESULT STDMETHODCALLTYPE d2d_svg_element_SetAttributeValue(IUnknown *iface,
+        const WCHAR *name, IUnknown *value)
+{
+    TRACE("iface %p, name %s, value %p.\n", iface, debugstr_w(name), value);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_SetAttributeValuePod(IUnknown *iface,
+        const WCHAR *name, UINT32 type, const void *value, UINT32 size)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, name %s, type %u, value %p, size %u.\n",
+            iface, debugstr_w(name), type, value, size);
+    if (!wcscmp(name, L"color") && size == sizeof(element->color))
+    {
+        memcpy(&element->color, value, size);
+        element->has_color = TRUE;
+    }
+    else if (!wcscmp(name, L"opacity") && size == sizeof(element->opacity))
+    {
+        memcpy(&element->opacity, value, size);
+    }
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_SetAttributeValueString(IUnknown *iface,
+        const WCHAR *name, UINT32 type, const WCHAR *value)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    WCHAR *copy;
+
+    TRACE("iface %p, name %s, type %u, value %s.\n",
+            iface, debugstr_w(name), type, debugstr_w(value));
+    if (!wcscmp(name, L"d"))
+    {
+        if (!(copy = wcsdup(value))) return E_OUTOFMEMORY;
+        free(element->path_data);
+        element->path_data = copy;
+    }
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetAttributeValue(IUnknown *iface,
+        const WCHAR *name, REFIID iid, void **value)
+{
