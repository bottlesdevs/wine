+            OffsetRgn( bounds, tile->origin.x, tile->origin.y );
+            if (type == ERROR) { DeleteObject( bounds ); return E_OUTOFMEMORY; }
+            if (type == NULLREGION) drawing_surface_free_tile( tile );
+        }
+        DeleteObject( bounds );
+    }
+    else drawing_surface_clear_tiles( impl );
     if (impl->bitmap)
