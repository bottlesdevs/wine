diff --git a/configure.ac b/configure.ac
index f6904f252ec..12db27d0711 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3443,6 +3443,7 @@ WINE_CONFIG_MAKEFILE(dlls/winehid.sys)
 WINE_CONFIG_MAKEFILE(dlls/winemac.drv)
 WINE_CONFIG_MAKEFILE(dlls/winemapi)
 WINE_CONFIG_MAKEFILE(dlls/wineoss.drv)
+WINE_CONFIG_MAKEFILE(dlls/wineopenxr)
 WINE_CONFIG_MAKEFILE(dlls/wineps.drv)
 WINE_CONFIG_MAKEFILE(dlls/wineps16.drv16)
 WINE_CONFIG_MAKEFILE(dlls/winepulse.drv)
diff --git a/dlls/wineopenxr/Makefile.in b/dlls/wineopenxr/Makefile.in
index d9e04f50864..a476cc65652 100644
--- a/dlls/wineopenxr/Makefile.in
+++ b/dlls/wineopenxr/Makefile.in
@@ -2,5 +2,6 @@ MODULE     = wineopenxr.dll
 UNIXLIB    = wineopenxr.so
 IMPORTS    = advapi32 user32 dxgi winevulkan
+UNIX_LIBS  = -lopenxr_loader
 
 EXTRADEFS  = -DWINE_NO_LONG_TYPES
 
diff --git a/dlls/wineopenxr/openxr_loader.c b/dlls/wineopenxr/openxr_loader.c
index dfd99dcf730..961fb708bd8 100644
--- a/dlls/wineopenxr/openxr_loader.c
+++ b/dlls/wineopenxr/openxr_loader.c
@@ -14,6 +14,9 @@ static XrVersion api_version = XR_CURRENT_API_VERSION;
 #define SESSION_TYPE_D3D11 3
 #define SESSION_TYPE_D3D12 4
 
+static int get_extensions(char **ret_instance_extensions, char **ret_device_extensions,
+                          uint32_t *ret_physdev_vid, uint32_t *ret_physdev_pid);
+
 UINT64 g_vk_create_instance_callback;
 UINT64 g_vk_create_device_callback;
 
@@ -215,6 +218,8 @@ static BOOL wine_openxr_unix_init_once(void) {
 }
 
 static XrResult wine_openxr_init_once(void) {
+  char runtime[5] = {0};
+  DWORD size;
   if (g_instance_extensions || g_device_extensions) {
     /* already done */
     return XR_SUCCESS;
@@ -224,7 +229,13 @@ static XrResult wine_openxr_init_once(void) {
     return XR_ERROR_INITIALIZATION_FAILED;
   }
 
-  if (!get_vulkan_extensions()) {
+  size = GetEnvironmentVariableA("SODA_OPENXR_RUNTIME", runtime, ARRAY_SIZE(runtime));
+  if (size && size < ARRAY_SIZE(runtime) && !strcmp(runtime, "host")) {
+    XrResult result = get_extensions(&g_instance_extensions, &g_device_extensions,
+                                     &g_physdev_vid, &g_physdev_pid);
+    if (result != XR_SUCCESS)
+      return result;
+  } else if (!get_vulkan_extensions()) {
     return XR_ERROR_INITIALIZATION_FAILED;
   }
 
