-        {
-            close( netlink_fd );
-            netlink_fd = -1;
-            ERR( "bind failed, errno %d.\n", errno );
-            return STATUS_NOT_IMPLEMENTED;
-        }
-    }
+    if ((status = unix_nsi_init_notification( NULL ))) return status;
 
     while (1)
