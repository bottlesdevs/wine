 #define LIST_ENTRY_INIT( list )  { .Flink = &(list), .Blink = &(list) }
 static LIST_ENTRY notification_queue = LIST_ENTRY_INIT( notification_queue );
+/* A failed polling worker cannot service later subscriptions either. */
