 struct sink_entry
 {
     struct list entry;
     DWORD cookie;
-    IUnknown *unk;
+    DWORD git_cookie;
+    BOOL relay;
+};
+
+/* Old prefixes may lack the NLM event typelib. Keep the sink in its advising
+ * apartment, using the longstanding standard proxy for this one-LONG relay. */
+struct event_relay
+{
+    IPropertyNotifySink IPropertyNotifySink_iface;
+    LONG refs;
+    INetworkListManagerEvents *sink;
 };
 
+static HRESULT WINAPI event_relay_QueryInterface( IPropertyNotifySink *iface, REFIID iid, void **out )
+{
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IPropertyNotifySink ))
+        return E_NOINTERFACE;
+    *out = iface;
+    IPropertyNotifySink_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI event_relay_AddRef( IPropertyNotifySink *iface )
+{
+    struct event_relay *relay = CONTAINING_RECORD( iface, struct event_relay, IPropertyNotifySink_iface );
+    return InterlockedIncrement( &relay->refs );
+}
+
+static ULONG WINAPI event_relay_Release( IPropertyNotifySink *iface )
+{
+    struct event_relay *relay = CONTAINING_RECORD( iface, struct event_relay, IPropertyNotifySink_iface );
+    ULONG refs = InterlockedDecrement( &relay->refs );
+    if (!refs)
+    {
+        INetworkListManagerEvents_Release( relay->sink );
+        free( relay );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI event_relay_OnChanged( IPropertyNotifySink *iface, DISPID connectivity )
+{
+    struct event_relay *relay = CONTAINING_RECORD( iface, struct event_relay, IPropertyNotifySink_iface );
+    HRESULT hr;
+
+    IPropertyNotifySink_AddRef( iface );
+    hr = INetworkListManagerEvents_ConnectivityChanged( relay->sink, connectivity );
+    IPropertyNotifySink_Release( iface );
+    return hr;
+}
+
+static HRESULT WINAPI event_relay_OnRequestEdit( IPropertyNotifySink *iface, DISPID dispid )
+{
+    return E_NOTIMPL;
+}
+
+static const IPropertyNotifySinkVtbl event_relay_vtbl =
+{
+    event_relay_QueryInterface,
+    event_relay_AddRef,
+    event_relay_Release,
+    event_relay_OnChanged,
+    event_relay_OnRequestEdit,
+};
+
+static HRESULT start_monitor( struct list_manager *mgr );
+static void stop_monitor( struct list_manager *mgr );
+static void start_reachability_monitor( struct list_manager *mgr );
+static void stop_reachability_monitor( struct list_manager *mgr );
+static NLM_CONNECTIVITY get_connectivity( struct list_manager *mgr );
+
 static inline struct list_manager *impl_from_IConnectionPointContainer(IConnectionPointContainer *iface)
 {
     return CONTAINING_RECORD(iface, struct list_manager, IConnectionPointContainer_iface);
@@ -182,38 +284,87 @@ static HRESULT WINAPI connection_point_Advise(
 {
     struct connection_point *cp = impl_from_IConnectionPoint( iface );
     struct sink_entry *sink_entry;
+    IGlobalInterfaceTable *git;
     IUnknown *unk;
     HRESULT hr;
 
-    FIXME( "%p, %p, %p - semi-stub\n", cp, sink, cookie );
+    TRACE( "%p, %p, %p\n", cp, sink, cookie );
 
     if (!sink || !cookie)
         return E_POINTER;
 
-    hr = IUnknown_QueryInterface( sink, &cp->iid, (void**)&unk );
+    sink_entry = malloc( sizeof(*sink_entry) );
+    if (!sink_entry) return E_OUTOFMEMORY;
+
+    hr = IUnknown_QueryInterface( sink, &cp->iid, (void **)&unk );
     if (FAILED(hr))
     {
         WARN( "iface %s not implemented by sink\n", debugstr_guid(&cp->iid) );
+        free( sink_entry );
         return CONNECT_E_CANNOTCONNECT;
     }
 
-    sink_entry = malloc( sizeof(*sink_entry) );
-    if (!sink_entry)
+    hr = CoCreateInstance( &CLSID_StdGlobalInterfaceTable, NULL, CLSCTX_INPROC_SERVER,
+                           &IID_IGlobalInterfaceTable, (void **)&git );
+    sink_entry->relay = FALSE;
+    if (SUCCEEDED(hr))
+    {
+        hr = IGlobalInterfaceTable_RegisterInterfaceInGlobal( git, unk, &cp->iid,
+                                                              &sink_entry->git_cookie );
+        if (FAILED(hr) && IsEqualGUID( &cp->iid, &IID_INetworkListManagerEvents ))
+        {
+            struct event_relay *relay = malloc( sizeof(*relay) );
+            if (!relay) hr = E_OUTOFMEMORY;
+            else
+            {
+                relay->IPropertyNotifySink_iface.lpVtbl = &event_relay_vtbl;
+                relay->refs = 1;
+                relay->sink = (INetworkListManagerEvents *)unk;
+                IUnknown_AddRef( unk );
+                hr = IGlobalInterfaceTable_RegisterInterfaceInGlobal( git,
+                        (IUnknown *)&relay->IPropertyNotifySink_iface, &IID_IPropertyNotifySink,
+                        &sink_entry->git_cookie );
+                IPropertyNotifySink_Release( &relay->IPropertyNotifySink_iface );
+                sink_entry->relay = TRUE;
+            }
+        }
+        else if (FAILED(hr))
+        {
+            /* These connection points do not dispatch events yet. Preserve
+             * their legacy Advise lifetime without requiring new proxies. */
+            hr = IGlobalInterfaceTable_RegisterInterfaceInGlobal( git, unk, &IID_IUnknown,
+                                                                  &sink_entry->git_cookie );
+        }
+        IGlobalInterfaceTable_Release( git );
+    }
+    IUnknown_Release( unk );
+    if (FAILED(hr))
     {
-        IUnknown_Release( unk );
-        return E_OUTOFMEMORY;
+        WARN( "failed to marshal sink for %s, hr %#lx\n", debugstr_guid(&cp->iid), hr );
+        free( sink_entry );
+        return hr;
     }
 
-    sink_entry->unk = unk;
+    EnterCriticalSection( &impl_from_IConnectionPointContainer( cp->container )->cs );
     *cookie = sink_entry->cookie = ++cp->cookie;
     list_add_tail( &cp->sinks, &sink_entry->entry );
+    LeaveCriticalSection( &impl_from_IConnectionPointContainer( cp->container )->cs );
     return S_OK;
 }
 
 static void sink_entry_release( struct sink_entry *entry )
 {
-    list_remove( &entry->entry );
-    IUnknown_Release( entry->unk );
+    IGlobalInterfaceTable *git;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_StdGlobalInterfaceTable, NULL, CLSCTX_INPROC_SERVER,
+                           &IID_IGlobalInterfaceTable, (void **)&git );
+    if (SUCCEEDED(hr))
+    {
+        hr = IGlobalInterfaceTable_RevokeInterfaceFromGlobal( git, entry->git_cookie );
+        IGlobalInterfaceTable_Release( git );
+    }
+    if (FAILED(hr)) WARN( "failed to revoke sink %#lx, hr %#lx\n", entry->git_cookie, hr );
     free( entry );
 }
 
@@ -222,16 +373,21 @@ static HRESULT WINAPI connection_point_Unadvise(
     DWORD cookie )
 {
     struct connection_point *cp = impl_from_IConnectionPoint( iface );
+    struct list_manager *mgr = impl_from_IConnectionPointContainer( cp->container );
     struct sink_entry *iter;
 
     TRACE( "%p, %ld\n", cp, cookie );
 
+    EnterCriticalSection( &mgr->cs );
     LIST_FOR_EACH_ENTRY( iter, &cp->sinks, struct sink_entry, entry )
     {
         if (iter->cookie != cookie) continue;
+        list_remove( &iter->entry );
+        LeaveCriticalSection( &mgr->cs );
         sink_entry_release( iter );
         return S_OK;
     }
+    LeaveCriticalSection( &mgr->cs );
 
     WARN( "invalid cookie\n" );
     return CONNECT_E_NOCONNECTION;
@@ -274,7 +430,11 @@ static void connection_point_init(
 static void connection_point_release( struct connection_point *cp )
 {
     while (!list_empty( &cp->sinks ))
-        sink_entry_release( LIST_ENTRY( list_head( &cp->sinks ), struct sink_entry, entry ) );
+    {
+        struct sink_entry *entry = LIST_ENTRY( list_head( &cp->sinks ), struct sink_entry, entry );
+        list_remove( &entry->entry );
+        sink_entry_release( entry );
+    }
 }
 
 static inline struct network *impl_from_INetwork(
@@ -310,9 +470,12 @@ static ULONG WINAPI network_AddRef(
     INetwork *iface )
 {
     struct network *network = impl_from_INetwork( iface );
+    ULONG refs;
 
     TRACE( "%p\n", network );
-    return InterlockedIncrement( &network->refs );
+    refs = InterlockedIncrement( &network->refs );
+    if (refs == 2) INetworkListManager_AddRef( network->mgr );
+    return refs;
 }
 
 static ULONG WINAPI network_Release(
@@ -323,10 +486,11 @@ static ULONG WINAPI network_Release(
 
     TRACE( "%p\n", network );
 
-    if (!(refs = InterlockedDecrement( &network->refs )))
