+            !(req.ifr_flags & IFF_RUNNING))
+            data->media_conn_state = MediaConnectStateDisconnected;
+#endif
+        if (!(req.ifr_flags & IFF_UP)) data->oper_status = IfOperStatusDown;
+#ifdef IFF_DORMANT
