diff --git a/dlls/netprofm/tests/adversarial.sh b/dlls/netprofm/tests/adversarial.sh
new file mode 100755
index 000000000000..e52316e0852d
--- /dev/null
+++ b/dlls/netprofm/tests/adversarial.sh
@@ -0,0 +1,111 @@
+#!/bin/sh
+set -eu
+
+if [ "${1-}" != "--inside" ]; then
+    build_dir=${1:?usage: $0 BUILD_DIR}
+    build_dir=$(CDPATH= cd -- "$build_dir" && pwd)
+    if unshare --user --map-root-user --net true 2>/dev/null; then
+        exec unshare --user --map-root-user --net "$0" --inside "$build_dir"
+    fi
+    if command -v sudo >/dev/null && sudo -n true 2>/dev/null; then
+        exec sudo -E unshare --net "$0" --inside "$build_dir" "$(id -u)" "$(id -g)"
+    fi
+    echo "network namespaces are unavailable" >&2
+    exit 1
+fi
+
+build_dir=$2
+run_uid=${3-}
+run_gid=${4-}
+source_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
+root=$(CDPATH= cd -- "$source_dir/../../.." && pwd)
+work_dir=$(mktemp -d /tmp/wine-netprofm-adversarial-XXXXXX)
+chmod 755 "$work_dir"
+prefix=$work_dir/prefix
+run_as_user()
+{
+    if [ -n "$run_uid" ]; then
+        run_home=$(getent passwd "$run_uid" | cut -d: -f6)
+        setpriv --reuid="$run_uid" --regid="$run_gid" --init-groups env HOME="$run_home" "$@"
+    else
+        "$@"
+    fi
+}
+cleanup()
+{
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -k 2>/dev/null || true
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -w 2>/dev/null || true
+    rm -rf "$work_dir"
+}
+trap cleanup EXIT INT TERM
+
+ip link set lo up
+ip link add nlm0 type dummy
+ip addr add 192.0.2.2/24 dev nlm0
+ip -6 addr add 2001:db8::2/64 dev nlm0 nodad
+ip link set nlm0 up
+ip route add 198.51.100.0/24 via 192.0.2.1 dev nlm0
+mkdir "$prefix"
+if [ -n "$run_uid" ]; then chown "$run_uid:$run_gid" "$prefix"; fi
+
+${CC:-cc} -shared -fPIC -Wall -Wextra -o "$work_dir/loader.so" "$source_dir/nsi-backend.c" -ldl
+dbus=false
+if grep -q '^#define SONAME_LIBDBUS_1 ' "$build_dir/include/config.h"; then
+    dbus=true
+    ${CC:-cc} -shared -fPIC -Wall -Wl,-z,defs -DNETPROFM_DBUS_MALFORMED -D__WINESRC__ -DWINE_UNIX_LIB \
+        -I"$build_dir/include" -I"$root/include" -I"$source_dir/.." \
+        -o "$work_dir/dbus.so" "$source_dir/nsi-backend.c" \
+        "$build_dir/dlls/ntdll/ntdll.so" -ldl -lpthread
+else
+    echo "D-Bus adversarial fixture: SKIP provider disabled in this build"
+fi
+
+arches=x86_64
+if [ -f "$build_dir/dlls/netprofm/tests/i386-windows/netprofm_test.exe" ]; then
+    arches=i386
+    if [ -f "$build_dir/dlls/netprofm/tests/x86_64-windows/netprofm_test.exe" ]; then arches="x86_64 i386"; fi
+fi
+for arch in $arches; do
+    target=x86_64-w64-mingw32
+    [ "$arch" != i386 ] || target=i686-w64-mingw32
+    set -- -b "$target" -D__WINE_PE_BUILD -lcompiler-rt
+    monitor_exe=$work_dir/monitor-$arch.exe
+    if [ -f "$build_dir/dlls/netprofm/tests/netprofm_test.exe.so" ]; then
+        set -- -m64 -mno-cygwin -fPIC -D_WIN32 -mlong-double-64 \
+            -fno-builtin -fshort-wchar -mabi=ms -fno-stack-protector
+        monitor_exe=$monitor_exe.so
+    fi
+    # compiler-rt must follow winecrt0's i386 integer helper references.
+    "$build_dir/tools/winegcc/winegcc" --wine-objdir "$build_dir" \
+        -D__WINESRC__ -D_MSVCR_VER=0 -I"$build_dir/include" \
+        -I"$root/include" -I"$root/include/msvcrt" -I"$source_dir/.." \
+        -o "$monitor_exe" "$source_dir/monitor-faults.c" \
+        -luuid -liphlpapi -lnsi -lole32 -lwinecrt0 "$@" -lmsvcrt -lkernel32 -lntdll
+    echo "monitor faults: $arch"
+    result=0
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/wine" "$monitor_exe" \
+        >"$work_dir/test.log" 2>&1 || result=$?
+    cat "$work_dir/test.log"
+    [ "$result" -eq 0 ] || exit "$result"
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -w
+    if "$dbus"; then
+        test_exe=$build_dir/dlls/netprofm/tests/$arch-windows/netprofm_test.exe
+        if [ -f "$build_dir/dlls/netprofm/tests/netprofm_test.exe.so" ]; then
+            test_exe=$build_dir/dlls/netprofm/tests/netprofm_test.exe.so
+        fi
+        echo "D-Bus adversarial: $arch"
+        result=0
+        run_as_user env WINEPREFIX="$prefix" WINETEST_NETPROFM_TOPOLOGY_POLICY=dynamic-up \
+            WINETEST_NETPROFM_BACKEND="$work_dir/dbus.so" LD_PRELOAD="$work_dir/loader.so" \
+            DBUS_SYSTEM_BUS_ADDRESS="unix:path=$work_dir/no-bus" \
+            "$build_dir/wine" "$test_exe" list >"$work_dir/test.log" 2>&1 || result=$?
+        cat "$work_dir/test.log"
+        [ "$result" -eq 0 ] || exit "$result"
+        if grep -q 'D-Bus adversarial fixture: SKIP optional libsystemd unavailable' "$work_dir/test.log"; then
+            echo "D-Bus adversarial: $arch SKIP (optional libsystemd unavailable)"
+        else
+            grep -q 'D-Bus adversarial fixture: .* checks passed' "$work_dir/test.log"
+        fi
+        run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -w
+    fi
+done
diff --git a/dlls/netprofm/tests/bus-stalls.sh b/dlls/netprofm/tests/bus-stalls.sh
new file mode 100644
index 000000000000..73402ac66e87
--- /dev/null
+++ b/dlls/netprofm/tests/bus-stalls.sh
@@ -0,0 +1,319 @@
+#!/bin/sh
+# Standalone public COM regression; no production interposition.
+set -eu
+if [ "${1-}" != --inside ]; then
+    build_dir=$(CDPATH='' cd -- "${1:?usage: sh bus-stalls.sh BUILD_DIR}" && pwd)
+    if unshare --user --map-root-user --net true 2>/dev/null; then
+        exec unshare --user --map-root-user --net sh "$0" --inside "$build_dir"
+    fi
+    if command -v sudo >/dev/null && sudo -n true 2>/dev/null; then
+        exec sudo -E unshare --net sh "$0" --inside "$build_dir" "$(id -u)" "$(id -g)"
+    fi
+    echo 'network namespaces unavailable' >&2
+    exit 1
+fi
+build_dir=$2
+run_uid=${3-}
+run_gid=${4-}
+source_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
+work=$(mktemp -d /tmp/wine-nlm-stalls-XXXXXX)
+chmod 755 "$work"
+prefix=$work/prefix
+run_as_user()
+{
+    if [ -n "$run_uid" ]; then
+        setpriv --reuid="$run_uid" --regid="$run_gid" --init-groups \
+            env HOME="$(getent passwd "$run_uid" | cut -d: -f6)" "$@"
+    else
+        "$@"
+    fi
+}
+cleanup()
+{
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -k 2>/dev/null || true
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -w 2>/dev/null || true
+    rm -rf "$work"
+}
+trap cleanup EXIT INT TERM
+ip link set lo up
+ip link add nlm0 type dummy
+ip addr add 192.0.2.2/24 dev nlm0
+ip link set nlm0 up
+# Routed fallback is online; NM NONE must override it in the positive control.
+ip route add default via 192.0.2.1 dev nlm0
+mkdir "$prefix"
+if [ -n "$run_uid" ]; then chown "$run_uid:$run_gid" "$prefix"; fi
+export WINEPREFIX="$prefix" WINEDEBUG=-all
+unset DISPLAY WAYLAND_DISPLAY NLM_RECOVERY
+run_as_user env DBUS_SYSTEM_BUS_ADDRESS="unix:path=$work/missing" \
+    "$build_dir/wine" wineboot --init
+run_as_user "$build_dir/server/wineserver" -w
+run_as_user "$build_dir/server/wineserver" -p
+run_as_user env DBUS_SYSTEM_BUS_ADDRESS="unix:path=$work/missing" \
+    "$build_dir/wine" cmd /c exit
+test_dir=$build_dir/dlls/netprofm/tests
+test_exes=
+for arch in x86_64 i386; do
+    if [ -f "$test_dir/$arch-windows/netprofm_test.exe" ]; then
+        test_exes="$test_exes $test_dir/$arch-windows/netprofm_test.exe"
+    fi
+done
+if [ -z "$test_exes" ] && [ -f "$test_dir/netprofm_test.exe.so" ]; then
+    test_exes=$test_dir/netprofm_test.exe.so
+fi
+[ -n "$test_exes" ] || { echo 'no built netprofm tests found' >&2; exit 1; }
+for exe in $test_exes; do
+    label=$(basename "$(dirname "$exe")")
+    mkdir "$work/$label"
+    if [ -n "$run_uid" ]; then chown "$run_uid:$run_gid" "$work/$label"; fi
+    run_as_user /usr/bin/python3 - "$work/$label" "$source_dir" "$build_dir/wine" "$exe" <<'PY'
+#!/usr/bin/python3
+"""Public COM deadlines with real auth/method targets and NM recovery.
+
+A private daemon supplies real replies; the relay withholds one method.
+"""
+import os
+from pathlib import Path
+import select
+import socket
+import struct
+import subprocess
+import sys
+import threading
+import time
+
+
+def wait_for(predicate, label, timeout=25):
+    end = time.monotonic() + timeout
+    while time.monotonic() < end:
+        if predicate():
+            return
+        time.sleep(.01)
+    raise RuntimeError("deadline waiting for " + label)
+
+
+class Peer:
+    def __init__(self, path, phase, upstream=None):
+        self.phase = phase
+        self.upstream = upstream
+        self.seen = threading.Event()
+        self.errors = []
+        self.clients = []
+        self.sock = socket.socket(socket.AF_UNIX)
+        self.sock.bind(str(path))
+        self.sock.listen(1)
+        if phase == "backlog":
+            # Linux backlog=1 admits two; prove EAGAIN rather than assuming
+            # listen(0) or an unresponsive accepted peer fills the queue.
+            for _ in range(16):
+                client = socket.socket(socket.AF_UNIX)
+                client.setblocking(False)
+                self.clients.append(client)
+                try:
+                    client.connect(str(path))
+                except BlockingIOError:
+                    self.seen.set()
+                    break
+            if not self.seen.is_set():
+                raise RuntimeError("could not saturate accept queue")
+        else:
+            threading.Thread(target=self.accept, daemon=True).start()
+
+    def accept(self):
+        while True:
+            try:
+                client, _ = self.sock.accept()
+                self.clients.append(client)
+                threading.Thread(target=self.exchange, args=(client,), daemon=True).start()
+            except OSError:
+                return
+
+    def exchange(self, client):
+        try:
+            if self.upstream:
+                self.relay(client)
+                return
+            client.settimeout(10)
+            stream = client.makefile("rb", buffering=0)
+            line = stream.readline(4096)
+            if not line.startswith(b"\0AUTH"):
+                raise RuntimeError("expected initial AUTH, got " + repr(line))
+            if self.phase == "auth":
+                self.seen.set()  # Do not answer or close until test has exited.
+                return
+            client.sendall(b"DATA\r\n" if line.strip() == b"\0AUTH EXTERNAL" else
+                           b"OK 0123456789abcdef0123456789abcdef\r\n")
+            while True:
+                line = stream.readline(4096)
+                if line == b"BEGIN\r\n":
+                    break
+                if line == b"NEGOTIATE_UNIX_FD\r\n":
+                    client.sendall(b"ERROR unsupported\r\n")
+                elif line.startswith(b"DATA"):
+                    client.sendall(b"OK 0123456789abcdef0123456789abcdef\r\n")
+                else:
+                    raise RuntimeError("unexpected auth command " + repr(line))
+            def read_exact(count):
+                data = b""
+                while len(data) < count:
+                    part = stream.read(count - len(data))
+                    if not part:
+                        raise RuntimeError("EOF before Hello")
+                    data += part
+                return data
+            header = read_exact(16)
+            if header[:4] != b"l\x01\x00\x01":
+                raise RuntimeError("unexpected D-Bus method header " + repr(header))
+            body, serial, fields = struct.unpack("<III", header[4:])
+            if fields > 4096 or body > 4096 or not serial:
+                raise RuntimeError("invalid Hello lengths")
+            message = read_exact((fields + 7) // 8 * 8 + body)
+            if b"Hello\0" not in message or b"org.freedesktop.DBus\0" not in message:
+                raise RuntimeError("first method was not Hello")
+            self.seen.set()  # Auth succeeded; deliberately never reply to Hello.
+        except Exception as exc:
+            self.errors.append(str(exc))
+
+    def relay(self, client):
+        with socket.socket(socket.AF_UNIX) as upstream:
+            upstream.connect(str(self.upstream))
+            client.settimeout(10)
+            upstream.settimeout(10)
+            stream = client.makefile("rb", buffering=0)
+            auth = upstream.makefile("rb", buffering=0)
+            while True:
+                line = stream.readline(4096)
+                if not line:
+                    return
+                upstream.sendall(line)
+                if line == b"BEGIN\r\n":
+                    break
+                response = auth.readline(4096)
+                if not response:
+                    raise RuntimeError("daemon closed during auth")
+                client.sendall(response)
+
+            def read_exact(count):
+                data = b""
+                while len(data) < count:
+                    part = stream.read(count - len(data))
+                    if not part:
+                        return None
+                    data += part
+                return data
+
+            while True:
+                ready, _, _ = select.select([client, upstream], [], [], 10)
+                if not ready:
+                    return
+                if upstream in ready:
+                    data = upstream.recv(65536)
+                    if not data:
+                        return
+                    client.sendall(data)
+                if client in ready:
+                    header = read_exact(16)
+                    if header is None:
+                        return
+                    endian = "<" if header[0] == ord("l") else ">"
+                    body, _, fields = struct.unpack(endian + "III", header[4:])
+                    if body > 1048576 or fields > 1048576:
+                        raise RuntimeError("unexpected large test message")
+                    payload = read_exact((fields + 7) // 8 * 8 + body)
+                    if payload is None:
+                        return
+                    if self.phase.encode() + b"\0" in payload[:fields]:
+                        self.seen.set()  # Withhold this genuine method request.
+                    else:
+                        upstream.sendall(header + payload)
+
+    def close(self):
+        self.sock.close()
+        for client in self.clients:
+            client.close()
+
+
+def main():
+    work, source, wine, exe = sys.argv[1:]
+    work = Path(work)
+    path = work / "bus"
+    address = "unix:path=" + str(path)
+    children = []
+    peer = None
+    try:
+        for phase in ("auth", "backlog", "hello", "AddMatch", "GetNameOwner", "GetAll", "recovery"):
+            path.unlink(missing_ok=True)
+            markers = work / phase
+            markers.mkdir()
+            env = dict(os.environ, DBUS_SYSTEM_BUS_ADDRESS=address,
+                       NLM_MARKERS="Z:" + str(markers).replace("/", "\\"))
+            if phase in ("AddMatch", "GetNameOwner", "GetAll", "recovery"):
+                upstream = work / "daemon-bus"
+                upstream.unlink(missing_ok=True)
+                daemon_address = "unix:path=" + str(upstream)
+                if phase == "recovery":
+                    env["NLM_RECOVERY"] = "1"
+                    daemon_address = address
+                config = work / "bus.conf"
+                config.write_text('<busconfig><type>session</type><listen>' + daemon_address +
+                                  '</listen><policy context="default"><allow own="*"/>'
+                                  '<allow send_destination="*"/><allow receive_sender="*"/>'
+                                  '</policy></busconfig>')
+                daemon = subprocess.Popen(["dbus-daemon", "--nofork", "--config-file=" + str(config)])
+                children.append(daemon)
+                wait_for((path if phase == "recovery" else upstream).exists, "daemon socket")
+                service = subprocess.Popen(["/usr/bin/python3", source + "/fake-networkmanager.py",
+                                            str(markers / "command"), str(markers / "ready"),
+                                            "NONE", "1", "1"],
+                                           env=dict(env, DBUS_SYSTEM_BUS_ADDRESS=daemon_address))
+                children.append(service)
+                wait_for((markers / "ready").exists, "NetworkManager")
+                if phase != "recovery":
+                    peer = Peer(path, phase, upstream)
+            else:
+                peer = Peer(path, phase)
+            print("bus stalls:", phase, flush=True)
+            test = subprocess.Popen([wine, exe, "list"], env=env)
+            children.append(test)
+            if phase == "recovery":
+                wait_for((markers / "offline").exists, "public OFFLINE")
+                (markers / "command").write_text("1 FULL 1 1\n")
+                wait_for((markers / "online").exists, "public ONLINE")
+                daemon.terminate()
+                daemon.wait(timeout=5)
+                service.terminate()
+                service.wait(timeout=5)
+                path.unlink(missing_ok=True)
+                peer = Peer(path, "auth")
+                wait_for(peer.seen.is_set, "reconnect AUTH")
+                (markers / "release").touch()
+            result = test.wait(timeout=60)
+            if result:
+                raise RuntimeError("COM test failed: " + phase)
+            if not peer.seen.is_set() or peer.errors:
+                raise RuntimeError("wire target not reached: " + repr(peer.errors))
+            print("wire target confirmed:", phase, flush=True)
+            peer.close()
+            peer = None
+            if phase in ("AddMatch", "GetNameOwner", "GetAll"):
+                service.terminate()
+                service.wait(timeout=5)
+                daemon.terminate()
+                daemon.wait(timeout=5)
+    finally:
+        if peer:
+            peer.close()
+        for child in reversed(children):
+            if child.poll() is None:
+                child.terminate()
+                try:
+                    child.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    child.kill()
+                    child.wait()
+
+
+if __name__ == "__main__":
+    main()
+PY
+done
diff --git a/dlls/netprofm/tests/dynamic-cleanup.sh b/dlls/netprofm/tests/dynamic-cleanup.sh
new file mode 100755
index 000000000000..4043a14b0e2e
--- /dev/null
+++ b/dlls/netprofm/tests/dynamic-cleanup.sh
@@ -0,0 +1,62 @@
+#!/bin/sh
+# Regression for the dynamic-network.sh process/prefix cleanup contract.
+# Copyright 2026 Peter Min
+# SPDX-License-Identifier: LGPL-2.1-or-later
+set -eu
+source_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
+work=$(mktemp -d)
+test_pid=
+cleanup()
+{
+    [ -z "$test_pid" ] || kill "$test_pid" 2>/dev/null || true
+    if [ -f "$work/wine.pid" ]; then kill "$(cat "$work/wine.pid")" 2>/dev/null || true; fi
+    rm -rf "$work"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+mkdir -p "$work/bin" "$work/build/server" "$work/build/dlls/netprofm/tests"
+touch "$work/build/dlls/netprofm/tests/netprofm_test.exe"
+# No namespace or network changes: only the shell orchestration is under test.
+printf '#!/bin/sh\nexit 0\n' >"$work/bin/ip"
+cat >"$work/build/wine" <<'EOF'
+#!/bin/sh
+echo "$WINEPREFIX" >"$TEST_WORK/prefix"
+echo $$ >"$TEST_WORK/wine.pid"
+exec sleep 600
+EOF
+cat >"$work/build/server/wineserver" <<'EOF'
+#!/bin/sh
+echo "$1" >>"$TEST_WORK/server.calls"
+if [ "$1" = -k ]; then kill "$(cat "$TEST_WORK/wine.pid")"; fi
+EOF
+chmod +x "$work/bin/ip" "$work/build/wine" "$work/build/server/wineserver"
+export TEST_WORK=$work
+export PATH=$work/bin:$PATH
+for mode in timeout term; do
+    rm -f "$work/wine.pid" "$work/server.calls"
+    sh "${1:-$source_dir/dynamic-network.sh}" --inside "$work/build" >"$work/log" 2>&1 &
+    test_pid=$!
+    for attempt in $(seq 1 100); do
+        [ ! -f "$work/wine.pid" ] || break
+        sleep 0.1
+    done
+    test -f "$work/wine.pid"
+    [ "$mode" != term ] || kill -TERM "$test_pid"
+    result=0
+    wait "$test_pid" || result=$?
+    test_pid=
+    if [ "$mode" = term ]; then test "$result" -eq 143; else test "$result" -eq 1; fi
+    for attempt in $(seq 1 100); do
+        kill -0 "$(cat "$work/wine.pid")" 2>/dev/null || break
+        sleep 0.1
+    done
+    if kill -0 "$(cat "$work/wine.pid")" 2>/dev/null; then
+        echo "$mode left the test process running" >&2
+        exit 1
+    fi
+    grep -qx -- -k "$work/server.calls"
+    grep -qx -- -w "$work/server.calls"
+    test ! -d "$(cat "$work/prefix")"
+    echo "$mode: child stopped, wineserver stopped/waited, prefix removed, exit=$result"
+done
diff --git a/dlls/netprofm/tests/dynamic-network.sh b/dlls/netprofm/tests/dynamic-network.sh
new file mode 100755
index 000000000000..fa7c35f2ec31
--- /dev/null
+++ b/dlls/netprofm/tests/dynamic-network.sh
@@ -0,0 +1,162 @@
+#!/bin/sh
+set -eu
+
+if [ "${1-}" != "--inside" ]; then
+    build_dir=${1:?usage: $0 BUILD_DIR [TEST_EXE]}
+    test_exe=${2-}
+    if [ -n "$test_exe" ] && [ ! -f "$test_exe" ]; then
+        echo "test executable not found: $test_exe" >&2
+        exit 1
+    fi
+    if unshare --user --map-root-user --net true 2>/dev/null; then
+        exec unshare --user --map-root-user --net "$0" --inside "$build_dir" "" "" "$test_exe"
+    fi
+    if command -v sudo >/dev/null && sudo -n true 2>/dev/null; then
+        exec sudo -E unshare --net "$0" --inside "$build_dir" "$(id -u)" "$(id -g)" "$test_exe"
+    fi
+    echo "unprivileged user/network namespaces are unavailable" >&2
+    exit 1
+fi
+
+build_dir=$2
+run_uid=${3-}
+run_gid=${4-}
+test_dir=$build_dir/dlls/netprofm/tests
+test_exe=
+
+for candidate in "${5-}" "$test_dir/netprofm_test.exe.so" "$test_dir/netprofm_test.exe" \
+        "$test_dir/x86_64-windows/netprofm_test.exe" "$test_dir"/*-windows/netprofm_test.exe
+do
+    if [ -f "$candidate" ]; then
+        test_exe=$candidate
+        break
+    fi
+done
+if [ -z "$test_exe" ]; then
+    echo "could not find the netprofm test executable under $test_dir" >&2
+    exit 1
+fi
+
+work_dir=$(mktemp -d /tmp/wine-netprofm-dynamic-XXXXXX)
+chmod 755 "$work_dir"
+marker_dir=$work_dir/markers
+prefix=$work_dir/prefix
+log=$work_dir/test.log
+test_pid=
+run_as_user()
+{
+    if [ -n "$run_uid" ]; then
+        run_home=$(getent passwd "$run_uid" | cut -d: -f6)
+        setpriv --reuid="$run_uid" --regid="$run_gid" --init-groups env HOME="$run_home" "$@"
+    else
+        "$@"
+    fi
+}
+cleanup()
+{
+    result=$?
+    trap - EXIT INT TERM
+    [ -z "$test_pid" ] || kill "$test_pid" 2>/dev/null || true
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -k 2>/dev/null || true
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -w 2>/dev/null || true
+    [ -z "$test_pid" ] || wait "$test_pid" 2>/dev/null || true
+    rm -rf "$work_dir"
+    exit "$result"
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+
+mkdir -p "$marker_dir" "$prefix"
+if [ -n "$run_uid" ]; then
+    chmod 777 "$marker_dir"
+    chown "$run_uid:$run_gid" "$prefix"
+fi
+
+ip link set lo up
+ip link add nlm0 type veth peer name nlm1
+ip addr add 192.0.2.2/24 dev nlm0
+ip -6 addr add 2001:db8::2/64 dev nlm0 nodad
+ip link set nlm1 up
+ip link set nlm0 up
+ip route add default via 192.0.2.1 dev nlm0
+
+run_as_user env WINETEST_NETPROFM_DYNAMIC_DIR="Z:$marker_dir" WINEPREFIX="$prefix" \
+    "$build_dir/wine" "$test_exe" list >"$log" 2>&1 &
+test_pid=$!
+
+wait_marker()
+{
+    marker=$1
+    i=0
+    while [ ! -e "$marker_dir/$marker" ]; do
+        if ! kill -0 "$test_pid" 2>/dev/null; then
+            cat "$log"
+            wait "$test_pid"
+            test_pid=
+            echo "test exited before $marker" >&2
+            exit 1
+        fi
+        i=$((i + 1))
+        if [ "$i" -ge 300 ]; then
+            echo "timed out waiting for $marker" >&2
+            cat "$log"
+            exit 1
+        fi
+        sleep 0.1
+    done
+}
+
+wait_marker initial_no_ipv6_route
+ip -6 route add default via 2001:db8::1 dev nlm0 onlink
+touch "$marker_dir/initial_ipv6_route_added"
+wait_marker ready
+ip route add 198.51.100.0/24 via 192.0.2.1 dev nlm0
+ip route del default
+wait_marker route_removed
+ip route add blackhole default
+touch "$marker_dir/ipv4_unusable_route_added"
+wait_marker ipv4_unusable_route_checked
+ip route del blackhole default
+ip route add default dev nlm0
+wait_marker route_onlink_restored
+ip route del default dev nlm0
+wait_marker route_onlink_removed
+ip route add default via 192.0.2.1 dev nlm0
+wait_marker route_restored
+ip -6 route del default
+wait_marker ipv6_route_removed
+ip -6 route add blackhole default
+touch "$marker_dir/ipv6_unusable_route_added"
+wait_marker ipv6_unusable_route_checked
+ip -6 route del blackhole default
+ip -6 route add default dev nlm0
+wait_marker ipv6_route_onlink_restored
+ip -6 route del default dev nlm0
+wait_marker ipv6_route_onlink_removed
+ip -6 route add default via 2001:db8::1 dev nlm0 onlink
+wait_marker ipv6_route_restored
+ip addr del 192.0.2.2/24 dev nlm0
+wait_marker address_removed
+ip addr add 192.0.2.2/24 dev nlm0
+ip route add default via 192.0.2.1 dev nlm0
+wait_marker address_restored
+ip link set nlm1 down
+wait_marker carrier_down
+ip link set nlm1 up
+
+wait_marker add_adapter
+ip link add nlm2 type dummy
+ip addr add 203.0.113.2/24 dev nlm2
+ip -6 addr add 2001:db8:2::2/64 dev nlm2 nodad
+ip link set nlm2 up
+ip route add 198.51.100.0/24 via 203.0.113.1 dev nlm2 metric 100
+touch "$marker_dir/adapter_added"
+
+if ! wait "$test_pid"; then
+    test_pid=
+    cat "$log"
+    exit 1
+fi
+test_pid=
+cat "$log"
diff --git a/dlls/netprofm/tests/fake-networkmanager.py b/dlls/netprofm/tests/fake-networkmanager.py
new file mode 100755
index 000000000000..c82d8d65cec7
--- /dev/null
+++ b/dlls/netprofm/tests/fake-networkmanager.py
@@ -0,0 +1,80 @@
+#!/usr/bin/python3
+
+import os
+import sys
+import time
+
+import dbus
+import dbus.service
+from dbus.mainloop.glib import DBusGMainLoop
+from gi.repository import GLib
+
+
+CONNECTIVITY = {"UNKNOWN": 0, "NONE": 1, "PORTAL": 2, "LIMITED": 3, "FULL": 4}
+
+
+class NetworkManager(dbus.service.Object):
+    def __init__(self, bus, command_path, ready_path, connectivity, available, enabled):
+        self.command_path = command_path
+        self.last_command = None
+        self.connectivity = CONNECTIVITY[connectivity]
+        self.available = available
+        self.enabled = enabled
+        super().__init__(bus, "/org/freedesktop/NetworkManager")
+        open(command_path + ".requests", "a", encoding="ascii").close()
+        open(ready_path, "w", encoding="ascii").close()
+        GLib.timeout_add(50, self.read_command)
+
+    def properties(self):
+        return {
+            "Connectivity": dbus.UInt32(self.connectivity),
+            "ConnectivityCheckAvailable": dbus.Boolean(self.available),
+            "ConnectivityCheckEnabled": dbus.Boolean(self.enabled),
+        }
+
+    @dbus.service.method("org.freedesktop.DBus.Properties", in_signature="s", out_signature="a{sv}")
+    def GetAll(self, interface):
+        if interface != "org.freedesktop.NetworkManager":
+            return {}
+        with open(self.command_path + ".requests", "a", encoding="ascii") as requests:
+            requests.write("GetAll\n")
+        time.sleep(float(os.environ.get("WINETEST_NM_GETALL_DELAY", "0")))
+        return self.properties()
+
+    @dbus.service.signal("org.freedesktop.DBus.Properties", signature="sa{sv}as")
+    def PropertiesChanged(self, interface, changed, invalidated):
+        pass
+
+    def read_command(self):
+        try:
+            with open(self.command_path, encoding="ascii") as command_file:
+                command = command_file.read().strip()
+        except FileNotFoundError:
+            return True
+        if not command or command == self.last_command:
+            return True
+
+        fields = command.split()
+        serial, connectivity, available, enabled = fields[:4]
+        signals = int(fields[4]) if len(fields) > 4 else 1
+        self.last_command = command
+        self.connectivity = CONNECTIVITY[connectivity]
+        self.available = available == "1"
+        self.enabled = enabled == "1"
+        for _ in range(signals):
+            self.PropertiesChanged("org.freedesktop.NetworkManager", self.properties(), [])
+        open(os.path.join(os.path.dirname(self.command_path), "ack-" + serial), "w", encoding="ascii").close()
+        return True
+
+
+def main():
+    command_path, ready_path, connectivity, available, enabled = sys.argv[1:]
+    DBusGMainLoop(set_as_default=True)
+    bus = dbus.SystemBus()
+    name = dbus.service.BusName("org.freedesktop.NetworkManager", bus)
+    manager = NetworkManager(bus, command_path, ready_path, connectivity, available == "1", enabled == "1")
+    GLib.MainLoop().run()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/dlls/netprofm/tests/ipv6-route-availability.sh b/dlls/netprofm/tests/ipv6-route-availability.sh
new file mode 100755
index 000000000000..612195616f4f
--- /dev/null
+++ b/dlls/netprofm/tests/ipv6-route-availability.sh
@@ -0,0 +1,84 @@
+#!/bin/sh
+set -eu
+
+if [ "${1-}" != "--inside" ]; then
+    build_dir=${1:?usage: $0 BUILD_DIR}
+    build_dir=$(CDPATH= cd -- "$build_dir" && pwd)
+    if unshare --user --map-root-user --net true 2>/dev/null; then
+        exec unshare --user --map-root-user --net "$0" --inside "$build_dir"
+    fi
+    if command -v sudo >/dev/null && sudo -n true 2>/dev/null; then
+        exec sudo -E unshare --net "$0" --inside "$build_dir" "$(id -u)" "$(id -g)"
+    fi
+    echo "network namespaces are unavailable" >&2
+    exit 1
+fi
+
+build_dir=$2
+run_uid=${3-}
+run_gid=${4-}
+source_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
+test_dir=$build_dir/dlls/netprofm/tests
+if [ -f "$test_dir/netprofm_test.exe.so" ]; then
+    test_exes=$test_dir/netprofm_test.exe.so
+elif [ -f "$test_dir/netprofm_test.exe" ]; then
+    test_exes=$test_dir/netprofm_test.exe
+else
+    test_exes="$test_dir/x86_64-windows/netprofm_test.exe $test_dir/i386-windows/netprofm_test.exe"
+fi
+
+work_dir=$(mktemp -d /tmp/wine-netprofm-ipv6-XXXXXX)
+chmod 755 "$work_dir"
+prefix=$work_dir/prefix
+run_as_user()
+{
+    if [ -n "$run_uid" ]; then
+        run_home=$(getent passwd "$run_uid" | cut -d: -f6)
+        setpriv --reuid="$run_uid" --regid="$run_gid" --init-groups env HOME="$run_home" "$@"
+    else
+        "$@"
+    fi
+}
+
+cleanup()
+{
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -k 2>/dev/null || true
+    run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -w 2>/dev/null || true
+    rm -rf "$work_dir"
+}
+trap cleanup EXIT INT TERM
+
+# Fault only the Unix route source, not NSI, IP Helper, or NLM entry points.
+${CC:-cc} -shared -fPIC -Wall -Wextra -o "$work_dir/route-source.so" "$source_dir/nsi-backend.c" -ldl
+ip link set lo up
+ip link add nlm0 type dummy
+ip addr add 192.0.2.2/24 dev nlm0
+ip -6 addr add 2001:db8::2/64 dev nlm0 nodad
+ip link set nlm0 up
+ip route add default via 192.0.2.1 dev nlm0
+
+found=false
+for test_exe in $test_exes; do
+    [ -f "$test_exe" ] || continue
+    found=true
+    label=$(basename "$(dirname "$test_exe")")
+    for mode in unavailable empty read-error partial-read-error; do
+        mkdir "$prefix"
+        if [ -n "$run_uid" ]; then chown "$run_uid:$run_gid" "$prefix"; fi
+        echo "IPv6 route availability: $label $mode"
+        result=0
+        run_as_user env WINEPREFIX="$prefix" WINETEST_NETPROFM_IPV6_ROUTES="$mode" \
+            LD_PRELOAD="$work_dir/route-source.so" \
+            DBUS_SYSTEM_BUS_ADDRESS="unix:path=$work_dir/no-bus" \
+            "$build_dir/wine" "$test_exe" list >"$work_dir/test.log" 2>&1 || result=$?
+        cat "$work_dir/test.log"
+        run_as_user env WINEPREFIX="$prefix" "$build_dir/server/wineserver" -w
+        rm -rf "$prefix"
+        [ "$result" -eq 0 ] || exit "$result"
+    done
+done
+
+if [ "$found" = false ]; then
+    echo "could not find the netprofm test executable under $test_dir" >&2
+    exit 1
+fi
diff --git a/dlls/netprofm/tests/list.c b/dlls/netprofm/tests/list.c
index 12a54477f664..a340bea1153f 100644
