+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "private.h"
+#include "roapi.h"
+
+typedef struct ICoreApplicationPrivate ICoreApplicationPrivate;
+
+typedef struct ICoreApplicationPrivateVtbl
+{
+    HRESULT (WINAPI *QueryInterface)( ICoreApplicationPrivate *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( ICoreApplicationPrivate *iface );
+    ULONG (WINAPI *Release)( ICoreApplicationPrivate *iface );
+    HRESULT (WINAPI *GetIids)( ICoreApplicationPrivate *iface, ULONG *count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( ICoreApplicationPrivate *iface, HSTRING *name );
+    HRESULT (WINAPI *GetTrustLevel)( ICoreApplicationPrivate *iface, TrustLevel *level );
+    HRESULT (WINAPI *Reserved1)( ICoreApplicationPrivate *iface );
+    HRESULT (WINAPI *Reserved2)( ICoreApplicationPrivate *iface );
+    HRESULT (WINAPI *Reserved3)( ICoreApplicationPrivate *iface );
+    HRESULT (WINAPI *Reserved4)( ICoreApplicationPrivate *iface );
+    HRESULT (WINAPI *Reserved5)( ICoreApplicationPrivate *iface );
+    HRESULT (WINAPI *add_FinalUnhandledErrorDetected)( ICoreApplicationPrivate *iface,
+            IUnknown *handler, EventRegistrationToken *token );
+    HRESULT (WINAPI *remove_FinalUnhandledErrorDetected)( ICoreApplicationPrivate *iface,
+            EventRegistrationToken token );
+} ICoreApplicationPrivateVtbl;
+
+struct ICoreApplicationPrivate
+{
+    const ICoreApplicationPrivateVtbl *lpVtbl;
+};
+
+static const GUID IID_ICoreApplicationPrivate =
+    {0x17b0e613, 0x942a, 0x422d, {0x90, 0x4c, 0xf9, 0x0d, 0xc7, 0x1a, 0x7d, 0xae}};
+
+struct core_application_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ICoreApplication ICoreApplication_iface;
+    ICoreApplicationPrivate ICoreApplicationPrivate_iface;
+    LONG ref;
+    LONG event_token;
+    IUnknown *unhandled_error_handler;
+};
+
+static inline struct core_application_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct core_application_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct core_application_statics *impl = impl_from_IActivationFactory( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICoreApplication ))
+        *out = &impl->ICoreApplication_iface;
+    else if (IsEqualGUID( iid, &IID_ICoreApplicationPrivate ))
+        *out = &impl->ICoreApplicationPrivate_iface;
+    if (!*out) return E_NOINTERFACE;
+    IInspectable_AddRef( *out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    if (!name) return E_POINTER;
+    return WindowsCreateString( RuntimeClass_Windows_ApplicationModel_Core_CoreApplication,
+            ARRAY_SIZE(RuntimeClass_Windows_ApplicationModel_Core_CoreApplication) - 1, name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( core_application, ICoreApplication, struct core_application_statics,
+        IActivationFactory_iface )
+
+static HRESULT WINAPI core_application_get_Id( ICoreApplication *iface, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsCreateString( NULL, 0, value );
+}
+
+static HRESULT WINAPI core_application_add_Suspending( ICoreApplication *iface,
+        __FIEventHandler_1_Windows__CApplicationModel__CSuspendingEventArgs *handler,
+        EventRegistrationToken *token )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplication( iface );
+
+    if (!handler || !token) return E_INVALIDARG;
+    token->value = InterlockedIncrement( &impl->event_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI core_application_remove_Suspending( ICoreApplication *iface,
+        EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI core_application_add_Resuming( ICoreApplication *iface,
+        __FIEventHandler_1_IInspectable *handler, EventRegistrationToken *token )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplication( iface );
+
+    if (!handler || !token) return E_INVALIDARG;
+    token->value = InterlockedIncrement( &impl->event_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI core_application_remove_Resuming( ICoreApplication *iface,
+        EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI core_application_get_Properties( ICoreApplication *iface, IPropertySet **value )
+{
+    IInspectable *instance;
+    HSTRING class_name;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED( hr = WindowsCreateString( RuntimeClass_Windows_Foundation_Collections_PropertySet,
+            ARRAY_SIZE(RuntimeClass_Windows_Foundation_Collections_PropertySet) - 1, &class_name ) ))
+        return hr;
+    hr = RoActivateInstance( class_name, &instance );
+    WindowsDeleteString( class_name );
+    if (FAILED(hr)) return hr;
+    hr = IInspectable_QueryInterface( instance, &IID_IPropertySet, (void **)value );
+    IInspectable_Release( instance );
+    return hr;
+}
+
+static HRESULT WINAPI core_application_GetCurrentView( ICoreApplication *iface,
+        ICoreApplicationView **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI core_application_Run( ICoreApplication *iface, IFrameworkViewSource *view_source )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI core_application_RunWithActivationFactories( ICoreApplication *iface,
+        IGetActivationFactory *factory )
+{
+    return E_NOTIMPL;
+}
+
+static const ICoreApplicationVtbl core_application_vtbl =
+{
+    core_application_QueryInterface,
+    core_application_AddRef,
+    core_application_Release,
+    core_application_GetIids,
+    core_application_GetRuntimeClassName,
+    core_application_GetTrustLevel,
+    core_application_get_Id,
+    core_application_add_Suspending,
+    core_application_remove_Suspending,
+    core_application_add_Resuming,
+    core_application_remove_Resuming,
+    core_application_get_Properties,
+    core_application_GetCurrentView,
+    core_application_Run,
+    core_application_RunWithActivationFactories,
+};
+
+static inline struct core_application_statics *impl_from_ICoreApplicationPrivate(
+        ICoreApplicationPrivate *iface )
+{
+    return CONTAINING_RECORD( iface, struct core_application_statics, ICoreApplicationPrivate_iface );
+}
+
+static HRESULT WINAPI core_application_private_QueryInterface( ICoreApplicationPrivate *iface,
+        REFIID iid, void **out )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+
+    return factory_QueryInterface( &impl->IActivationFactory_iface, iid, out );
+}
+
+static ULONG WINAPI core_application_private_AddRef( ICoreApplicationPrivate *iface )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+
+    return factory_AddRef( &impl->IActivationFactory_iface );
+}
+
+static ULONG WINAPI core_application_private_Release( ICoreApplicationPrivate *iface )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+
+    return factory_Release( &impl->IActivationFactory_iface );
+}
+
+static HRESULT WINAPI core_application_private_GetIids( ICoreApplicationPrivate *iface,
+        ULONG *count, IID **iids )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+
+    return factory_GetIids( &impl->IActivationFactory_iface, count, iids );
+}
+
+static HRESULT WINAPI core_application_private_GetRuntimeClassName(
+        ICoreApplicationPrivate *iface, HSTRING *name )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+
+    return factory_GetRuntimeClassName( &impl->IActivationFactory_iface, name );
+}
+
+static HRESULT WINAPI core_application_private_GetTrustLevel( ICoreApplicationPrivate *iface,
+        TrustLevel *level )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+
+    return factory_GetTrustLevel( &impl->IActivationFactory_iface, level );
+}
+
+static HRESULT WINAPI core_application_private_Reserved( ICoreApplicationPrivate *iface )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI core_application_private_add_FinalUnhandledErrorDetected(
+        ICoreApplicationPrivate *iface, IUnknown *handler, EventRegistrationToken *token )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+    IUnknown *previous;
+
+    if (!handler || !token) return E_INVALIDARG;
+    IUnknown_AddRef( handler );
+    previous = InterlockedExchangePointer( (void **)&impl->unhandled_error_handler, handler );
+    if (previous) IUnknown_Release( previous );
+    token->value = InterlockedIncrement( &impl->event_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI core_application_private_remove_FinalUnhandledErrorDetected(
+        ICoreApplicationPrivate *iface, EventRegistrationToken token )
+{
+    struct core_application_statics *impl = impl_from_ICoreApplicationPrivate( iface );
+    IUnknown *handler;
+
+    handler = InterlockedExchangePointer( (void **)&impl->unhandled_error_handler, NULL );
+    if (handler) IUnknown_Release( handler );
+    return S_OK;
+}
+
+static const ICoreApplicationPrivateVtbl core_application_private_vtbl =
+{
+    core_application_private_QueryInterface,
+    core_application_private_AddRef,
+    core_application_private_Release,
+    core_application_private_GetIids,
+    core_application_private_GetRuntimeClassName,
+    core_application_private_GetTrustLevel,
+    core_application_private_Reserved,
+    core_application_private_Reserved,
+    core_application_private_Reserved,
+    core_application_private_Reserved,
+    core_application_private_Reserved,
+    core_application_private_add_FinalUnhandledErrorDetected,
+    core_application_private_remove_FinalUnhandledErrorDetected,
+};
+
+static struct core_application_statics core_application_statics =
+{
+    {&factory_vtbl},
+    {&core_application_vtbl},
+    {&core_application_private_vtbl},
+    1,
+};
+
+IActivationFactory *core_application_factory = &core_application_statics.IActivationFactory_iface;
--- a/dlls/windows.applicationmodel/main.c
