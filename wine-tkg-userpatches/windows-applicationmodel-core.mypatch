         IActivationFactory_QueryInterface( design_mode_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( buffer, RuntimeClass_Windows_ApplicationModel_LimitedAccessFeatures ))
         IActivationFactory_QueryInterface( limited_access_features_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( buffer, RuntimeClass_Windows_ApplicationModel_Core_CoreApplication ))
+        IActivationFactory_QueryInterface( core_application_factory, &IID_IActivationFactory, (void **)factory );
 
     if (*factory) return S_OK;
     return CLASS_E_CLASSNOTAVAILABLE;
--- a/dlls/windows.applicationmodel/private.h
+++ b/dlls/windows.applicationmodel/private.h
@@ -33,12 +33,14 @@
 #define WIDL_using_Windows_Foundation_Collections
 #include "windows.foundation.h"
 #define WIDL_using_Windows_ApplicationModel
+#define WIDL_using_Windows_ApplicationModel_Core
 #define WIDL_using_Windows_Storage
 #include "windows.applicationmodel.h"
 
 extern IActivationFactory *package_factory;
 extern IActivationFactory *design_mode_factory;
