+static BOOL is_layered_child_visible( HWND hwnd )
+{
+    for (; hwnd && hwnd != NtUserGetDesktopWindow(); hwnd = NtUserGetAncestor( hwnd, GA_PARENT ))
+        if ((NtUserGetWindowLongW( hwnd, GWL_STYLE ) & (WS_VISIBLE | WS_MINIMIZE)) != WS_VISIBLE) return FALSE;
+    return TRUE;
+}
+
+static void sync_layered_child( HWND hwnd, BOOL repaint )
+{
+    struct x11drv_win_data *data = get_win_data( hwnd );
+    DWORD style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+    BOOL expose = FALSE, remap = FALSE;
+
+    if (data && data->whole_window && data->layered)
+    {
+        if (!(expose = is_layered_child_visible( hwnd ))) style &= ~WS_VISIBLE;
+        remap = expose && data->pending_state.wm_state == WithdrawnState;
+        sync_window_position( data, SWP_NOACTIVATE | SWP_NOZORDER, &data->rects );
+        sync_layered_child_shape( data );
+        window_set_wm_state( data, get_desired_wm_state( style, &data->rects ), FALSE );
+        XFlush( gdi_display );
+        if (remap) XSync( data->display, False );
+        else XFlush( data->display );
+    }
+    release_win_data( data );
+
+    if (expose && (repaint || remap))
+    {
+        send_message( hwnd, WM_WINE_UPDATEWINDOWSTATE, 0, 0 );
+        NtUserExposeWindowSurface( hwnd, 0, NULL, NtUserGetWinMonitorDpi( hwnd, MDT_WINE_RAW_DPI ) );
+    }
+}
+
+static BOOL sync_layered_child_positions( HWND parent, BOOL repaint )
+{
+    BOOL layered = FALSE;
+    HWND child;
+
+    for (child = NtUserGetWindowRelative( parent, GW_CHILD ); child;
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+    {
+        if (NtUserGetWindowLongW( child, GWL_EXSTYLE ) & WS_EX_LAYERED)
+        {
+            layered = TRUE;
+            if (NtUserGetWindowThread( child, NULL ) == GetCurrentThreadId()) sync_layered_child( child, repaint );
+            else NtUserPostMessage( child, WM_X11DRV_SYNC_LAYERED_CHILD, repaint, 0 );
+        }
+        layered |= sync_layered_child_positions( child, repaint );
+    }
+    return layered;
+}
+
+static Window get_layered_stack_window( Display *display, HWND hwnd )
+{
+    Window window = None, root, parent, *children;
+    unsigned int count;
+    BOOL success;
+
+    while (hwnd && hwnd != NtUserGetDesktopWindow() && !(window = X11DRV_get_whole_window( hwnd )))
+        hwnd = NtUserGetAncestor( hwnd, GA_PARENT );
+    while (window && window != root_window)
+    {
+        children = NULL;
+        X11DRV_expect_error( display, host_window_error, NULL );
+        success = XQueryTree( display, window, &root, &parent, &children, &count );
+        if (children) XFree( children );
+        if (X11DRV_check_error() || !success) return None;
+        if (parent == root_window || parent == root) return window;
+        window = parent;
+    }
+    return None;
+}
+
+static void restack_layered_children( Display *display, HWND parent, Window anchor )
+{
+    HWND child;
+
+    for (child = NtUserGetWindowRelative( parent, GW_CHILD ); child;
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+    {
+        Window window = None;
+
+        if (!is_layered_child_visible( child )) continue;
+        if ((NtUserGetWindowLongW( child, GWL_EXSTYLE ) & WS_EX_LAYERED) &&
+            (window = X11DRV_get_whole_window( child )) && window != anchor)
+        {
+            XWindowChanges changes = { .sibling = anchor, .stack_mode = Above };
+
+            /* Insert each subtree above its parent, below earlier siblings. */
+            XConfigureWindow( display, window, CWSibling | CWStackMode, &changes );
+        }
+        restack_layered_children( display, child, window ? window : anchor );
+    }
+}
+
+static void sync_layered_children( HWND parent, BOOL repaint )
+{
+    Display *display = x11drv_thread_data()->display;
+    Window anchor;
+
+    if (!sync_layered_child_positions( parent, repaint )) return;
+    if (!is_layered_child_visible( parent )) return;
+    if (!(anchor = get_layered_stack_window( display, parent ))) return;
+    X11DRV_expect_error( display, host_window_error, NULL );
+    restack_layered_children( display, parent, anchor );
+    if (X11DRV_check_error()) TRACE( "Layered child disappeared during restacking\n" );
+    XFlush( display );
+}
+
+
