+static void sync_layered_child_shape( struct x11drv_win_data *data )
+{
+#ifdef HAVE_LIBXSHAPE
+    HWND parent = NtUserGetAncestor( data->hwnd, GA_PARENT );
+    UINT dpi = NtUserGetWinMonitorDpi( data->hwnd, MDT_RAW_DPI );
+    RECT bounds = data->rects.visible, rect;
+    RGNDATA *region_data;
+    HRGN region;
+
+    if (!parent || parent == NtUserGetDesktopWindow()) return;
+    OffsetRect( &bounds, -bounds.left, -bounds.top );
+    while (parent && parent != NtUserGetDesktopWindow())
+    {
+        if (!NtUserGetClientRect( parent, &rect, dpi )) return;
+        NtUserMapWindowPoints( parent, data->hwnd, (POINT *)&rect, 2, dpi );
+        OffsetRect( &rect, data->rects.client.left - data->rects.visible.left,
+                    data->rects.client.top - data->rects.visible.top );
+        if (!intersect_rect( &bounds, &bounds, &rect ))
+        {
+            SetRect( &bounds, 0, 0, 0, 0 );
+            break;
+        }
+        parent = NtUserGetAncestor( parent, GA_PARENT );
+    }
+    if (!(region = NtGdiCreateRectRgn( bounds.left, bounds.top, bounds.right, bounds.bottom ))) return;
+    if ((region_data = X11DRV_GetRegionData( region, 0 )))
+    {
+        XShapeCombineMask( gdi_display, data->whole_window, ShapeBounding,
+                           data->surface_shape_offset.x, data->surface_shape_offset.y, data->surface_shape, ShapeSet );
+        XShapeCombineRectangles( gdi_display, data->whole_window, ShapeBounding, 0, 0,
+                                 (XRectangle *)region_data->Buffer, region_data->rdh.nCount, ShapeIntersect, YXBanded );
+        free( region_data );
+    }
+    NtGdiDeleteObjectApp( region );
+#endif
+}
+
+void set_window_surface_shape( HWND hwnd, Window window, Pixmap shape, int x, int y )
+{
+#ifdef HAVE_LIBXSHAPE
+    struct x11drv_win_data *data = get_win_data( hwnd );
+    HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
+
+    if (data && data->whole_window == window && parent && parent != NtUserGetDesktopWindow())
+    {
+        if (data->surface_shape) XFreePixmap( gdi_display, data->surface_shape );
+        data->surface_shape = shape;
+        data->surface_shape_offset.x = x;
+        data->surface_shape_offset.y = y;
+        sync_layered_child_shape( data );
+        release_win_data( data );
+        return;
+    }
+    release_win_data( data );
+    XShapeCombineMask( gdi_display, window, ShapeBounding, x, y, shape, ShapeSet );
+    if (shape) XFreePixmap( gdi_display, shape );
+#endif
+}
+
+
