diff --git i/dlls/netprofm/tests/monitor-faults.c w/dlls/netprofm/tests/monitor-faults.c
index de9325e..c867bd4 100644
--- i/dlls/netprofm/tests/monitor-faults.c
+++ w/dlls/netprofm/tests/monitor-faults.c
@@ -588,11 +588,12 @@ static void run_nsi_faults(void)
     HRESULT hr;
     DWORD ret, bytes, expected_error;
     unsigned int i;
-    BOOL control;
+    BOOL control, overflow;
 
     GetEnvironmentVariableA( "WINETEST_NSI_DIR", directory, sizeof(directory) );
     GetEnvironmentVariableA( "WINETEST_NSI_FAULT", mode, sizeof(mode) );
     control = !strcmp( mode, "control" );
+    overflow = !strcmp( mode, "overflow" );
     expected_error = ERROR_GEN_FAILURE;
     expected = !strcmp( mode, "retained" ) ?
         NLM_CONNECTIVITY_IPV4_LOCALNETWORK | NLM_CONNECTIVITY_IPV6_INTERNET : NLM_CONNECTIVITY_DISCONNECTED;
@@ -666,10 +667,10 @@ static void run_nsi_faults(void)
     wait_marker( "changed" );
     ret = WaitForSingleObject( closed.hEvent, 10000 );
     ok( ret == WAIT_OBJECT_0, "closed file request stranded: %lu\n", ret );
-    ok( (NTSTATUS)closed.Internal == (control ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL),
+    ok( (NTSTATUS)closed.Internal == ((control || overflow) ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL),
         "closed file completion %#lx\n", (NTSTATUS)closed.Internal );
     CloseHandle( closed.hEvent );
-    if (!control)
+    if (!control && !overflow)
     {
         ret = WaitForSingleObject( mgr->worker, 10000 );
         ok( ret == WAIT_OBJECT_0, "monitor did not exit: %lu\n", ret );
@@ -680,7 +681,7 @@ static void run_nsi_faults(void)
         ret = WaitForSingleObject( pending[i].hEvent, 10000 );
         ok( ret == WAIT_OBJECT_0, "pending %u was stranded: %lu\n", i, ret );
         ret = GetOverlappedResult( handles[i], pending + i, &bytes, FALSE );
-        ok( control ? ret : !ret && GetLastError() == expected_error,
+        ok( (control || overflow) ? ret : !ret && GetLastError() == expected_error,
             "completion %u: %lu/%lu\n", i, ret, GetLastError() );
     }
     for (i = 0; i < 1000; i++)
@@ -690,16 +691,16 @@ static void run_nsi_faults(void)
         Sleep( 10 );
     }
     ok( value == expected, "final connectivity %#x, expected %#x\n", value, expected );
-    ok( mgr->dynamic_topology == control, "final dynamic policy %u\n", mgr->dynamic_topology );
+    ok( mgr->dynamic_topology == (control || overflow), "final dynamic policy %u\n", mgr->dynamic_topology );
     trace( "%s: final connectivity %#x, dynamic %u\n", mode, value, mgr->dynamic_topology );
     release_manager( iface );
     iface = NULL;
-    /* A terminal error is sticky, even after the socket fault is removed. */
+    /* A terminal error is sticky, but a netlink overflow re-synchronizes. */
     for (i = 0; i < ARRAY_SIZE(pending); i++)
     {
         ResetEvent( pending[i].hEvent );
         ret = NsiRequestChangeNotification( 0, &npi_ndis_module, NSI_NDIS_IFINFO_TABLE, pending + i, handles + i );
-        ok( control ? ret == ERROR_IO_PENDING : ret == expected_error,
+        ok( (control || overflow) ? ret == ERROR_IO_PENDING : ret == expected_error,
             "future subscription %u: %lu\n", i, ret );
         if (ret == ERROR_IO_PENDING)
         {
@@ -710,11 +711,11 @@ static void run_nsi_faults(void)
     }
     other = NULL;
     hr = list_manager_create( (void **)&other );
-    ok( hr == S_OK && other && impl_from_INetworkListManager( other )->dynamic_topology == control,
+    ok( hr == S_OK && other && impl_from_INetworkListManager( other )->dynamic_topology == (control || overflow),
         "future manager create %#lx\n", hr );
     if (other)
     {
-        if (control) release_manager( other );
+        if (control || overflow) release_manager( other );
         else INetworkListManager_Release( other );
     }
 done:
diff --git i/dlls/netprofm/tests/nsi-backend.c w/dlls/netprofm/tests/nsi-backend.c
index f0e91e4..c6eee9d 100644
--- i/dlls/netprofm/tests/nsi-backend.c
+++ w/dlls/netprofm/tests/nsi-backend.c
@@ -15,6 +15,7 @@
 #include <linux/netlink.h>
 
 static int notification_fd = -1;
+static int overflow_injected;
 
 static void marker( const char *name )
 {
@@ -72,8 +73,17 @@ static ssize_t fault_recv( int fd, void *buffer, size_t len, int flags )
     if (fd == notification_fd)
     {
         marker( "polling" );
+        if (!strcmp( getenv( "WINETEST_NSI_FAULT" ), "overflow" ) && !overflow_injected)
+        {
+            overflow_injected = 1;
+            wait_fault();
+            marker( "injected" );
+            errno = ENOBUFS;
+            return -1;
+        }
         if (strcmp( getenv( "WINETEST_NSI_FAULT" ), "control" ) &&
-            strcmp( getenv( "WINETEST_NSI_FAULT" ), "startup" ))
+            strcmp( getenv( "WINETEST_NSI_FAULT" ), "startup" ) &&
+            strcmp( getenv( "WINETEST_NSI_FAULT" ), "overflow" ))
         {
             wait_fault();
             marker( "injected" );
diff --git i/dlls/netprofm/tests/nsi-faults.sh w/dlls/netprofm/tests/nsi-faults.sh
index d2c7218..6303e2a 100755
--- i/dlls/netprofm/tests/nsi-faults.sh
