diff --git i/dlls/nsiproxy.sys/nsi.c w/dlls/nsiproxy.sys/nsi.c
index cac8388..47a3f9c 100644
--- i/dlls/nsiproxy.sys/nsi.c
+++ w/dlls/nsiproxy.sys/nsi.c
@@ -221,6 +221,31 @@ static NTSTATUS add_notification( const NPI_MODULEID *module, UINT32 table )
 }
 
 #if defined(HAVE_LINUX_RTNETLINK_H)
+/* An overflow means one or more multicast changes were lost. Re-subscribe
+ * before publishing a synthetic change for every table used by NLM, so each
+ * client takes a fresh snapshot instead of keeping stale connectivity. */
+static NTSTATUS queue_topology_resync(void)
+{
+    NTSTATUS status;
+
+    if ((status = add_notification( &NPI_MS_NDIS_MODULEID, NSI_NDIS_IFINFO_TABLE ))) return status;
+    if ((status = add_notification( &NPI_MS_IPV4_MODULEID, NSI_IP_UNICAST_TABLE ))) return status;
+    if ((status = add_notification( &NPI_MS_IPV6_MODULEID, NSI_IP_UNICAST_TABLE ))) return status;
+    if ((status = add_notification( &NPI_MS_IPV4_MODULEID, NSI_IP_FORWARD_TABLE ))) return status;
+    return add_notification( &NPI_MS_IPV6_MODULEID, NSI_IP_FORWARD_TABLE );
+}
+
+static NTSTATUS recover_netlink_overflow(void)
+{
+    NTSTATUS status;
+
+    WARN( "netlink notification overflow; re-subscribing and re-synchronizing.\n" );
+    close( netlink_fd );
+    netlink_fd = -1;
+    if ((status = unix_nsi_init_notification( NULL ))) return status;
+    return queue_topology_resync();
+}
+
 static NTSTATUS poll_events(void)
 {
     char initial_buffer[PIPE_BUF], *buffer = initial_buffer;
@@ -240,6 +265,11 @@ static NTSTATUS poll_events(void)
         if (len <= 0)
         {
             if (len == -1 && errno == EINTR) continue;
+            if (len == -1 && errno == ENOBUFS)
+            {
+                status = recover_netlink_overflow();
+                goto done;
+            }
             ERR( "error receivng, len %d, errno %d.\n", len, errno );
             status = STATUS_UNSUCCESSFUL;
             goto failed;
@@ -259,6 +289,11 @@ static NTSTATUS poll_events(void)
         if (len <= 0 || len > buffer_size)
         {
             if (len == -1 && errno == EINTR) continue;
+            if (len == -1 && errno == ENOBUFS)
+            {
+                status = recover_netlink_overflow();
+                goto done;
+            }
             ERR( "incomplete netlink datagram, len %d, buffer size %zu, errno %d.\n",
                  len, buffer_size, errno );
             status = STATUS_UNSUCCESSFUL;
@@ -267,6 +302,11 @@ static NTSTATUS poll_events(void)
         for (nlh = (struct nlmsghdr *)buffer; NLMSG_OK(nlh, len); nlh = NLMSG_NEXT(nlh, len))
         {
             if (nlh->nlmsg_type == NLMSG_DONE) break;
+            if (nlh->nlmsg_type == NLMSG_OVERRUN)
+            {
+                status = recover_netlink_overflow();
+                goto done;
+            }
             if (nlh->nlmsg_type == RTM_NEWADDR || nlh->nlmsg_type == RTM_DELADDR)
             {
                 struct ifaddrmsg *addrmsg = (struct ifaddrmsg *)(nlh + 1);
