+    }
     *result = &impl->IDispatcherQueue_iface;
     TRACE( "created queue %p for thread %lu.\n", *result, impl->thread_id );
     return S_OK;
+
+failed:
+    hr = HRESULT_FROM_WIN32( GetLastError() );
+    IDispatcherQueue_Release( &impl->IDispatcherQueue_iface );
+    return hr;
 }
 
