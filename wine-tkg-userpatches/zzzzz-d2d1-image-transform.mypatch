 HRESULT d2d_command_list_replay(ID2D1CommandList *iface, ID2D1DeviceContext *context)
 {
     struct d2d_command_list *command_list = impl_from_ID2D1CommandList(iface);
+    ID2D1DrawingStateBlock *state;
