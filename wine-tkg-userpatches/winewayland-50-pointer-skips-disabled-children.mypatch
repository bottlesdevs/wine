@@ -321,7 +330,7 @@

     TRACE("hwnd=%p axis=%u discrete=%d\n", hwnd, axis, discrete);

-    NtUserSendHardwareInput(hwnd, 0, &input, 0);
+    NtUserSendHardwareInput(get_input_hwnd(hwnd), 0, &input, 0);
 }

