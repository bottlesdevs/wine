     ID2D1Device *device;
     ID2D1DeviceContext *context;
@@ -10843,6 +10855,7 @@
         if (impl->context) ID2D1DeviceContext_Release( impl->context );
         ID2D1Device_Release( impl->device );
         ICompositor_Release( impl->compositor );
