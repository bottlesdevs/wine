+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->lpVtbl = &string_pair_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = WindowsDuplicateString( entry->key, &impl->key )) ||
+        FAILED(hr = WindowsDuplicateString( entry->value, &impl->value )))
