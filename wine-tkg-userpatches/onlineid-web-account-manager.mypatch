+static bool valid_aad_client_id(const std::string &value)
+{
+    if (value.size() != 36) return false;
+    for (size_t i = 0; i < value.size(); ++i)
+    {
+        if (i == 8 || i == 13 || i == 18 || i == 23)
+        {
+            if (value[i] != '-') return false;
+        }
+        else if (!std::isxdigit((unsigned char)value[i])) return false;
+    }
+    return true;
+}
+
+static bool ascii_case_equal(const std::string &left, const std::string &right)
+{
+    if (left.size() != right.size()) return false;
+    for (size_t i = 0; i < left.size(); ++i)
+        if (std::tolower((unsigned char)left[i]) != std::tolower((unsigned char)right[i]))
+            return false;
+    return true;
+}
+
+static bool valid_resource_request(const std::string &requested_client_id,
+                                   const std::string &requested_redirect_uri)
+{
+    static const std::string prefix = "ms-appx-web://Microsoft.AAD.BrokerPlugin/";
+
+    return valid_aad_client_id(requested_client_id) &&
+           ascii_case_equal(requested_redirect_uri, prefix + requested_client_id);
+}
