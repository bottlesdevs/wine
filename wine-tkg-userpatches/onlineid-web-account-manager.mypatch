+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->lpVtbl = &string_iterator_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = string_entries_copy( impl->entries, entries, size )))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->size = size;
+    *out = impl;
+    TRACE( "created iterator %p with %u entries.\n", impl, size );
+    return S_OK;
+}
