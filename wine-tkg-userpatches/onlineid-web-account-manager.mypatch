     if (!wcscmp( buffer, RuntimeClass_Windows_Security_Authentication_OnlineId_OnlineIdServiceTicketRequest ))
         IActivationFactory_QueryInterface( ticket_factory, &IID_IActivationFactory, (void **)factory );
