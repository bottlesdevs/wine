diff --git a/dlls/windows.security.authentication.onlineid/ticket.c b/dlls/windows.security.authentication.onlineid/ticket.c
index c162f5dfe5c..8b15d343f7a 100644
--- a/dlls/windows.security.authentication.onlineid/ticket.c
