+    impl->lpVtbl = &provider_error_vtbl;
+    impl->ref = 1;
+    impl->code = code;
+    if (FAILED(hr = WindowsCreateString( message, wcslen( message ), &impl->message )) ||
+        FAILED(hr = string_map_create( &impl->properties )))
