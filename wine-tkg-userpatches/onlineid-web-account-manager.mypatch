+static HRESULT WINAPI result_get_ResponseStatus( IWebTokenRequestResult *iface, WebTokenRequestStatus *value )
+{
+    if (!value) return E_POINTER;
+    *value = result_from_IWebTokenRequestResult( iface )->status;
+    return S_OK;
+}
