+MODULE    = wine4officeauth.exe
+IMPORTS   = $(CXX_PE_LIBS) uuid urlmon winhttp wininet crypt32 bcrypt shell32 oleaut32 ole32 user32
+
+EXTRADLLFLAGS = -mwindows -municode
+
+SOURCES = \
+	wine4officeauth.cpp
diff --git a/programs/wine4officeauth/wine4officeauth.cpp b/programs/wine4officeauth/wine4officeauth.cpp
new file mode 100644
index 00000000000..5e56ec1febe
--- /dev/null
+++ b/programs/wine4officeauth/wine4officeauth.cpp
@@ -0,0 +1,2767 @@
+/*
+ * Wine4Office organizational OAuth helper.
+ *
+ * Hosts Microsoft authentication in an owner-window MSHTML control inside the
+ * Wine prefix, exchanges the public-client PKCE code, and stores each account's
+ * versioned WAM bundle with DPAPI.  It never opens the host browser.
+ */
+#include <windows.h>
+extern "C"
+{
+#include <bcrypt.h>
+}
+#include <cryptuiapi.h>
+#include <exdisp.h>
+#include <mshtml.h>
+#include <mshtmhst.h>
+#include <ole2.h>
+#include <oleidl.h>
+#include <ocidl.h>
+#include <shellapi.h>
+#include <shlobj.h>
+#include <urlmon.h>
+#include <winhttp.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+extern "C" HINTERNET WINAPI InternetOpenW(const WCHAR *, DWORD, const WCHAR *, const WCHAR *, DWORD);
+extern "C" HINTERNET WINAPI InternetConnectW(HINTERNET, const WCHAR *, INTERNET_PORT,
+                                               const WCHAR *, const WCHAR *, DWORD, DWORD, DWORD_PTR);
+extern "C" HINTERNET WINAPI HttpOpenRequestW(HINTERNET, const WCHAR *, const WCHAR *, const WCHAR *,
+                                               const WCHAR *, const WCHAR *const *, DWORD, DWORD_PTR);
+extern "C" BOOL WINAPI HttpSendRequestW(HINTERNET, const WCHAR *, DWORD, void *, DWORD);
+extern "C" BOOL WINAPI HttpQueryInfoW(HINTERNET, DWORD, void *, DWORD *, DWORD *);
