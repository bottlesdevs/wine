+static BOOL test_write_scoped_fixture( const WCHAR *client_id, const WCHAR *scope,
+                                       const char *token )
+{
+    WCHAR access_path[64], id_path[64];
+    char value[192];
+    FILETIME time;
+    DWORD expires;
+
+    GetSystemTimeAsFileTime( &time );
+    expires = (DWORD)((((ULONGLONG)time.dwHighDateTime << 32) | time.dwLowDateTime) /
+                      10000000 - 11644473600ULL + 600);
+    snprintf( value, ARRAY_SIZE(value), "%lu|%s", (unsigned long)expires, token );
+    return test_scoped_token_path( access_path, client_id, scope, FALSE ) &&
+           test_scoped_token_path( id_path, client_id, scope, TRUE ) &&
+           test_write_file( access_path, value ) &&
+           test_write_file( id_path, "plan01-scoped-id-token" );
+}
