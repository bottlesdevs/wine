diff --git a/dlls/windows.security.authentication.onlineid/unixlib.c b/dlls/windows.security.authentication.onlineid/unixlib.c
new file mode 100644
index 000000000..7c4e51b4b
--- /dev/null
+++ b/dlls/windows.security.authentication.onlineid/unixlib.c
@@ -0,0 +1,180 @@
+/* Host identity bridge Unix interface
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "unixlib.h"
+
+static NTSTATUS errno_status( int error )
+{
+    switch (error)
+    {
+    case ENOENT: return STATUS_OBJECT_NAME_NOT_FOUND;
+    case EACCES: return STATUS_ACCESS_DENIED;
+    case ECONNREFUSED: return STATUS_CONNECTION_REFUSED;
+    case ETIMEDOUT: return STATUS_IO_TIMEOUT;
+    case ENOMEM: return STATUS_NO_MEMORY;
+    default: return STATUS_UNSUCCESSFUL;
+    }
+}
+
+static LONGLONG monotonic_ms(void)
+{
+    struct timespec now;
+    clock_gettime( CLOCK_MONOTONIC, &now );
+    return (LONGLONG)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static NTSTATUS wait_ready( int fd, short events, HANDLE cancel, LONGLONG deadline )
+{
+    struct pollfd descriptor = {fd, events, 0};
+    LARGE_INTEGER timeout = {0};
+    int result;
+
+    for (;;)
+    {
+        if (cancel && NtWaitForSingleObject( cancel, FALSE, &timeout ) == STATUS_SUCCESS) return STATUS_CANCELLED;
+        if (monotonic_ms() >= deadline) return STATUS_IO_TIMEOUT;
+        if ((result = poll( &descriptor, 1, 100 )) > 0) return STATUS_SUCCESS;
+        if (result < 0 && errno != EINTR) return errno_status( errno );
+    }
+}
+
+static NTSTATUS write_all( int fd, const void *data, size_t size, HANDLE cancel, LONGLONG deadline )
+{
+    const char *cursor = data;
+    ssize_t count;
+    NTSTATUS status;
+
+    while (size)
+    {
+        if ((status = wait_ready( fd, POLLOUT, cancel, deadline ))) return status;
+        if ((count = send( fd, cursor, size, MSG_NOSIGNAL )) < 0)
+        {
+            if (errno == EINTR || errno == EAGAIN) continue;
+            return errno_status( errno );
+        }
+        if (!count) return STATUS_PIPE_BROKEN;
+        cursor += count;
+        size -= count;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS read_all( int fd, void *data, size_t size, HANDLE cancel, LONGLONG deadline )
+{
+    char *cursor = data;
+    ssize_t count;
+    NTSTATUS status;
+
+    while (size)
+    {
+        if ((status = wait_ready( fd, POLLIN, cancel, deadline ))) return status;
+        if ((count = read( fd, cursor, size )) < 0)
+        {
+            if (errno == EINTR || errno == EAGAIN) continue;
+            return errno_status( errno );
+        }
+        if (!count) return STATUS_PIPE_BROKEN;
+        cursor += count;
+        size -= count;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS exchange( void *args )
+{
+    struct exchange_params *params = args;
+    const char *socket_path = getenv( "SODA_IDENTITY_BRIDGE_SOCKET" );
+    struct sockaddr_un address = {0};
+    unsigned char *request = (void *)(uintptr_t)params->request;
+    unsigned char *response = (void *)(uintptr_t)params->response;
+    uint32_t payload_size;
+    HANDLE cancel = (HANDLE)(uintptr_t)params->cancel;
+    LONGLONG deadline = monotonic_ms() + 620000;
+    NTSTATUS status;
+    size_t path_length;
+    int fd = -1;
+
+    params->response_size = 0;
+    if (!socket_path || !*socket_path) return STATUS_OBJECT_NAME_NOT_FOUND;
+    path_length = strlen( socket_path );
+    if (path_length >= sizeof(address.sun_path)) return STATUS_NAME_TOO_LONG;
+    if (!request || !response || params->request_size < 20 || params->response_capacity < 20)
+        return STATUS_INVALID_PARAMETER;
+    if ((fd = socket( AF_UNIX, SOCK_STREAM, 0 )) < 0) return errno_status( errno );
+    address.sun_family = AF_UNIX;
+    memcpy( address.sun_path, socket_path, path_length + 1 );
+    if (fcntl( fd, F_SETFL, O_NONBLOCK ) < 0)
+    {
+        status = errno_status( errno );
+        goto done;
+    }
+    if (connect( fd, (struct sockaddr *)&address, offsetof(struct sockaddr_un, sun_path) + path_length + 1 ) < 0)
+    {
+        int error = 0;
+        socklen_t size = sizeof(error);
+        if (errno != EINPROGRESS)
+        {
+            status = errno_status( errno );
+            goto done;
+        }
+        if ((status = wait_ready( fd, POLLOUT, cancel, deadline ))) goto done;
+        if (getsockopt( fd, SOL_SOCKET, SO_ERROR, &error, &size ) < 0 || error)
+        {
+            status = errno_status( error ? error : errno );
+            goto done;
+        }
+    }
+    if ((status = write_all( fd, request, params->request_size, cancel, deadline ))) goto done;
+    if ((status = read_all( fd, response, 20, cancel, deadline ))) goto done;
+    memcpy( &payload_size, response + 12, sizeof(payload_size) );
+    if (payload_size > params->response_capacity - 20)
+    {
+        status = STATUS_BUFFER_TOO_SMALL;
+        goto done;
+    }
+    if ((status = read_all( fd, response + 20, payload_size, cancel, deadline ))) goto done;
+    params->response_size = 20 + payload_size;
+    status = STATUS_SUCCESS;
+
+done:
+    close( fd );
+    return status;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    exchange,
+    credentials,
+};
+
+C_ASSERT( ARRAY_SIZE(__wine_unix_call_funcs) == unix_funcs_count );
diff --git a/dlls/windows.security.authentication.onlineid/unixlib.h b/dlls/windows.security.authentication.onlineid/unixlib.h
new file mode 100644
index 000000000..d54996dd2
--- /dev/null
+++ b/dlls/windows.security.authentication.onlineid/unixlib.h
@@ -0,0 +1,49 @@
+/* Host identity bridge Unix interface
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "wine/unixlib.h"
+
+enum onlineid_unix_funcs
+{
+    unix_exchange,
+    unix_credentials,
+    unix_funcs_count,
+};
+
+struct exchange_params
+{
+    UINT64 request;
+    UINT64 response;
+    UINT64 cancel;
+    UINT32 request_size;
+    UINT32 response_capacity;
+    UINT32 response_size;
+    UINT32 reserved;
+};
+
+enum credential_operation
+{
+    credential_lookup,
+    credential_store,
+    credential_clear,
+    credential_list,
+};
+
+struct credential_params
+{
+    UINT64 data;
+    UINT32 capacity;
+    UINT32 size;
+    UINT32 operation;
+    char client_id[37];
+    char authority[37];
+};
+
+extern NTSTATUS credentials( void *args );
diff --git a/dlls/windows.security.authentication.onlineid/web_account.c b/dlls/windows.security.authentication.onlineid/web_account.c
new file mode 100644
index 000000000..d01333ecc
--- /dev/null
+++ b/dlls/windows.security.authentication.onlineid/web_account.c
@@ -0,0 +1,637 @@
+/*
+ * WinRT web accounts
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "private.h"
+
+struct web_account_provider
+{
+    IWebAccountProvider IWebAccountProvider_iface;
+    IWebAccountProvider2 IWebAccountProvider2_iface;
+    IWebAccountProvider3 IWebAccountProvider3_iface;
+    IWebAccountProvider4 IWebAccountProvider4_iface;
+    LONG ref;
+    HSTRING id;
+    HSTRING display_name;
+    HSTRING display_purpose;
+    HSTRING authority;
+    boolean system_provider;
+};
+
+struct web_account
+{
+    IWebAccount IWebAccount_iface;
+    IWebAccount2 IWebAccount2_iface;
+    LONG ref;
+    IWebAccountProvider *provider;
+    HSTRING id;
+    HSTRING username;
+    WebAccountState state;
+    IMap_HSTRING_HSTRING *properties;
+};
+
+struct account_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IWebAccountFactory IWebAccountFactory_iface;
+    LONG ref;
+};
+
+struct provider_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IWebAccountProviderFactory IWebAccountProviderFactory_iface;
+    LONG ref;
+};
+
+static inline struct web_account_provider *provider_from_IWebAccountProvider( IWebAccountProvider *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_account_provider, IWebAccountProvider_iface );
+}
+
+static inline struct web_account_provider *provider_from_IWebAccountProvider2( IWebAccountProvider2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_account_provider, IWebAccountProvider2_iface );
+}
+
+static inline struct web_account_provider *provider_from_IWebAccountProvider3( IWebAccountProvider3 *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_account_provider, IWebAccountProvider3_iface );
+}
+
+static inline struct web_account_provider *provider_from_IWebAccountProvider4( IWebAccountProvider4 *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_account_provider, IWebAccountProvider4_iface );
+}
+
+static HRESULT provider_query_interface( struct web_account_provider *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IWebAccountProvider ))
+        *out = &impl->IWebAccountProvider_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAccountProvider2 ))
+        *out = &impl->IWebAccountProvider2_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAccountProvider3 ))
+        *out = &impl->IWebAccountProvider3_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAccountProvider4 ))
+        *out = &impl->IWebAccountProvider4_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG provider_release( struct web_account_provider *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->id );
+        WindowsDeleteString( impl->display_name );
+        WindowsDeleteString( impl->display_purpose );
+        WindowsDeleteString( impl->authority );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT provider_get_iids( ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 4;
+    if (!(*iids = CoTaskMemAlloc( 4 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IWebAccountProvider;
+    (*iids)[1] = IID_IWebAccountProvider2;
+    (*iids)[2] = IID_IWebAccountProvider3;
+    (*iids)[3] = IID_IWebAccountProvider4;
+    return S_OK;
+}
+
+static HRESULT provider_get_class_name( HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_Security_Credentials_WebAccountProvider;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT provider_get_trust_level( TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+#define PROVIDER_INSPECTABLE_METHODS( pfx, iface_type, from )                                    \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )       \
+    { return provider_query_interface( from( iface ), iid, out ); }                               \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                         \
+    { return InterlockedIncrement( &from( iface )->ref ); }                                        \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                        \
+    { return provider_release( from( iface ) ); }                                                  \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )             \
+    { return provider_get_iids( count, iids ); }                                                   \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )            \
+    { return provider_get_class_name( name ); }                                                    \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )              \
+    { return provider_get_trust_level( level ); }
+
+PROVIDER_INSPECTABLE_METHODS( provider, IWebAccountProvider, provider_from_IWebAccountProvider )
+PROVIDER_INSPECTABLE_METHODS( provider2, IWebAccountProvider2, provider_from_IWebAccountProvider2 )
+PROVIDER_INSPECTABLE_METHODS( provider3, IWebAccountProvider3, provider_from_IWebAccountProvider3 )
+PROVIDER_INSPECTABLE_METHODS( provider4, IWebAccountProvider4, provider_from_IWebAccountProvider4 )
+
+static HRESULT WINAPI provider_get_Id( IWebAccountProvider *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( provider_from_IWebAccountProvider( iface )->id, value );
+}
+
+static HRESULT WINAPI provider_get_DisplayName( IWebAccountProvider *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( provider_from_IWebAccountProvider( iface )->display_name, value );
+}
+
+static HRESULT WINAPI provider_get_IconUri( IWebAccountProvider *iface, IUriRuntimeClass **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static const IWebAccountProviderVtbl provider_vtbl =
+{
+    provider_QueryInterface,
+    provider_AddRef,
+    provider_Release,
+    provider_GetIids,
+    provider_GetRuntimeClassName,
+    provider_GetTrustLevel,
+    provider_get_Id,
+    provider_get_DisplayName,
+    provider_get_IconUri,
+};
+
+static HRESULT WINAPI provider2_get_DisplayPurpose( IWebAccountProvider2 *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( provider_from_IWebAccountProvider2( iface )->display_purpose, value );
+}
+
+static HRESULT WINAPI provider2_get_Authority( IWebAccountProvider2 *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( provider_from_IWebAccountProvider2( iface )->authority, value );
+}
+
+static const IWebAccountProvider2Vtbl provider2_vtbl =
+{
+    provider2_QueryInterface,
+    provider2_AddRef,
+    provider2_Release,
+    provider2_GetIids,
+    provider2_GetRuntimeClassName,
+    provider2_GetTrustLevel,
+    provider2_get_DisplayPurpose,
+    provider2_get_Authority,
+};
+
+static HRESULT WINAPI provider3_get_User( IWebAccountProvider3 *iface, IUser **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static const IWebAccountProvider3Vtbl provider3_vtbl =
+{
+    provider3_QueryInterface,
+    provider3_AddRef,
+    provider3_Release,
+    provider3_GetIids,
+    provider3_GetRuntimeClassName,
+    provider3_GetTrustLevel,
+    provider3_get_User,
+};
+
+static HRESULT WINAPI provider4_get_IsSystemProvider( IWebAccountProvider4 *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = provider_from_IWebAccountProvider4( iface )->system_provider;
+    return S_OK;
+}
+
+static const IWebAccountProvider4Vtbl provider4_vtbl =
+{
+    provider4_QueryInterface,
+    provider4_AddRef,
+    provider4_Release,
+    provider4_GetIids,
+    provider4_GetRuntimeClassName,
+    provider4_GetTrustLevel,
+    provider4_get_IsSystemProvider,
+};
+
+HRESULT web_account_provider_create( HSTRING id, HSTRING display_name, HSTRING authority,
+                                     boolean system_provider, IWebAccountProvider **out )
+{
+    struct web_account_provider *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IWebAccountProvider_iface.lpVtbl = &provider_vtbl;
+    impl->IWebAccountProvider2_iface.lpVtbl = &provider2_vtbl;
+    impl->IWebAccountProvider3_iface.lpVtbl = &provider3_vtbl;
+    impl->IWebAccountProvider4_iface.lpVtbl = &provider4_vtbl;
+    impl->ref = 1;
+    impl->system_provider = system_provider;
+    if (FAILED(hr = WindowsDuplicateString( id, &impl->id )) ||
+        FAILED(hr = WindowsDuplicateString( display_name, &impl->display_name )) ||
+        FAILED(hr = WindowsDuplicateString( display_name, &impl->display_purpose )) ||
+        FAILED(hr = WindowsDuplicateString( authority, &impl->authority )))
+    {
+        provider_release( impl );
+        return hr;
+    }
+    *out = &impl->IWebAccountProvider_iface;
+    return S_OK;
+}
+
+static inline struct web_account *account_from_IWebAccount( IWebAccount *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_account, IWebAccount_iface );
+}
+
+static inline struct web_account *account_from_IWebAccount2( IWebAccount2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_account, IWebAccount2_iface );
+}
+
+static HRESULT account_query_interface( struct web_account *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IWebAccount ))
+        *out = &impl->IWebAccount_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAccount2 ))
+        *out = &impl->IWebAccount2_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG account_release( struct web_account *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->provider) IWebAccountProvider_Release( impl->provider );
+        if (impl->properties) IMap_HSTRING_HSTRING_Release( impl->properties );
+        WindowsDeleteString( impl->id );
+        WindowsDeleteString( impl->username );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT account_get_iids( ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 2;
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IWebAccount;
+    (*iids)[1] = IID_IWebAccount2;
+    return S_OK;
+}
+
+static HRESULT account_get_class_name( HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_Security_Credentials_WebAccount;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+#define ACCOUNT_INSPECTABLE_METHODS( pfx, iface_type, from )                                     \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )       \
+    { return account_query_interface( from( iface ), iid, out ); }                                \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                         \
+    { return InterlockedIncrement( &from( iface )->ref ); }                                        \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                        \
+    { return account_release( from( iface ) ); }                                                   \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )             \
+    { return account_get_iids( count, iids ); }                                                    \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )            \
+    { return account_get_class_name( name ); }                                                     \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )              \
+    { return provider_get_trust_level( level ); }
+
+ACCOUNT_INSPECTABLE_METHODS( account, IWebAccount, account_from_IWebAccount )
+ACCOUNT_INSPECTABLE_METHODS( account2, IWebAccount2, account_from_IWebAccount2 )
+
+static HRESULT WINAPI account_get_WebAccountProvider( IWebAccount *iface, IWebAccountProvider **value )
+{
+    struct web_account *impl = account_from_IWebAccount( iface );
+    if (!value) return E_POINTER;
+    *value = impl->provider;
+    IWebAccountProvider_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI account_get_UserName( IWebAccount *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( account_from_IWebAccount( iface )->username, value );
+}
+
+static HRESULT WINAPI account_get_State( IWebAccount *iface, WebAccountState *value )
+{
+    if (!value) return E_POINTER;
+    *value = account_from_IWebAccount( iface )->state;
+    return S_OK;
+}
+
+static const IWebAccountVtbl account_vtbl =
+{
+    account_QueryInterface,
+    account_AddRef,
+    account_Release,
+    account_GetIids,
+    account_GetRuntimeClassName,
+    account_GetTrustLevel,
+    account_get_WebAccountProvider,
+    account_get_UserName,
+    account_get_State,
+};
+
+static HRESULT WINAPI account2_get_Id( IWebAccount2 *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( account_from_IWebAccount2( iface )->id, value );
+}
+
+static HRESULT WINAPI account2_get_Properties( IWebAccount2 *iface, IMapView_HSTRING_HSTRING **value )
+{
+    return IMap_HSTRING_HSTRING_GetView( account_from_IWebAccount2( iface )->properties, value );
+}
+
+static HRESULT WINAPI account2_GetPictureAsync( IWebAccount2 *iface, INT32 size,
+                                                 IAsyncOperation_IRandomAccessStream **operation )
+{
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI account2_SignOutAsync( IWebAccount2 *iface, IAsyncAction **operation )
+{
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI account2_SignOutWithClientIdAsync( IWebAccount2 *iface, HSTRING client_id,
+                                                         IAsyncAction **operation )
+{
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static const IWebAccount2Vtbl account2_vtbl =
+{
+    account2_QueryInterface,
+    account2_AddRef,
+    account2_Release,
+    account2_GetIids,
+    account2_GetRuntimeClassName,
+    account2_GetTrustLevel,
+    account2_get_Id,
+    account2_get_Properties,
+    account2_GetPictureAsync,
+    account2_SignOutAsync,
+    account2_SignOutWithClientIdAsync,
+};
+
+HRESULT web_account_create( IWebAccountProvider *provider, HSTRING id, HSTRING username,
+                            WebAccountState state, IWebAccount **out )
+{
+    struct web_account *impl;
+    HRESULT hr;
+
+    if (!provider || !out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IWebAccount_iface.lpVtbl = &account_vtbl;
+    impl->IWebAccount2_iface.lpVtbl = &account2_vtbl;
+    impl->ref = 1;
+    impl->provider = provider;
+    impl->state = state;
+    IWebAccountProvider_AddRef( provider );
+    if (FAILED(hr = WindowsDuplicateString( id, &impl->id )) ||
+        FAILED(hr = WindowsDuplicateString( username, &impl->username )) ||
+        FAILED(hr = string_map_create( &impl->properties )))
+    {
+        account_release( impl );
+        return hr;
+    }
+    *out = &impl->IWebAccount_iface;
+    return S_OK;
+}
+
+HRESULT web_account_set_property( IWebAccount *account, const WCHAR *name, HSTRING value )
+{
+    HSTRING key;
+    boolean replaced;
+    HRESULT hr;
+
+    if (!account || !name) return E_POINTER;
+    if (FAILED(hr = WindowsCreateString( name, wcslen(name), &key ))) return hr;
+    hr = IMap_HSTRING_HSTRING_Insert( account_from_IWebAccount(account)->properties, key, value, &replaced );
+    WindowsDeleteString( key );
+    return hr;
+}
+
+static inline struct account_factory *account_factory_from_activation( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct account_factory, IActivationFactory_iface );
+}
+
+static inline struct account_factory *account_factory_from_factory( IWebAccountFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct account_factory, IWebAccountFactory_iface );
+}
+
+static HRESULT account_factory_query_interface( struct account_factory *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAccountFactory ))
+        *out = &impl->IWebAccountFactory_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+#define ACCOUNT_FACTORY_INSPECTABLE( pfx, iface_type, from )                                      \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )        \
+    { return account_factory_query_interface( from( iface ), iid, out ); }                         \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                          \
+    { return InterlockedIncrement( &from( iface )->ref ); }                                         \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    { return InterlockedDecrement( &from( iface )->ref ); }                                         \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )              \
+    { if (!count || !iids) return E_POINTER; *count = 1;                                            \
+      if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;                         \
+      **iids = IID_IWebAccountFactory; return S_OK; }                                               \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )             \
+    { return account_get_class_name( name ); }                                                      \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )               \
+    { return provider_get_trust_level( level ); }
+
+ACCOUNT_FACTORY_INSPECTABLE( account_activation, IActivationFactory, account_factory_from_activation )
+ACCOUNT_FACTORY_INSPECTABLE( account_factory, IWebAccountFactory, account_factory_from_factory )
+
+static HRESULT WINAPI account_activation_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl account_activation_vtbl =
+{
+    account_activation_QueryInterface,
+    account_activation_AddRef,
+    account_activation_Release,
+    account_activation_GetIids,
+    account_activation_GetRuntimeClassName,
+    account_activation_GetTrustLevel,
+    account_activation_ActivateInstance,
+};
+
+static HRESULT WINAPI account_factory_CreateWebAccount( IWebAccountFactory *iface, IWebAccountProvider *provider,
+                                                        HSTRING username, WebAccountState state,
+                                                        IWebAccount **value )
+{
+    return web_account_create( provider, username, username, state, value );
+}
+
+static const IWebAccountFactoryVtbl account_factory_vtbl =
+{
+    account_factory_QueryInterface,
+    account_factory_AddRef,
+    account_factory_Release,
+    account_factory_GetIids,
+    account_factory_GetRuntimeClassName,
+    account_factory_GetTrustLevel,
+    account_factory_CreateWebAccount,
+};
+
+static struct account_factory account_factory_impl =
+{
+    {&account_activation_vtbl},
+    {&account_factory_vtbl},
+    1,
+};
+
+IActivationFactory *web_account_factory = &account_factory_impl.IActivationFactory_iface;
+
+static inline struct provider_factory *provider_factory_from_activation( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct provider_factory, IActivationFactory_iface );
+}
+
+static inline struct provider_factory *provider_factory_from_factory( IWebAccountProviderFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct provider_factory, IWebAccountProviderFactory_iface );
+}
+
+static HRESULT provider_factory_query_interface( struct provider_factory *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAccountProviderFactory ))
+        *out = &impl->IWebAccountProviderFactory_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+#define PROVIDER_FACTORY_INSPECTABLE( pfx, iface_type, from )                                     \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )        \
+    { return provider_factory_query_interface( from( iface ), iid, out ); }                        \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                          \
+    { return InterlockedIncrement( &from( iface )->ref ); }                                         \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    { return InterlockedDecrement( &from( iface )->ref ); }                                         \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )              \
+    { if (!count || !iids) return E_POINTER; *count = 1;                                            \
+      if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;                         \
+      **iids = IID_IWebAccountProviderFactory; return S_OK; }                                       \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )             \
+    { return provider_get_class_name( name ); }                                                     \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )               \
+    { return provider_get_trust_level( level ); }
+
+PROVIDER_FACTORY_INSPECTABLE( provider_activation, IActivationFactory, provider_factory_from_activation )
+PROVIDER_FACTORY_INSPECTABLE( provider_factory, IWebAccountProviderFactory, provider_factory_from_factory )
+
+static HRESULT WINAPI provider_activation_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl provider_activation_vtbl =
+{
+    provider_activation_QueryInterface,
+    provider_activation_AddRef,
+    provider_activation_Release,
+    provider_activation_GetIids,
+    provider_activation_GetRuntimeClassName,
+    provider_activation_GetTrustLevel,
+    provider_activation_ActivateInstance,
+};
+
+static HRESULT WINAPI provider_factory_CreateWebAccountProvider( IWebAccountProviderFactory *iface, HSTRING id,
+                                                                 HSTRING display_name, IUriRuntimeClass *icon_uri,
+                                                                 IWebAccountProvider **value )
+{
+    HSTRING authority = NULL;
+    HRESULT hr;
+    if (FAILED(hr = WindowsCreateString( L"", 0, &authority ))) return hr;
+    hr = web_account_provider_create( id, display_name, authority, FALSE, value );
+    WindowsDeleteString( authority );
+    return hr;
+}
+
+static const IWebAccountProviderFactoryVtbl provider_factory_vtbl =
+{
+    provider_factory_QueryInterface,
+    provider_factory_AddRef,
+    provider_factory_Release,
+    provider_factory_GetIids,
+    provider_factory_GetRuntimeClassName,
+    provider_factory_GetTrustLevel,
+    provider_factory_CreateWebAccountProvider,
+};
+
+static struct provider_factory provider_factory_impl =
+{
+    {&provider_activation_vtbl},
+    {&provider_factory_vtbl},
+    1,
+};
+
+IActivationFactory *web_account_provider_factory = &provider_factory_impl.IActivationFactory_iface;
diff --git a/dlls/windows.security.authentication.onlineid/web_accounts.c b/dlls/windows.security.authentication.onlineid/web_accounts.c
new file mode 100644
index 000000000..588a4550a
--- /dev/null
+++ b/dlls/windows.security.authentication.onlineid/web_accounts.c
@@ -0,0 +1,423 @@
+/* WinRT account enumeration
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "private.h"
+
+struct accounts_result
+{
+    IFindAllAccountsResult IFindAllAccountsResult_iface;
+    IVectorView_WebAccount IVectorView_iface;
+    IIterable_WebAccount IIterable_iface;
+    LONG ref;
+    UINT32 count;
+    IWebAccount **accounts;
+    IWebProviderError *error;
+};
+
+static inline struct accounts_result *impl_from_result( IFindAllAccountsResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct accounts_result, IFindAllAccountsResult_iface );
+}
+
+static HRESULT WINAPI result_QueryInterface( IFindAllAccountsResult *iface, REFIID iid, void **out )
+{
+    struct accounts_result *impl = impl_from_result( iface );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IFindAllAccountsResult ))
+        *out = iface;
+    else if (IsEqualGUID( iid, &IID_IVectorView_WebAccount ))
+        *out = &impl->IVectorView_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_WebAccount ))
+        *out = &impl->IIterable_iface;
+    else return E_NOINTERFACE;
+    IFindAllAccountsResult_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI result_AddRef( IFindAllAccountsResult *iface )
+{
+    return InterlockedIncrement( &impl_from_result( iface )->ref );
+}
+
+static ULONG WINAPI result_Release( IFindAllAccountsResult *iface )
+{
+    struct accounts_result *impl = impl_from_result( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; ++i) IWebAccount_Release( impl->accounts[i] );
+        if (impl->error) IWebProviderError_Release( impl->error );
+        free( impl->accounts );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI result_GetIids( IFindAllAccountsResult *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc( 3 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IFindAllAccountsResult;
+    (*iids)[1] = IID_IVectorView_WebAccount;
+    (*iids)[2] = IID_IIterable_WebAccount;
+    *count = 3;
+    return S_OK;
+}
+
+static HRESULT WINAPI result_GetRuntimeClassName( IFindAllAccountsResult *iface, HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_Security_Authentication_Web_Core_FindAllAccountsResult;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI result_GetTrustLevel( IFindAllAccountsResult *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI result_get_Accounts( IFindAllAccountsResult *iface, IVectorView_WebAccount **out )
+{
+    if (!out) return E_POINTER;
+    *out = &impl_from_result( iface )->IVectorView_iface;
+    IVectorView_WebAccount_AddRef( *out );
+    return S_OK;
+}
+
+static HRESULT WINAPI result_get_Status( IFindAllAccountsResult *iface, FindAllWebAccountsStatus *out )
+{
+    if (!out) return E_POINTER;
+    *out = impl_from_result( iface )->error ? FindAllWebAccountsStatus_ProviderError : FindAllWebAccountsStatus_Success;
+    return S_OK;
+}
+
+static HRESULT WINAPI result_get_ProviderError( IFindAllAccountsResult *iface, IWebProviderError **out )
+{
+    if (!out) return E_POINTER;
+    *out = impl_from_result( iface )->error;
+    if (*out) IWebProviderError_AddRef( *out );
+    return S_OK;
+}
+
+static const IFindAllAccountsResultVtbl result_vtbl =
+{
+    result_QueryInterface,
+    result_AddRef,
+    result_Release,
+    result_GetIids,
+    result_GetRuntimeClassName,
+    result_GetTrustLevel,
+    result_get_Accounts,
+    result_get_Status,
+    result_get_ProviderError,
+};
+
+DEFINE_IINSPECTABLE_( view, IVectorView_WebAccount, struct accounts_result,
+                     impl_from_view, IVectorView_iface, &impl->IFindAllAccountsResult_iface )
+
+static HRESULT WINAPI view_GetAt( IVectorView_WebAccount *iface, UINT32 index, IWebAccount **out )
+{
+    struct accounts_result *impl = impl_from_view( iface );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (index >= impl->count) return E_BOUNDS;
+    *out = impl->accounts[index];
+    IWebAccount_AddRef( *out );
+    return S_OK;
+}
+
+static HRESULT WINAPI view_get_Size( IVectorView_WebAccount *iface, UINT32 *out )
+{
+    if (!out) return E_POINTER;
+    *out = impl_from_view( iface )->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_IndexOf( IVectorView_WebAccount *iface, IWebAccount *account, UINT32 *index, boolean *found )
+{
+    struct accounts_result *impl = impl_from_view( iface );
+    UINT32 i;
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    for (i = 0; i < impl->count; ++i)
+    {
+        if (impl->accounts[i] != account) continue;
+        *index = i;
+        *found = TRUE;
+        break;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetMany( IVectorView_WebAccount *iface, UINT32 start, UINT32 capacity,
+                                    IWebAccount **items, UINT32 *count )
+{
+    struct accounts_result *impl = impl_from_view( iface );
+    UINT32 i;
+    if (!count || (capacity && !items)) return E_POINTER;
+    *count = 0;
+    if (start > impl->count) return E_BOUNDS;
+    for (i = 0; i < min( capacity, impl->count - start ); ++i)
+    {
+        items[i] = impl->accounts[start + i];
+        IWebAccount_AddRef( items[i] );
+    }
+    *count = i;
+    return S_OK;
+}
+
+static const IVectorView_WebAccountVtbl view_vtbl =
+{
+    view_QueryInterface,
+    view_AddRef,
+    view_Release,
+    view_GetIids,
+    view_GetRuntimeClassName,
+    view_GetTrustLevel,
+    view_GetAt,
+    view_get_Size,
+    view_IndexOf,
+    view_GetMany,
+};
+
+struct account_iterator
+{
+    IIterator_WebAccount IIterator_iface;
+    LONG ref;
+    IVectorView_WebAccount *view;
+    UINT32 index;
+};
+
+static inline struct account_iterator *impl_from_iterator( IIterator_WebAccount *iface )
+{
+    return CONTAINING_RECORD( iface, struct account_iterator, IIterator_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_WebAccount *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IUnknown ) && !IsEqualGUID( iid, &IID_IInspectable ) &&
+        !IsEqualGUID( iid, &IID_IIterator_WebAccount )) return E_NOINTERFACE;
+    *out = iface;
+    IIterator_WebAccount_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_WebAccount *iface )
+{
+    return InterlockedIncrement( &impl_from_iterator( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_WebAccount *iface )
+{
+    struct account_iterator *impl = impl_from_iterator( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        IVectorView_WebAccount_Release( impl->view );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_WebAccount *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;
+    **iids = IID_IIterator_WebAccount;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_WebAccount *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.Collections.IIterator`1<Windows.Security.Credentials.WebAccount>";
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_WebAccount *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_WebAccount *iface, IWebAccount **out )
+{
+    struct account_iterator *impl = impl_from_iterator( iface );
+    return IVectorView_WebAccount_GetAt( impl->view, impl->index, out );
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_WebAccount *iface, boolean *out )
+{
+    struct account_iterator *impl = impl_from_iterator( iface );
+    UINT32 size;
+    if (!out) return E_POINTER;
+    IVectorView_WebAccount_get_Size( impl->view, &size );
+    *out = impl->index < size;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_WebAccount *iface, boolean *out )
+{
+    struct account_iterator *impl = impl_from_iterator( iface );
+    UINT32 size;
+    if (!out) return E_POINTER;
+    IVectorView_WebAccount_get_Size( impl->view, &size );
+    if (impl->index < size) ++impl->index;
+    *out = impl->index < size;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_WebAccount *iface, UINT32 capacity, IWebAccount **items, UINT32 *count )
+{
+    struct account_iterator *impl = impl_from_iterator( iface );
+    HRESULT hr = IVectorView_WebAccount_GetMany( impl->view, impl->index, capacity, items, count );
+    if (SUCCEEDED(hr)) impl->index += *count;
+    return hr;
+}
+
+static const IIterator_WebAccountVtbl iterator_vtbl =
+{
+    iterator_QueryInterface,
+    iterator_AddRef,
+    iterator_Release,
+    iterator_GetIids,
+    iterator_GetRuntimeClassName,
+    iterator_GetTrustLevel,
+    iterator_get_Current,
+    iterator_get_HasCurrent,
+    iterator_MoveNext,
+    iterator_GetMany,
+};
+
+DEFINE_IINSPECTABLE_( iterable, IIterable_WebAccount, struct accounts_result,
+                     impl_from_iterable, IIterable_iface, &impl->IFindAllAccountsResult_iface )
+
+static HRESULT WINAPI iterable_First( IIterable_WebAccount *iface, IIterator_WebAccount **out )
+{
+    struct account_iterator *impl;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IIterator_iface.lpVtbl = &iterator_vtbl;
+    impl->ref = 1;
+    impl->view = &impl_from_iterable( iface )->IVectorView_iface;
+    IVectorView_WebAccount_AddRef( impl->view );
+    *out = &impl->IIterator_iface;
+    return S_OK;
+}
+
+static const IIterable_WebAccountVtbl iterable_vtbl =
+{
+    iterable_QueryInterface,
+    iterable_AddRef,
+    iterable_Release,
+    iterable_GetIids,
+    iterable_GetRuntimeClassName,
+    iterable_GetTrustLevel,
+    iterable_First,
+};
+
+static HRESULT read_string( const BYTE **data, UINT32 *remaining, HSTRING *out )
+{
+    UINT32 size;
+    WCHAR *buffer;
+    int count;
+    HRESULT hr;
+
+    *out = NULL;
+    if (*remaining < sizeof(size)) return E_INVALIDARG;
+    memcpy( &size, *data, sizeof(size) );
+    *data += sizeof(size);
+    *remaining -= sizeof(size);
+    if (!size || size > 4096 || size > *remaining || memchr( *data, 0, size )) return E_INVALIDARG;
+    if (!(count = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)*data, size, NULL, 0 )))
+        return E_INVALIDARG;
+    if (!(buffer = malloc( count * sizeof(*buffer) ))) return E_OUTOFMEMORY;
+    MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)*data, size, buffer, count );
+    hr = WindowsCreateString( buffer, count, out );
+    free( buffer );
+    *data += size;
+    *remaining -= size;
+    return hr;
+}
+
+HRESULT web_accounts_result_create( IWebAccountProvider *provider, const struct identity_reply *reply,
+                                    IFindAllAccountsResult **out )
+{
+    struct accounts_result *impl;
+    const BYTE *data = reply->accounts;
+    UINT32 count, remaining = reply->accounts_size, i;
+    HSTRING id = NULL, username = NULL;
+    HRESULT hr = S_OK;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IFindAllAccountsResult_iface.lpVtbl = &result_vtbl;
+    impl->IVectorView_iface.lpVtbl = &view_vtbl;
+    impl->IIterable_iface.lpVtbl = &iterable_vtbl;
+    impl->ref = 1;
+    if (FAILED(reply->error))
+    {
+        hr = web_provider_error_create( reply->error, reply->error_message, &impl->error );
+        goto done;
+    }
+    if (remaining < sizeof(count))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    memcpy( &count, data, sizeof(count) );
+    data += sizeof(count);
+    remaining -= sizeof(count);
+    if (count > 128)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (count && !(impl->accounts = calloc( count, sizeof(*impl->accounts) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(hr = read_string( &data, &remaining, &id )) ||
+            FAILED(hr = read_string( &data, &remaining, &username )) ||
+            FAILED(hr = web_account_create( provider, id, username, WebAccountState_Connected,
+                                            &impl->accounts[impl->count] ))) goto done;
+        ++impl->count;
+        WindowsDeleteString( id );
+        WindowsDeleteString( username );
+        id = username = NULL;
+    }
+    if (remaining) hr = E_INVALIDARG;
+
+done:
+    WindowsDeleteString( id );
+    WindowsDeleteString( username );
+    if (FAILED(hr)) IFindAllAccountsResult_Release( &impl->IFindAllAccountsResult_iface );
+    else *out = &impl->IFindAllAccountsResult_iface;
+    return hr;
+}
diff --git a/dlls/windows.security.authentication.onlineid/web_async.c b/dlls/windows.security.authentication.onlineid/web_async.c
new file mode 100644
index 000000000..8af5ea240
--- /dev/null
+++ b/dlls/windows.security.authentication.onlineid/web_async.c
@@ -0,0 +1,686 @@
+/*
+ * WinRT web authentication asynchronous operations
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "private.h"
+
+#define ASYNC_CLOSED ((AsyncStatus)4)
+#define HANDLER_ASSIGNED ((IUnknown *)~(ULONG_PTR)0)
+
+enum web_async_kind
+{
+    WEB_ASYNC_TOKEN,
+    WEB_ASYNC_PROVIDER,
+    WEB_ASYNC_ACCOUNT,
+    WEB_ASYNC_ACCOUNTS,
+};
+
+struct completed_handler_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IUnknown *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( IUnknown * );
+    ULONG (WINAPI *Release)( IUnknown * );
+    HRESULT (WINAPI *Invoke)( IUnknown *, IInspectable *, AsyncStatus );
+};
+
+struct completed_handler
+{
+    const struct completed_handler_vtbl *lpVtbl;
+};
+
+struct web_async_operation
+{
+    IAsyncOperation_WebTokenRequestResult IAsyncOperation_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    TP_WORK *work;
+    HANDLE cancel;
+    IUnknown *handler;
+    IInspectable *result;
+    const IID *operation_iid;
+    const WCHAR *runtime_name;
+    enum web_async_kind kind;
+    AsyncStatus status;
+    HRESULT error;
+    union
+    {
+        struct
+        {
+            IWebTokenRequest *request;
+            IWebAccount *account;
+            boolean silent;
+        } token;
+        struct
+        {
+            HSTRING provider_id;
+            HSTRING authority;
+            boolean system_provider;
+        } provider;
+        struct
+        {
+            IWebAccountProvider *provider;
+            HSTRING account_id;
+        } account;
+        struct
+        {
+            IWebAccountProvider *provider;
+            HSTRING client_id;
+        } accounts;
+    } u;
+};
+
+static inline struct web_async_operation *impl_from_operation( IAsyncOperation_WebTokenRequestResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_async_operation, IAsyncOperation_iface );
+}
+
+static inline struct web_async_operation *impl_from_info( IAsyncInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_async_operation, IAsyncInfo_iface );
+}
+
+static HRESULT operation_query_interface( struct web_async_operation *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->operation_iid ))
+        *out = &impl->IAsyncOperation_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static void operation_destroy( struct web_async_operation *impl )
+{
+    if (impl->handler && impl->handler != HANDLER_ASSIGNED) IUnknown_Release( impl->handler );
+    if (impl->result) IInspectable_Release( impl->result );
+    switch (impl->kind)
+    {
+    case WEB_ASYNC_TOKEN:
+        if (impl->u.token.request) IWebTokenRequest_Release( impl->u.token.request );
+        if (impl->u.token.account) IWebAccount_Release( impl->u.token.account );
+        break;
+    case WEB_ASYNC_PROVIDER:
+        WindowsDeleteString( impl->u.provider.provider_id );
+        WindowsDeleteString( impl->u.provider.authority );
+        break;
+    case WEB_ASYNC_ACCOUNT:
+        if (impl->u.account.provider) IWebAccountProvider_Release( impl->u.account.provider );
+        WindowsDeleteString( impl->u.account.account_id );
+        break;
+    case WEB_ASYNC_ACCOUNTS:
+        if (impl->u.accounts.provider) IWebAccountProvider_Release( impl->u.accounts.provider );
+        WindowsDeleteString( impl->u.accounts.client_id );
+        break;
+    }
+    if (impl->work) CloseThreadpoolWork( impl->work );
+    if (impl->cancel) CloseHandle( impl->cancel );
+    impl->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &impl->cs );
+    free( impl );
+}
+
+static ULONG operation_release( struct web_async_operation *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) operation_destroy( impl );
+    return ref;
+}
+
+static HRESULT WINAPI operation_QueryInterface( IAsyncOperation_WebTokenRequestResult *iface, REFIID iid, void **out )
+{
+    return operation_query_interface( impl_from_operation( iface ), iid, out );
+}
+
+static ULONG WINAPI operation_AddRef( IAsyncOperation_WebTokenRequestResult *iface )
+{
+    return InterlockedIncrement( &impl_from_operation( iface )->ref );
+}
+
+static ULONG WINAPI operation_Release( IAsyncOperation_WebTokenRequestResult *iface )
+{
+    return operation_release( impl_from_operation( iface ) );
+}
+
+static HRESULT WINAPI operation_GetIids( IAsyncOperation_WebTokenRequestResult *iface, ULONG *count, IID **iids )
+{
+    struct web_async_operation *impl = impl_from_operation( iface );
+    if (!count || !iids) return E_POINTER;
+    *count = 1;
+    if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;
+    **iids = *impl->operation_iid;
+    return S_OK;
+}
+
+static HRESULT WINAPI operation_GetRuntimeClassName( IAsyncOperation_WebTokenRequestResult *iface, HSTRING *name )
+{
+    struct web_async_operation *impl = impl_from_operation( iface );
+    if (!name) return E_POINTER;
+    return WindowsCreateString( impl->runtime_name, wcslen( impl->runtime_name ), name );
+}
+
+static HRESULT WINAPI operation_GetTrustLevel( IAsyncOperation_WebTokenRequestResult *iface, TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI operation_put_Completed( IAsyncOperation_WebTokenRequestResult *iface,
+                                               IAsyncOperationCompletedHandler_WebTokenRequestResult *handler )
+{
+    struct web_async_operation *impl = impl_from_operation( iface );
+    IUnknown *unknown = (IUnknown *)handler;
+    AsyncStatus status;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == ASYNC_CLOSED || impl->handler != HANDLER_ASSIGNED)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return impl->status == ASYNC_CLOSED ? E_ILLEGAL_METHOD_CALL : E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    }
+    if (unknown) IUnknown_AddRef( unknown );
+    impl->handler = unknown;
+    status = impl->status;
+    if (status == Started)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return S_OK;
+    }
+    impl->handler = NULL;
+    LeaveCriticalSection( &impl->cs );
+    if (unknown)
+    {
+        ((struct completed_handler *)unknown)->lpVtbl->Invoke( unknown, (IInspectable *)iface, status );
+        IUnknown_Release( unknown );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI operation_get_Completed( IAsyncOperation_WebTokenRequestResult *iface,
+                                               IAsyncOperationCompletedHandler_WebTokenRequestResult **handler )
+{
+    struct web_async_operation *impl = impl_from_operation( iface );
+    if (!handler) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == ASYNC_CLOSED)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (!impl->handler || impl->handler == HANDLER_ASSIGNED)
+        *handler = NULL;
+    else
+    {
+        *handler = (IAsyncOperationCompletedHandler_WebTokenRequestResult *)impl->handler;
+        IUnknown_AddRef( impl->handler );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI operation_GetResults( IAsyncOperation_WebTokenRequestResult *iface,
+                                            IWebTokenRequestResult **result )
+{
+    struct web_async_operation *impl = impl_from_operation( iface );
+    HRESULT hr;
+    if (!result) return E_POINTER;
+    *result = NULL;
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Completed)
+    {
+        *result = (IWebTokenRequestResult *)impl->result;
+        if (*result) IInspectable_AddRef( impl->result );
+        hr = S_OK;
+    }
+    else if (impl->status == Error)
+        hr = impl->error;
+    else
+        hr = E_ILLEGAL_METHOD_CALL;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static const IAsyncOperation_WebTokenRequestResultVtbl operation_vtbl =
+{
+    operation_QueryInterface,
+    operation_AddRef,
+    operation_Release,
+    operation_GetIids,
+    operation_GetRuntimeClassName,
+    operation_GetTrustLevel,
+    operation_put_Completed,
+    operation_get_Completed,
+    operation_GetResults,
+};
+
+static HRESULT WINAPI info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )
+{
+    return operation_query_interface( impl_from_info( iface ), iid, out );
+}
+
+static ULONG WINAPI info_AddRef( IAsyncInfo *iface )
+{
+    return InterlockedIncrement( &impl_from_info( iface )->ref );
+}
+
+static ULONG WINAPI info_Release( IAsyncInfo *iface )
+{
+    return operation_release( impl_from_info( iface ) );
+}
+
+static HRESULT WINAPI info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 1;
+    if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;
+    **iids = IID_IAsyncInfo;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )
+{
+    return operation_GetRuntimeClassName( &impl_from_info( iface )->IAsyncOperation_iface, name );
+}
+
+static HRESULT WINAPI info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )
+{
+    return operation_GetTrustLevel( &impl_from_info( iface )->IAsyncOperation_iface, level );
+}
+
+static HRESULT WINAPI info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    if (!id) return E_POINTER;
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct web_async_operation *impl = impl_from_info( iface );
+    if (!status) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    *status = impl->status;
+    LeaveCriticalSection( &impl->cs );
+    return *status == ASYNC_CLOSED ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )
+{
+    struct web_async_operation *impl = impl_from_info( iface );
+    HRESULT hr = S_OK;
+
+    if (!error) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == ASYNC_CLOSED)
+        *error = hr = E_ILLEGAL_METHOD_CALL;
+    else
+        *error = impl->error;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    struct web_async_operation *impl = impl_from_info( iface );
+    IUnknown *handler = NULL;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == ASYNC_CLOSED)
+        hr = E_ILLEGAL_METHOD_CALL;
+    else if (impl->status == Started)
+    {
+        impl->status = Canceled;
+        impl->error = E_ABORT;
+        SetEvent( impl->cancel );
+        if (impl->handler && impl->handler != HANDLER_ASSIGNED)
+        {
+            handler = impl->handler;
+            impl->handler = NULL;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (handler)
+    {
+        ((struct completed_handler *)handler)->lpVtbl->Invoke( handler,
+                                                               (IInspectable *)&impl->IAsyncOperation_iface,
+                                                               Canceled );
+        IUnknown_Release( handler );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    struct web_async_operation *impl = impl_from_info( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started)
+        hr = E_ILLEGAL_STATE_CHANGE;
+    else if (impl->status != ASYNC_CLOSED)
+        impl->status = ASYNC_CLOSED;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static const IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface,
+    info_AddRef,
+    info_Release,
+    info_GetIids,
+    info_GetRuntimeClassName,
+    info_GetTrustLevel,
+    info_get_Id,
+    info_get_Status,
+    info_get_ErrorCode,
+    info_Cancel,
+    info_Close,
+};
+
+static HRESULT token_worker( struct web_async_operation *impl, IInspectable **result )
+{
+    IWebAccountProvider *provider = NULL;
+    IWebAccountProvider2 *provider2 = NULL;
+    IWebAccount2 *account2 = NULL;
+    struct identity_reply reply = {0};
+    IWebTokenRequestResult *token_result = NULL;
+    HSTRING client_id = NULL, scopes = NULL, authority = NULL, login_hint = NULL;
+    HSTRING account_id = NULL, policy = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = IWebTokenRequest_get_ClientId( impl->u.token.request, &client_id )) ||
+        FAILED(hr = IWebTokenRequest_get_Scope( impl->u.token.request, &scopes )) ||
+        FAILED(hr = IWebTokenRequest_get_WebAccountProvider( impl->u.token.request, &provider )) ||
+        FAILED(hr = IWebAccountProvider_QueryInterface( provider, &IID_IWebAccountProvider2, (void **)&provider2 )) ||
+        FAILED(hr = IWebAccountProvider2_get_Authority( provider2, &authority )) ||
+        FAILED(hr = WindowsCreateString( L"", 0, &policy )))
+        goto done;
+    if (impl->u.token.account && impl->u.token.silent)
+    {
+        if (FAILED(hr = IWebAccount_QueryInterface( impl->u.token.account, &IID_IWebAccount2,
+                                                    (void **)&account2 )) ||
+            FAILED(hr = IWebAccount2_get_Id( account2, &account_id )))
+            goto done;
+    }
+    else if (impl->u.token.account)
+        hr = IWebAccount_get_UserName( impl->u.token.account, &login_hint );
+    else
+        hr = WindowsCreateString( L"", 0, &login_hint );
+    if (FAILED(hr)) goto done;
+    if (impl->u.token.silent)
+    {
+        if (!account_id && FAILED(hr = WindowsCreateString( L"", 0, &account_id ))) goto done;
+        hr = identity_bridge_get_token( client_id, scopes, authority, account_id, impl->cancel, &reply );
+    }
+    else
+        hr = identity_bridge_authorize_client( client_id, scopes, authority, login_hint, policy, impl->cancel, &reply );
+    if (SUCCEEDED(hr))
+        hr = web_token_result_create( provider, &reply, WebTokenRequestStatus_Success, &token_result );
+    else if (hr == HRESULT_FROM_WIN32( ERROR_CANCELLED ))
+        hr = web_token_result_create( provider, NULL, WebTokenRequestStatus_UserCancel, &token_result );
+    else if (impl->u.token.silent)
+        hr = web_token_result_create( provider, NULL, WebTokenRequestStatus_UserInteractionRequired, &token_result );
+    else
+        hr = web_token_result_create( provider, &reply, WebTokenRequestStatus_ProviderError, &token_result );
+
+done:
+    if (account2) IWebAccount2_Release( account2 );
+    if (provider2) IWebAccountProvider2_Release( provider2 );
+    if (provider) IWebAccountProvider_Release( provider );
+    WindowsDeleteString( client_id );
+    WindowsDeleteString( scopes );
+    WindowsDeleteString( authority );
+    WindowsDeleteString( login_hint );
+    WindowsDeleteString( account_id );
+    WindowsDeleteString( policy );
+    identity_reply_clear( &reply );
+    if (SUCCEEDED(hr)) *result = (IInspectable *)token_result;
+    return hr;
+}
+
+static HRESULT provider_worker( struct web_async_operation *impl, IInspectable **result )
+{
+    IWebAccountProvider *provider;
+    HSTRING display_name = NULL, authority = impl->u.provider.authority;
+    HRESULT hr;
+    if (FAILED(hr = WindowsCreateString( L"Microsoft", 9, &display_name ))) return hr;
+    if (!WindowsGetStringLen( authority ) &&
+        FAILED(hr = WindowsCreateString( L"organizations", 13, &authority )))
+    {
+        WindowsDeleteString( display_name );
+        return hr;
+    }
+    hr = web_account_provider_create( impl->u.provider.provider_id, display_name,
+                                      authority, impl->u.provider.system_provider,
+                                      &provider );
+    if (authority != impl->u.provider.authority) WindowsDeleteString( authority );
+    WindowsDeleteString( display_name );
+    if (SUCCEEDED(hr)) *result = (IInspectable *)provider;
+    return hr;
+}
+
+static HRESULT account_worker( struct web_async_operation *impl, IInspectable **result )
+{
+    IWebAccount *account;
+    HRESULT hr = web_account_create( impl->u.account.provider, impl->u.account.account_id,
+                                     impl->u.account.account_id, WebAccountState_Connected, &account );
+    if (SUCCEEDED(hr)) *result = (IInspectable *)account;
+    return hr;
+}
+
+static HRESULT accounts_worker( struct web_async_operation *impl, IInspectable **result )
+{
+    IWebAccountProvider2 *provider2 = NULL;
+    IFindAllAccountsResult *accounts_result = NULL;
+    struct identity_reply reply = {0};
+    HSTRING authority = NULL, provider_id = NULL;
+    const WCHAR *id;
+    HRESULT hr;
+
+    if (FAILED(hr = IWebAccountProvider_get_Id( impl->u.accounts.provider, &provider_id ))) goto done;
+    id = WindowsGetStringRawBuffer( provider_id, NULL );
+    if (wcscmp( id, L"https://login.microsoft.com" ) && wcscmp( id, L"https://login.microsoftonline.com" ) &&
+        wcscmp( id, L"https://login.windows.net" ) && wcscmp( id, L"https://login.live.com" ))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (FAILED(hr = IWebAccountProvider_QueryInterface( impl->u.accounts.provider,
+        &IID_IWebAccountProvider2, (void **)&provider2 )) ||
+        FAILED(hr = IWebAccountProvider2_get_Authority( provider2, &authority ))) goto done;
+    hr = identity_bridge_list_accounts( impl->u.accounts.client_id, authority, impl->cancel, &reply );
+    if (hr == HRESULT_FROM_WIN32( ERROR_CANCELLED )) goto done;
+    reply.error = hr;
+    hr = web_accounts_result_create( impl->u.accounts.provider, &reply, &accounts_result );
+    if (SUCCEEDED(hr)) *result = (IInspectable *)accounts_result;
+
+done:
+    if (provider2) IWebAccountProvider2_Release( provider2 );
+    WindowsDeleteString( authority );
+    WindowsDeleteString( provider_id );
+    identity_reply_clear( &reply );
+    return hr;
+}
+
+static void CALLBACK operation_callback( TP_CALLBACK_INSTANCE *instance, void *context, TP_WORK *work )
+{
+    struct web_async_operation *impl = context;
+    IUnknown *handler = NULL;
+    IInspectable *result = NULL;
+    AsyncStatus status;
+    HRESULT hr;
+
+    switch (impl->kind)
+    {
+    case WEB_ASYNC_TOKEN: hr = token_worker( impl, &result ); break;
+    case WEB_ASYNC_PROVIDER: hr = provider_worker( impl, &result ); break;
+    case WEB_ASYNC_ACCOUNT: hr = account_worker( impl, &result ); break;
+    case WEB_ASYNC_ACCOUNTS: hr = accounts_worker( impl, &result ); break;
+    default: hr = E_UNEXPECTED; break;
+    }
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started)
+    {
+        impl->result = result;
+        impl->error = hr;
+        impl->status = SUCCEEDED(hr) ? Completed : Error;
+        result = NULL;
+    }
+    status = impl->status;
+    if (impl->handler && impl->handler != HANDLER_ASSIGNED)
+    {
+        handler = impl->handler;
+        impl->handler = NULL;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (result) IInspectable_Release( result );
+    if (handler)
+    {
+        ((struct completed_handler *)handler)->lpVtbl->Invoke( handler,
+                                                               (IInspectable *)&impl->IAsyncOperation_iface,
+                                                               status );
+        IUnknown_Release( handler );
+    }
+    operation_release( impl );
+}
+
+static HRESULT operation_create( enum web_async_kind kind, const IID *iid, const WCHAR *runtime_name,
+                                 struct web_async_operation **out )
+{
+    struct web_async_operation *impl;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncOperation_iface.lpVtbl = &operation_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    impl->ref = 1;
+    impl->handler = HANDLER_ASSIGNED;
+    impl->operation_iid = iid;
+    impl->runtime_name = runtime_name;
+    impl->kind = kind;
+    impl->status = Started;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": web_async_operation.cs");
+    if (!(impl->cancel = CreateEventW( NULL, TRUE, FALSE, NULL )))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        operation_destroy( impl );
+        return hr;
+    }
+    if (!(impl->work = CreateThreadpoolWork( operation_callback, impl, NULL )))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        operation_destroy( impl );
+        return hr;
+    }
+    *out = impl;
+    return S_OK;
+}
+
+static void operation_submit( struct web_async_operation *impl )
+{
+    InterlockedIncrement( &impl->ref );
+    SubmitThreadpoolWork( impl->work );
+}
+
+HRESULT web_async_token_create( IWebTokenRequest *request, IWebAccount *account, boolean silent,
+                                IAsyncOperation_WebTokenRequestResult **out )
+{
+    static const WCHAR runtime_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Authentication.Web.Core.WebTokenRequestResult>";
+    struct web_async_operation *impl;
+    HRESULT hr;
+    if (!request || !out) return E_POINTER;
+    if (FAILED(hr = operation_create( WEB_ASYNC_TOKEN, &IID_IAsyncOperation_WebTokenRequestResult,
+                                      runtime_name, &impl ))) return hr;
+    impl->u.token.request = request;
+    impl->u.token.account = account;
+    impl->u.token.silent = silent;
+    IWebTokenRequest_AddRef( request );
+    if (account) IWebAccount_AddRef( account );
+    *out = &impl->IAsyncOperation_iface;
+    operation_submit( impl );
+    return S_OK;
+}
+
+HRESULT web_async_provider_create( HSTRING provider_id, HSTRING authority, boolean system_provider,
+                                   IAsyncOperation_WebAccountProvider **out )
+{
+    static const WCHAR runtime_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.WebAccountProvider>";
+    struct web_async_operation *impl = NULL;
+    HRESULT hr;
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = operation_create( WEB_ASYNC_PROVIDER, &IID_IAsyncOperation_WebAccountProvider,
+                                      runtime_name, &impl )) ||
+        FAILED(hr = WindowsDuplicateString( provider_id, &impl->u.provider.provider_id )) ||
+        FAILED(hr = WindowsDuplicateString( authority, &impl->u.provider.authority )))
+    {
+        if (impl) operation_release( impl );
+        return hr;
+    }
+    impl->u.provider.system_provider = system_provider;
+    *out = (IAsyncOperation_WebAccountProvider *)&impl->IAsyncOperation_iface;
+    operation_submit( impl );
+    return S_OK;
+}
+
+HRESULT web_async_account_create( IWebAccountProvider *provider, HSTRING account_id,
+                                  IAsyncOperation_WebAccount **out )
+{
+    static const WCHAR runtime_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Credentials.WebAccount>";
+    struct web_async_operation *impl = NULL;
+    HRESULT hr;
+    if (!provider || !out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = operation_create( WEB_ASYNC_ACCOUNT, &IID_IAsyncOperation_WebAccount,
+                                      runtime_name, &impl )) ||
+        FAILED(hr = WindowsDuplicateString( account_id, &impl->u.account.account_id )))
+    {
+        if (impl) operation_release( impl );
+        return hr;
+    }
+    impl->u.account.provider = provider;
+    IWebAccountProvider_AddRef( provider );
+    *out = (IAsyncOperation_WebAccount *)&impl->IAsyncOperation_iface;
+    operation_submit( impl );
+    return S_OK;
+}
+
+HRESULT web_async_accounts_create( IWebAccountProvider *provider, HSTRING client_id,
+                                   IAsyncOperation_FindAllAccountsResult **out )
+{
+    static const WCHAR runtime_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.Security.Authentication.Web.Core.FindAllAccountsResult>";
+    struct web_async_operation *impl = NULL;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!provider) return E_POINTER;
+    if (FAILED(hr = operation_create( WEB_ASYNC_ACCOUNTS, &IID_IAsyncOperation_FindAllAccountsResult,
+                                      runtime_name, &impl )) ||
+        FAILED(hr = WindowsDuplicateString( client_id, &impl->u.accounts.client_id )))
+    {
+        if (impl) operation_release( impl );
+        return hr;
+    }
+    impl->u.accounts.provider = provider;
+    IWebAccountProvider_AddRef( provider );
+    *out = (IAsyncOperation_FindAllAccountsResult *)&impl->IAsyncOperation_iface;
+    operation_submit( impl );
+    return S_OK;
+}
diff --git a/dlls/windows.security.authentication.onlineid/web_core.c b/dlls/windows.security.authentication.onlineid/web_core.c
new file mode 100644
index 000000000..f423f1261
--- /dev/null
+++ b/dlls/windows.security.authentication.onlineid/web_core.c
@@ -0,0 +1,288 @@
+/*
+ * WinRT web authentication core manager
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "private.h"
+#include "webauthenticationcoremanagerinterop.h"
+
+struct manager_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IWebAuthenticationCoreManagerStatics IWebAuthenticationCoreManagerStatics_iface;
+    IWebAuthenticationCoreManagerStatics4 IWebAuthenticationCoreManagerStatics4_iface;
+    IWebAuthenticationCoreManagerInterop IWebAuthenticationCoreManagerInterop_iface;
+    LONG ref;
+};
+
+static inline struct manager_factory *factory_from_activation( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager_factory, IActivationFactory_iface );
+}
+
+static inline struct manager_factory *factory_from_statics( IWebAuthenticationCoreManagerStatics *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager_factory, IWebAuthenticationCoreManagerStatics_iface );
+}
+
+static inline struct manager_factory *factory_from_statics4( IWebAuthenticationCoreManagerStatics4 *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager_factory, IWebAuthenticationCoreManagerStatics4_iface );
+}
+
+static inline struct manager_factory *factory_from_interop( IWebAuthenticationCoreManagerInterop *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager_factory, IWebAuthenticationCoreManagerInterop_iface );
+}
+
+static HRESULT factory_query_interface( struct manager_factory *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAuthenticationCoreManagerStatics ))
+        *out = &impl->IWebAuthenticationCoreManagerStatics_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAuthenticationCoreManagerStatics4 ))
+        *out = &impl->IWebAuthenticationCoreManagerStatics4_iface;
+    else if (IsEqualGUID( iid, &IID_IWebAuthenticationCoreManagerInterop ))
+        *out = &impl->IWebAuthenticationCoreManagerInterop_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+#define MANAGER_INSPECTABLE_METHODS(pfx, iface_type, from_iface)                                  \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )        \
+    { return factory_query_interface( from_iface( iface ), iid, out ); }                            \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                          \
+    { return InterlockedIncrement( &from_iface( iface )->ref ); }                                   \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    { return InterlockedDecrement( &from_iface( iface )->ref ); }                                   \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )              \
+    {                                                                                               \
+        if (!count || !iids) return E_POINTER;                                                      \
+        *count = 3;                                                                                 \
+        if (!(*iids = CoTaskMemAlloc( *count * sizeof(**iids) ))) return E_OUTOFMEMORY;             \
+        (*iids)[0] = IID_IWebAuthenticationCoreManagerStatics;                                      \
+        (*iids)[1] = IID_IWebAuthenticationCoreManagerStatics4;                                     \
+        (*iids)[2] = IID_IWebAuthenticationCoreManagerInterop;                                      \
+        return S_OK;                                                                                \
+    }                                                                                               \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )            \
+    {                                                                                               \
+        const WCHAR *class_name = RuntimeClass_Windows_Security_Authentication_Web_Core_WebAuthenticationCoreManager; \
+        return WindowsCreateString( class_name, wcslen( class_name ), name );                       \
+    }                                                                                               \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )              \
+    { if (!level) return E_POINTER; *level = BaseTrust; return S_OK; }
+
+MANAGER_INSPECTABLE_METHODS( activation, IActivationFactory, factory_from_activation )
+MANAGER_INSPECTABLE_METHODS( statics, IWebAuthenticationCoreManagerStatics, factory_from_statics )
+MANAGER_INSPECTABLE_METHODS( statics4, IWebAuthenticationCoreManagerStatics4, factory_from_statics4 )
+MANAGER_INSPECTABLE_METHODS( interop, IWebAuthenticationCoreManagerInterop, factory_from_interop )
+
+static HRESULT WINAPI activation_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl activation_vtbl =
+{
+    activation_QueryInterface,
+    activation_AddRef,
+    activation_Release,
+    activation_GetIids,
+    activation_GetRuntimeClassName,
+    activation_GetTrustLevel,
+    activation_ActivateInstance,
+};
+
+static HRESULT WINAPI statics_GetTokenSilentlyAsync( IWebAuthenticationCoreManagerStatics *iface,
+                                                     IWebTokenRequest *request,
+                                                     IAsyncOperation_WebTokenRequestResult **operation )
+{
+    return web_async_token_create( request, NULL, TRUE, operation );
+}
+
+static HRESULT WINAPI statics_GetTokenSilentlyWithWebAccountAsync(
+    IWebAuthenticationCoreManagerStatics *iface, IWebTokenRequest *request, IWebAccount *account,
+    IAsyncOperation_WebTokenRequestResult **operation )
+{
+    return web_async_token_create( request, account, TRUE, operation );
+}
+
+static HRESULT WINAPI statics_RequestTokenAsync( IWebAuthenticationCoreManagerStatics *iface,
+                                                 IWebTokenRequest *request,
+                                                 IAsyncOperation_WebTokenRequestResult **operation )
+{
+    return web_async_token_create( request, NULL, FALSE, operation );
+}
+
+static HRESULT WINAPI statics_RequestTokenWithWebAccountAsync(
+    IWebAuthenticationCoreManagerStatics *iface, IWebTokenRequest *request, IWebAccount *account,
+    IAsyncOperation_WebTokenRequestResult **operation )
+{
+    return web_async_token_create( request, account, FALSE, operation );
+}
+
+static HRESULT WINAPI statics_FindAccountAsync( IWebAuthenticationCoreManagerStatics *iface,
+                                                IWebAccountProvider *provider, HSTRING account_id,
+                                                IAsyncOperation_WebAccount **operation )
+{
+    return web_async_account_create( provider, account_id, operation );
+}
+
+static HRESULT WINAPI statics_FindAccountProviderAsync( IWebAuthenticationCoreManagerStatics *iface,
+                                                        HSTRING provider_id,
+                                                        IAsyncOperation_WebAccountProvider **operation )
+{
+    return web_async_provider_create( provider_id, NULL, FALSE, operation );
+}
+
+static HRESULT WINAPI statics_FindAccountProviderWithAuthorityAsync(
+    IWebAuthenticationCoreManagerStatics *iface, HSTRING provider_id, HSTRING authority,
+    IAsyncOperation_WebAccountProvider **operation )
+{
+    return web_async_provider_create( provider_id, authority, FALSE, operation );
+}
+
+static const IWebAuthenticationCoreManagerStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    statics_GetTokenSilentlyAsync,
+    statics_GetTokenSilentlyWithWebAccountAsync,
+    statics_RequestTokenAsync,
+    statics_RequestTokenWithWebAccountAsync,
+    statics_FindAccountAsync,
+    statics_FindAccountProviderAsync,
+    statics_FindAccountProviderWithAuthorityAsync,
+};
+
+static HRESULT WINAPI statics4_FindAllAccountsAsync( IWebAuthenticationCoreManagerStatics4 *iface,
+                                                      IWebAccountProvider *provider,
+                                                      IAsyncOperation_FindAllAccountsResult **operation )
+{
+    return web_async_accounts_create( provider, NULL, operation );
+}
+
+static HRESULT WINAPI statics4_FindAllAccountsWithClientIdAsync(
+    IWebAuthenticationCoreManagerStatics4 *iface, IWebAccountProvider *provider, HSTRING client_id,
+    IAsyncOperation_FindAllAccountsResult **operation )
+{
+    return web_async_accounts_create( provider, client_id, operation );
+}
+
+static HRESULT WINAPI statics4_FindSystemAccountProviderAsync(
+    IWebAuthenticationCoreManagerStatics4 *iface, HSTRING provider_id,
+    IAsyncOperation_WebAccountProvider **operation )
+{
+    return web_async_provider_create( provider_id, NULL, TRUE, operation );
+}
+
+static HRESULT WINAPI statics4_FindSystemAccountProviderWithAuthorityAsync(
+    IWebAuthenticationCoreManagerStatics4 *iface, HSTRING provider_id, HSTRING authority,
+    IAsyncOperation_WebAccountProvider **operation )
+{
+    return web_async_provider_create( provider_id, authority, TRUE, operation );
+}
+
+static HRESULT WINAPI statics4_FindSystemAccountProviderWithAuthorityForUserAsync(
+    IWebAuthenticationCoreManagerStatics4 *iface, HSTRING provider_id, HSTRING authority, IUser *user,
+    IAsyncOperation_WebAccountProvider **operation )
+{
+    return web_async_provider_create( provider_id, authority, TRUE, operation );
+}
+
+static const IWebAuthenticationCoreManagerStatics4Vtbl statics4_vtbl =
+{
+    statics4_QueryInterface,
+    statics4_AddRef,
+    statics4_Release,
+    statics4_GetIids,
+    statics4_GetRuntimeClassName,
+    statics4_GetTrustLevel,
+    statics4_FindAllAccountsAsync,
+    statics4_FindAllAccountsWithClientIdAsync,
+    statics4_FindSystemAccountProviderAsync,
+    statics4_FindSystemAccountProviderWithAuthorityAsync,
+    statics4_FindSystemAccountProviderWithAuthorityForUserAsync,
+};
+
+static HRESULT interop_request_token( IInspectable *request, IInspectable *account,
+                                      REFIID iid, void **out )
+{
+    IWebTokenRequest *token_request;
+    IWebAccount *web_account = NULL;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!request || !iid) return E_POINTER;
+    if (!IsEqualGUID( iid, &IID_IAsyncOperation_WebTokenRequestResult )) return E_NOINTERFACE;
+    if (FAILED(hr = IInspectable_QueryInterface( request, &IID_IWebTokenRequest,
+                                                 (void **)&token_request ))) return hr;
+    if (account)
+        hr = IInspectable_QueryInterface( account, &IID_IWebAccount, (void **)&web_account );
+    if (SUCCEEDED(hr))
+        hr = web_async_token_create( token_request, web_account, FALSE,
+                                    (IAsyncOperation_WebTokenRequestResult **)out );
+    if (web_account) IWebAccount_Release( web_account );
+    IWebTokenRequest_Release( token_request );
+    return hr;
+}
+
+static HRESULT WINAPI interop_RequestTokenForWindowAsync( IWebAuthenticationCoreManagerInterop *iface,
+                                                          HWND window, IInspectable *request,
+                                                          REFIID iid, void **out )
+{
+    return interop_request_token( request, NULL, iid, out );
+}
+
+static HRESULT WINAPI interop_RequestTokenWithWebAccountForWindowAsync(
+    IWebAuthenticationCoreManagerInterop *iface, HWND window, IInspectable *request,
+    IInspectable *account, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!account) return E_POINTER;
+    return interop_request_token( request, account, iid, out );
+}
+
+static const IWebAuthenticationCoreManagerInteropVtbl interop_vtbl =
+{
+    interop_QueryInterface,
+    interop_AddRef,
+    interop_Release,
+    interop_GetIids,
+    interop_GetRuntimeClassName,
+    interop_GetTrustLevel,
+    interop_RequestTokenForWindowAsync,
+    interop_RequestTokenWithWebAccountForWindowAsync,
+};
+
+static struct manager_factory manager_factory =
+{
+    {&activation_vtbl},
+    {&statics_vtbl},
+    {&statics4_vtbl},
+    {&interop_vtbl},
+    1,
+};
+
+IActivationFactory *web_authentication_core_manager_factory = &manager_factory.IActivationFactory_iface;
diff --git a/dlls/windows.security.authentication.onlineid/web_token.c b/dlls/windows.security.authentication.onlineid/web_token.c
new file mode 100644
index 000000000..f034509ae
--- /dev/null
+++ b/dlls/windows.security.authentication.onlineid/web_token.c
@@ -0,0 +1,1129 @@
+/*
+ * WinRT web token objects
+ *
+ * Copyright (C) 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdio.h>
+#include "private.h"
+
+struct web_token_request
+{
+    IWebTokenRequest IWebTokenRequest_iface;
+    IWebTokenRequest2 IWebTokenRequest2_iface;
+    IWebTokenRequest3 IWebTokenRequest3_iface;
+    LONG ref;
+    IWebAccountProvider *provider;
+    HSTRING scope;
+    HSTRING client_id;
+    HSTRING correlation_id;
+    WebTokenRequestPromptType prompt_type;
+    IMap_HSTRING_HSTRING *properties;
+    IMap_HSTRING_HSTRING *app_properties;
+};
+
+struct request_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IWebTokenRequestFactory IWebTokenRequestFactory_iface;
+    LONG ref;
+};
+
+static inline struct web_token_request *request_from_IWebTokenRequest( IWebTokenRequest *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_token_request, IWebTokenRequest_iface );
+}
+
+static inline struct web_token_request *request_from_IWebTokenRequest2( IWebTokenRequest2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_token_request, IWebTokenRequest2_iface );
+}
+
+static inline struct web_token_request *request_from_IWebTokenRequest3( IWebTokenRequest3 *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_token_request, IWebTokenRequest3_iface );
+}
+
+static HRESULT request_query_interface( struct web_token_request *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IWebTokenRequest ))
+        *out = &impl->IWebTokenRequest_iface;
+    else if (IsEqualGUID( iid, &IID_IWebTokenRequest2 ))
+        *out = &impl->IWebTokenRequest2_iface;
+    else if (IsEqualGUID( iid, &IID_IWebTokenRequest3 ))
+        *out = &impl->IWebTokenRequest3_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG request_release( struct web_token_request *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->provider) IWebAccountProvider_Release( impl->provider );
+        if (impl->properties) IMap_HSTRING_HSTRING_Release( impl->properties );
+        if (impl->app_properties) IMap_HSTRING_HSTRING_Release( impl->app_properties );
+        WindowsDeleteString( impl->scope );
+        WindowsDeleteString( impl->client_id );
+        WindowsDeleteString( impl->correlation_id );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT request_get_iids( ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 3;
+    if (!(*iids = CoTaskMemAlloc( 3 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IWebTokenRequest;
+    (*iids)[1] = IID_IWebTokenRequest2;
+    (*iids)[2] = IID_IWebTokenRequest3;
+    return S_OK;
+}
+
+static HRESULT request_get_class_name( HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_Security_Authentication_Web_Core_WebTokenRequest;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT web_get_trust_level( TrustLevel *level )
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+#define REQUEST_INSPECTABLE_METHODS( pfx, iface_type, from )                                      \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )        \
+    { return request_query_interface( from( iface ), iid, out ); }                                 \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                          \
+    { return InterlockedIncrement( &from( iface )->ref ); }                                         \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    { return request_release( from( iface ) ); }                                                    \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )              \
+    { return request_get_iids( count, iids ); }                                                     \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )             \
+    { return request_get_class_name( name ); }                                                      \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )               \
+    { return web_get_trust_level( level ); }
+
+REQUEST_INSPECTABLE_METHODS( request, IWebTokenRequest, request_from_IWebTokenRequest )
+REQUEST_INSPECTABLE_METHODS( request2, IWebTokenRequest2, request_from_IWebTokenRequest2 )
+REQUEST_INSPECTABLE_METHODS( request3, IWebTokenRequest3, request_from_IWebTokenRequest3 )
+
+static HRESULT WINAPI request_get_WebAccountProvider( IWebTokenRequest *iface, IWebAccountProvider **value )
+{
+    struct web_token_request *impl = request_from_IWebTokenRequest( iface );
+    if (!value) return E_POINTER;
+    *value = impl->provider;
+    IWebAccountProvider_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI request_get_Scope( IWebTokenRequest *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( request_from_IWebTokenRequest( iface )->scope, value );
+}
+
+static HRESULT WINAPI request_get_ClientId( IWebTokenRequest *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( request_from_IWebTokenRequest( iface )->client_id, value );
+}
+
+static HRESULT WINAPI request_get_PromptType( IWebTokenRequest *iface, WebTokenRequestPromptType *value )
+{
+    if (!value) return E_POINTER;
+    *value = request_from_IWebTokenRequest( iface )->prompt_type;
+    return S_OK;
+}
+
+static HRESULT WINAPI request_get_Properties( IWebTokenRequest *iface, IMap_HSTRING_HSTRING **value )
+{
+    struct web_token_request *impl = request_from_IWebTokenRequest( iface );
+    if (!value) return E_POINTER;
+    *value = impl->properties;
+    IMap_HSTRING_HSTRING_AddRef( *value );
+    return S_OK;
+}
+
+static const IWebTokenRequestVtbl request_vtbl =
+{
+    request_QueryInterface,
+    request_AddRef,
+    request_Release,
+    request_GetIids,
+    request_GetRuntimeClassName,
+    request_GetTrustLevel,
+    request_get_WebAccountProvider,
+    request_get_Scope,
+    request_get_ClientId,
+    request_get_PromptType,
+    request_get_Properties,
+};
+
+static HRESULT WINAPI request2_get_AppProperties( IWebTokenRequest2 *iface, IMap_HSTRING_HSTRING **value )
+{
+    struct web_token_request *impl = request_from_IWebTokenRequest2( iface );
+    if (!value) return E_POINTER;
+    *value = impl->app_properties;
+    IMap_HSTRING_HSTRING_AddRef( *value );
+    return S_OK;
+}
+
+static const IWebTokenRequest2Vtbl request2_vtbl =
+{
+    request2_QueryInterface,
+    request2_AddRef,
+    request2_Release,
+    request2_GetIids,
+    request2_GetRuntimeClassName,
+    request2_GetTrustLevel,
+    request2_get_AppProperties,
+};
+
+static HRESULT WINAPI request3_get_CorrelationId( IWebTokenRequest3 *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( request_from_IWebTokenRequest3( iface )->correlation_id, value );
+}
+
+static HRESULT WINAPI request3_put_CorrelationId( IWebTokenRequest3 *iface, HSTRING value )
+{
+    struct web_token_request *impl = request_from_IWebTokenRequest3( iface );
+    HSTRING copy;
+    HRESULT hr;
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    WindowsDeleteString( impl->correlation_id );
+    impl->correlation_id = copy;
+    return S_OK;
+}
+
+static const IWebTokenRequest3Vtbl request3_vtbl =
+{
+    request3_QueryInterface,
+    request3_AddRef,
+    request3_Release,
+    request3_GetIids,
+    request3_GetRuntimeClassName,
+    request3_GetTrustLevel,
+    request3_get_CorrelationId,
+    request3_put_CorrelationId,
+};
+
+HRESULT web_token_request_create( IWebAccountProvider *provider, HSTRING scope, HSTRING client_id,
+                                  WebTokenRequestPromptType prompt_type, IWebTokenRequest **out )
+{
+    struct web_token_request *impl;
+    HRESULT hr;
+
+    if (!provider || !out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IWebTokenRequest_iface.lpVtbl = &request_vtbl;
+    impl->IWebTokenRequest2_iface.lpVtbl = &request2_vtbl;
+    impl->IWebTokenRequest3_iface.lpVtbl = &request3_vtbl;
+    impl->ref = 1;
+    impl->provider = provider;
+    impl->prompt_type = prompt_type;
+    IWebAccountProvider_AddRef( provider );
+    if (FAILED(hr = WindowsDuplicateString( scope, &impl->scope )) ||
+        FAILED(hr = WindowsDuplicateString( client_id, &impl->client_id )) ||
+        FAILED(hr = WindowsCreateString( L"", 0, &impl->correlation_id )) ||
+        FAILED(hr = string_map_create( &impl->properties )) ||
+        FAILED(hr = string_map_create( &impl->app_properties )))
+    {
+        request_release( impl );
+        return hr;
+    }
+    *out = &impl->IWebTokenRequest_iface;
+    return S_OK;
+}
+
+static inline struct request_factory *request_factory_from_activation( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct request_factory, IActivationFactory_iface );
+}
+
+static inline struct request_factory *request_factory_from_factory( IWebTokenRequestFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct request_factory, IWebTokenRequestFactory_iface );
+}
+
+static HRESULT request_factory_query_interface( struct request_factory *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebTokenRequestFactory ))
+        *out = &impl->IWebTokenRequestFactory_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+#define REQUEST_FACTORY_INSPECTABLE( pfx, iface_type, from )                                      \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )        \
+    { return request_factory_query_interface( from( iface ), iid, out ); }                         \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                          \
+    { return InterlockedIncrement( &from( iface )->ref ); }                                         \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    { return InterlockedDecrement( &from( iface )->ref ); }                                         \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )              \
+    { if (!count || !iids) return E_POINTER; *count = 1;                                            \
+      if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;                         \
+      **iids = IID_IWebTokenRequestFactory; return S_OK; }                                          \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )             \
+    { return request_get_class_name( name ); }                                                      \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )               \
+    { return web_get_trust_level( level ); }
+
+REQUEST_FACTORY_INSPECTABLE( request_activation, IActivationFactory, request_factory_from_activation )
+REQUEST_FACTORY_INSPECTABLE( request_factory, IWebTokenRequestFactory, request_factory_from_factory )
+
+static HRESULT WINAPI request_activation_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl request_activation_vtbl =
+{
+    request_activation_QueryInterface,
+    request_activation_AddRef,
+    request_activation_Release,
+    request_activation_GetIids,
+    request_activation_GetRuntimeClassName,
+    request_activation_GetTrustLevel,
+    request_activation_ActivateInstance,
+};
+
+static HRESULT WINAPI request_factory_Create( IWebTokenRequestFactory *iface, IWebAccountProvider *provider,
+                                              HSTRING scope, HSTRING client_id, IWebTokenRequest **value )
+{
+    return web_token_request_create( provider, scope, client_id, WebTokenRequestPromptType_Default, value );
+}
+
+static HRESULT WINAPI request_factory_CreateWithPromptType( IWebTokenRequestFactory *iface,
+                                                            IWebAccountProvider *provider, HSTRING scope,
+                                                            HSTRING client_id, WebTokenRequestPromptType prompt_type,
+                                                            IWebTokenRequest **value )
+{
+    return web_token_request_create( provider, scope, client_id, prompt_type, value );
+}
+
+static HRESULT create_request_with_defaults( IWebAccountProvider *provider, HSTRING scope,
+                                             IWebTokenRequest **value )
+{
+    HSTRING client_id = NULL;
+    HRESULT hr;
+    if (FAILED(hr = WindowsCreateString( L"", 0, &client_id ))) return hr;
+    hr = web_token_request_create( provider, scope, client_id, WebTokenRequestPromptType_Default, value );
+    WindowsDeleteString( client_id );
+    return hr;
+}
+
+static HRESULT WINAPI request_factory_CreateWithProvider( IWebTokenRequestFactory *iface,
+                                                          IWebAccountProvider *provider,
+                                                          IWebTokenRequest **value )
+{
+    HSTRING scope = NULL;
+    HRESULT hr;
+    if (FAILED(hr = WindowsCreateString( L"", 0, &scope ))) return hr;
+    hr = create_request_with_defaults( provider, scope, value );
+    WindowsDeleteString( scope );
+    return hr;
+}
+
+static HRESULT WINAPI request_factory_CreateWithScope( IWebTokenRequestFactory *iface,
+                                                       IWebAccountProvider *provider, HSTRING scope,
+                                                       IWebTokenRequest **value )
+{
+    return create_request_with_defaults( provider, scope, value );
+}
+
+static const IWebTokenRequestFactoryVtbl request_factory_vtbl =
+{
+    request_factory_QueryInterface,
+    request_factory_AddRef,
+    request_factory_Release,
+    request_factory_GetIids,
+    request_factory_GetRuntimeClassName,
+    request_factory_GetTrustLevel,
+    request_factory_Create,
+    request_factory_CreateWithPromptType,
+    request_factory_CreateWithProvider,
+    request_factory_CreateWithScope,
+};
+
+static struct request_factory request_factory_impl =
+{
+    {&request_activation_vtbl},
+    {&request_factory_vtbl},
+    1,
+};
+
+IActivationFactory *web_token_request_factory = &request_factory_impl.IActivationFactory_iface;
+
+struct web_token_response
+{
+    IWebTokenResponse IWebTokenResponse_iface;
+    LONG ref;
+    HSTRING token;
+    IWebAccount *account;
+    IWebProviderError *error;
+    IMap_HSTRING_HSTRING *properties;
+};
+
+struct response_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IWebTokenResponseFactory IWebTokenResponseFactory_iface;
+    LONG ref;
+};
+
+static inline struct web_token_response *response_from_IWebTokenResponse( IWebTokenResponse *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_token_response, IWebTokenResponse_iface );
+}
+
+static HRESULT WINAPI response_QueryInterface( IWebTokenResponse *iface, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IWebTokenResponse ))
+        *out = iface;
+    if (!*out) return E_NOINTERFACE;
+    IWebTokenResponse_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI response_AddRef( IWebTokenResponse *iface )
+{
+    return InterlockedIncrement( &response_from_IWebTokenResponse( iface )->ref );
+}
+
+static ULONG WINAPI response_Release( IWebTokenResponse *iface )
+{
+    struct web_token_response *impl = response_from_IWebTokenResponse( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->account) IWebAccount_Release( impl->account );
+        if (impl->error) IWebProviderError_Release( impl->error );
+        if (impl->properties) IMap_HSTRING_HSTRING_Release( impl->properties );
+        WindowsDeleteString( impl->token );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI response_GetIids( IWebTokenResponse *iface, ULONG *count, IID **iids )
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 1;
+    if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;
+    **iids = IID_IWebTokenResponse;
+    return S_OK;
+}
+
+static HRESULT response_get_class_name( HSTRING *name )
+{
+    const WCHAR *class_name = RuntimeClass_Windows_Security_Authentication_Web_Core_WebTokenResponse;
+    if (!name) return E_POINTER;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI response_GetRuntimeClassName( IWebTokenResponse *iface, HSTRING *name )
+{
+    return response_get_class_name( name );
+}
+
+static HRESULT WINAPI response_GetTrustLevel( IWebTokenResponse *iface, TrustLevel *level )
+{
+    return web_get_trust_level( level );
+}
+
+static HRESULT WINAPI response_get_Token( IWebTokenResponse *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( response_from_IWebTokenResponse( iface )->token, value );
+}
+
+static HRESULT WINAPI response_get_ProviderError( IWebTokenResponse *iface, IWebProviderError **value )
+{
+    struct web_token_response *impl = response_from_IWebTokenResponse( iface );
+    if (!value) return E_POINTER;
+    *value = impl->error;
+    if (*value) IWebProviderError_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI response_get_WebAccount( IWebTokenResponse *iface, IWebAccount **value )
+{
+    struct web_token_response *impl = response_from_IWebTokenResponse( iface );
+    if (!value) return E_POINTER;
+    *value = impl->account;
+    if (*value) IWebAccount_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI response_get_Properties( IWebTokenResponse *iface, IMap_HSTRING_HSTRING **value )
+{
+    struct web_token_response *impl = response_from_IWebTokenResponse( iface );
+    if (!value) return E_POINTER;
+    *value = impl->properties;
+    IMap_HSTRING_HSTRING_AddRef( *value );
+    return S_OK;
+}
+
+static const IWebTokenResponseVtbl response_vtbl =
+{
+    response_QueryInterface,
+    response_AddRef,
+    response_Release,
+    response_GetIids,
+    response_GetRuntimeClassName,
+    response_GetTrustLevel,
+    response_get_Token,
+    response_get_ProviderError,
+    response_get_WebAccount,
+    response_get_Properties,
+};
+
+HRESULT web_token_response_create( HSTRING token, IWebAccount *account, IWebProviderError *error,
+                                   IWebTokenResponse **out )
+{
+    struct web_token_response *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IWebTokenResponse_iface.lpVtbl = &response_vtbl;
+    impl->ref = 1;
+    impl->account = account;
+    impl->error = error;
+    if (account) IWebAccount_AddRef( account );
+    if (error) IWebProviderError_AddRef( error );
+    if (FAILED(hr = WindowsDuplicateString( token, &impl->token )) ||
+        FAILED(hr = string_map_create( &impl->properties )))
+    {
+        response_Release( &impl->IWebTokenResponse_iface );
+        return hr;
+    }
+    *out = &impl->IWebTokenResponse_iface;
+    return S_OK;
+}
+
+static inline struct response_factory *response_factory_from_activation( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct response_factory, IActivationFactory_iface );
+}
+
+static inline struct response_factory *response_factory_from_factory( IWebTokenResponseFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct response_factory, IWebTokenResponseFactory_iface );
+}
+
+static HRESULT response_factory_query_interface( struct response_factory *impl, REFIID iid, void **out )
+{
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWebTokenResponseFactory ))
+        *out = &impl->IWebTokenResponseFactory_iface;
+    else
+        return E_NOINTERFACE;
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+#define RESPONSE_FACTORY_INSPECTABLE( pfx, iface_type, from )                                     \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out )        \
+    { return response_factory_query_interface( from( iface ), iid, out ); }                        \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface )                                          \
+    { return InterlockedIncrement( &from( iface )->ref ); }                                         \
+    static ULONG WINAPI pfx##_Release( iface_type *iface )                                         \
+    { return InterlockedDecrement( &from( iface )->ref ); }                                         \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids )              \
+    { if (!count || !iids) return E_POINTER; *count = 1;                                            \
+      if (!(*iids = CoTaskMemAlloc( sizeof(**iids) ))) return E_OUTOFMEMORY;                         \
+      **iids = IID_IWebTokenResponseFactory; return S_OK; }                                         \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name )             \
+    { return response_get_class_name( name ); }                                                     \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level )               \
+    { return web_get_trust_level( level ); }
+
+RESPONSE_FACTORY_INSPECTABLE( response_activation, IActivationFactory, response_factory_from_activation )
+RESPONSE_FACTORY_INSPECTABLE( response_factory, IWebTokenResponseFactory, response_factory_from_factory )
