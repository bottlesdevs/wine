+import "inspectable.idl";
+
+[
+    object,
+    local,
+    uuid(f4b8e804-811e-4436-b69c-44cb67b72084),
+    pointer_default(unique)
+]
+interface IWebAuthenticationCoreManagerInterop : IInspectable
+{
+    HRESULT RequestTokenForWindowAsync(
+        [in] HWND window,
