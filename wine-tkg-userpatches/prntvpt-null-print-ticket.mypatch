From: Mirko Brombin <brombin94@gmail.com>
Subject: [PATCH] prntvpt: Use the printer defaults when PTGetPrintCapabilities gets no print ticket.

---
diff --git a/dlls/prntvpt/tests/prntvpt.c b/dlls/prntvpt/tests/prntvpt.c
index 8d955cd866b..c7f17f88130 100644
--- a/dlls/prntvpt/tests/prntvpt.c
+++ b/dlls/prntvpt/tests/prntvpt.c
@@ -126,6 +126,33 @@ static void test_PTOpenProviderEx(void)
     }
 }

+static void test_PTGetPrintCapabilities(void)
+{
+    HPTPROVIDER hprov;
+    IStream *caps;
+    STATSTG stat;
+    HRESULT hr;
+
+    hr = PTOpenProvider(default_name, 1, &hprov);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = PTGetPrintCapabilities(hprov, NULL, NULL, NULL);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &caps);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    /* without a print ticket the printer defaults are used */
+    hr = PTGetPrintCapabilities(hprov, NULL, caps, NULL);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IStream_Stat(caps, &stat, STATFLAG_NONAME);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(stat.cbSize.QuadPart > 0, "got empty capabilities\n");
+
+    IStream_Release(caps);
+    PTCloseProvider(hprov);
+}
+
 START_TEST(prntvpt)
 {
     DWORD size;
@@ -143,6 +170,7 @@ START_TEST(prntvpt)

     test_PTOpenProvider();
     test_PTOpenProviderEx();
+    test_PTGetPrintCapabilities();

     CoUninitialize();
 }
diff --git a/dlls/prntvpt/ticket.c b/dlls/prntvpt/ticket.c
index a73f535d79a..3f9d0e837e8 100644
--- a/dlls/prntvpt/ticket.c
+++ b/dlls/prntvpt/ticket.c
@@ -1793,10 +1793,12 @@ HRESULT WINAPI PTGetPrintCapabilities(HPTPROVIDER provider, IStream *stream, ISt

     TRACE("%p,%p,%p,%p\n", provider, stream, caps, error);

-    if (!is_valid_provider(provider) || !stream || !caps)
+    if (!is_valid_provider(provider) || !caps)
         return E_INVALIDARG;

-    hr = parse_ticket(stream, kPTJobScope, &ticket);
+    /* without a print ticket the capabilities describe the printer defaults */
+    if (stream) hr = parse_ticket(stream, kPTJobScope, &ticket);
+    else hr = initialize_ticket(prov, &ticket);
     if (hr != S_OK) return hr;

     return write_print_capabilities(prov->name, caps, ticket.page.orientation);
