+            layer_class_name, NULL, WS_CHILD | WS_DISABLED | WS_CLIPSIBLINGS, 0, 0,
+            max( 1, rect.right ), max( 1, rect.bottom ), hwnd, NULL, layer_instance, NULL );
+    if (!impl->render_hwnd)
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
