+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+struct shared_mode_settings_factory
+{
+    struct winrt_factory base;
+    ISharedModeSettingsStatics ISharedModeSettingsStatics_iface;
+    ISharedModeSettingsStatics2 ISharedModeSettingsStatics2_iface;
+};
+
+DEFINE_FACTORY_IINSPECTABLE( statics, ISharedModeSettingsStatics, struct shared_mode_settings_factory )
+DEFINE_FACTORY_IINSPECTABLE( statics2, ISharedModeSettingsStatics2, struct shared_mode_settings_factory )
+
+static HRESULT WINAPI statics_get_IsEnabled( ISharedModeSettingsStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics2_get_ShouldAvoidLocalStorage( ISharedModeSettingsStatics2 *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const ISharedModeSettingsStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* ISharedModeSettingsStatics methods */
+    statics_get_IsEnabled,
+};
+
+static const ISharedModeSettingsStatics2Vtbl statics2_vtbl =
+{
+    statics2_QueryInterface,
+    statics2_AddRef,
+    statics2_Release,
+    /* IInspectable methods */
+    statics2_GetIids,
+    statics2_GetRuntimeClassName,
+    statics2_GetTrustLevel,
+    /* ISharedModeSettingsStatics2 methods */
+    statics2_get_ShouldAvoidLocalStorage,
+};
+
+static const struct winrt_factory_interface factory_interfaces[] =
+{
+    {&IID_ISharedModeSettingsStatics, offsetof(struct shared_mode_settings_factory, ISharedModeSettingsStatics_iface)},
+    {&IID_ISharedModeSettingsStatics2, offsetof(struct shared_mode_settings_factory, ISharedModeSettingsStatics2_iface)},
+};
+
+static struct shared_mode_settings_factory factory =
+{
+    {{&winrt_factory_vtbl}, 1, RuntimeClass_Windows_System_Profile_SharedModeSettings,
+      factory_interfaces, ARRAY_SIZE(factory_interfaces), TRUE, NULL},
+    {&statics_vtbl},
+    {&statics2_vtbl},
+};
+
+IActivationFactory *shared_mode_settings_factory = &factory.base.IActivationFactory_iface;
diff --git a/dlls/twinapi.appcore/tests/twinapi.c b/dlls/twinapi.appcore/tests/twinapi.c
index a1c7657..629a46f 100644
--- a/dlls/twinapi.appcore/tests/twinapi.c
+++ b/dlls/twinapi.appcore/tests/twinapi.c
@@ -268,6 +268,53 @@ static void test_RetailInfo(void)
     ok( ref == 1, "got ref %lu.\n", ref );
 }
 
+static void test_SharedModeSettings(void)
+{
+    static const WCHAR *class_name = RuntimeClass_Windows_System_Profile_SharedModeSettings;
+    ISharedModeSettingsStatics2 *statics2;
+    ISharedModeSettingsStatics *statics;
+    IActivationFactory *factory;
+    HSTRING str;
+    boolean value;
+    HRESULT hr;
+    ULONG ref;
+
+    hr = WindowsCreateString( class_name, wcslen(class_name), &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK || broken( hr == REGDB_E_CLASSNOTREG ), "got hr %#lx.\n", hr );
+    if (hr == REGDB_E_CLASSNOTREG)
+    {
+        win_skip( "%s runtimeclass not registered, skipping tests.\n", wine_dbgstr_w(class_name) );
+        return;
+    }
+
+    check_interface( factory, &IID_IUnknown, TRUE );
+    check_interface( factory, &IID_IInspectable, TRUE );
+    check_interface( factory, &IID_IAgileObject, TRUE );
+    check_interface( factory, &IID_ISharedModeSettingsStatics, TRUE );
+    check_interface( factory, &IID_ISharedModeSettingsStatics2, TRUE );
+
+    hr = IActivationFactory_QueryInterface( factory, &IID_ISharedModeSettingsStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ISharedModeSettingsStatics_get_IsEnabled( statics, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ref = ISharedModeSettingsStatics_Release( statics );
+    ok( ref == 2, "got ref %lu.\n", ref );
+
+    hr = IActivationFactory_QueryInterface( factory, &IID_ISharedModeSettingsStatics2, (void **)&statics2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ISharedModeSettingsStatics2_get_ShouldAvoidLocalStorage( statics2, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ref = ISharedModeSettingsStatics2_Release( statics2 );
+    ok( ref == 2, "got ref %lu.\n", ref );
+
+    ref = IActivationFactory_Release( factory );
+    ok( ref == 1, "got ref %lu.\n", ref );
+}
+
 static void test_AdvertisingManager(void)
 {
     static const WCHAR *class_name = RuntimeClass_Windows_System_UserProfile_AdvertisingManager;
@@ -347,6 +394,7 @@ START_TEST(twinapi)
     test_EasClientDeviceInformation();
     test_AnalyticsVersionInfo();
     test_RetailInfo();
+    test_SharedModeSettings();
     test_AdvertisingManager();
     test_ApplicationView();
 
