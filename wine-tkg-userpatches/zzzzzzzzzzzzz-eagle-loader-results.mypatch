+}
+
+FARPROC WINAPI get_proc_address( HMODULE module, LPCSTR function )
+{
+    FARPROC result = get_proc_address_impl( module, function );
+    __wine_eagle_loader_result("loader.GetProcAddress", function, FALSE, FALSE, module, (const void *)result, 0, !!result, __builtin_return_address(0));
+    return result;
 }
 
 
