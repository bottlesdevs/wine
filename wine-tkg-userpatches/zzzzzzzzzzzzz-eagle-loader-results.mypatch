@@ -30,6 +30,7 @@
 #include "winternl.h"
 #include "ddk/ntddk.h"
 #include "kernelbase.h"
+#include "eagle_trace.h"
 #include "wine/list.h"
 #include "wine/asm.h"
 #include "wine/debug.h"
@@ -61,10 +62,99 @@
  ***********************************************************************/
 
 
+static BOOL loader_trace_name(const void *name, BOOL wide, BOOL basename, char *label,
+        BOOL *sanitized, BOOL *truncated)
+{
+    union { WCHAR wide[16]; char narrow[16]; } block;
+    SIZE_T read, offset = 0, width = wide ? sizeof(WCHAR) : 1;
+    unsigned i, length = 0;
+    WCHAR ch;
+
+    *sanitized = *truncated = FALSE;
+    while (name && offset < 512)
+    {
+        read = 0;
+        ReadProcessMemory(GetCurrentProcess(), (const char *)name + offset * width,
+                &block, 16 * width, &read);
+        if (!(read /= width)) break;
+        for (i = 0; i < read; ++i)
+        {
+            ch = wide ? block.wide[i] : (unsigned char)block.narrow[i];
+            if (!ch)
+            {
+                label[length] = 0;
+                return TRUE;
+            }
+            if (basename && (ch == '/' || ch == '\\' || ch == ':'))
+            {
+                length = 0;
+                *sanitized = *truncated = FALSE;
+            }
+            else if (length < 127)
+            {
+                BOOL plain = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
+                        || (ch >= '0' && ch <= '9') || ch == '.' || ch == '_' || ch == '-' || ch == '@' || ch == '$';
+                label[length++] = plain ? ch : '?';
+                if (!plain) *sanitized = TRUE;
+            }
+            else *truncated = TRUE;
+        }
+        offset += read;
+    }
+    label[0] = 0;
+    return FALSE;
+}
+
+void WINAPI __wine_eagle_loader_result(const char *operation, const void *name, BOOL wide, BOOL basename,
+        HMODULE module, const void *address, DWORD flags, BOOL success, const void *caller)
+{
+    static LONG tls_index = TLS_OUT_OF_INDEXES, emitted;
+    DWORD saved_error = GetLastError(), error = success ? 0 : saved_error;
+    ULONG saved_status = NtCurrentTeb()->LastStatusValue;
+    char text[768], label[128];
+    BOOL active = FALSE, available, sanitized, truncated;
+    LONG index, count;
+    unsigned ordinal = !basename && (ULONG_PTR)name <= 0xffff ? (ULONG_PTR)name : 0;
+
+    if (!eagle_trace_enabled(32) || !IsDebuggerPresent()) goto done;
+    if (InterlockedCompareExchange(&emitted, 0, 0) >= 4097) goto done;
+    index = InterlockedCompareExchange(&tls_index, TLS_OUT_OF_INDEXES, TLS_OUT_OF_INDEXES);
+    if (index == (LONG)TLS_OUT_OF_INDEXES)
+    {
+        DWORD created = TlsAlloc();
+        if (created == TLS_OUT_OF_INDEXES) goto done;
+        index = InterlockedCompareExchange(&tls_index, created, TLS_OUT_OF_INDEXES);
+        if (index == (LONG)TLS_OUT_OF_INDEXES) index = created;
+        else TlsFree(created);
+    }
+    if (TlsGetValue(index) || !TlsSetValue(index, (void *)1)) goto done;
+    active = TRUE;
+    count = InterlockedIncrement(&emitted);
+    if (count > 4097) goto done;
+    if (count == 4097)
+        snprintf(text, sizeof(text), "EAGLE/1 {\"provider\":32,\"event\":\"ObserverBudgetExceeded\",\"limit\":4096}");
+    else
+    {
+        available = loader_trace_name(ordinal ? NULL : name, wide, basename, label, &sanitized, &truncated);
+        snprintf(text, sizeof(text), "EAGLE/1 {\"provider\":32,\"event\":\"%s\",\"hresult\":\"0x%08lx\","
+                "\"win32_error\":%lu,\"success\":%s,\"name\":\"%s\",\"name_available\":%s,"
+                "\"name_sanitized\":%s,\"name_truncated\":%s,\"ordinal\":%u,\"module\":\"%p\","
+                "\"address\":\"%p\",\"flags\":%lu,\"caller\":\"%p\"}",
+                operation, HRESULT_FROM_WIN32(error), error, success ? "true" : "false", label,
+                available ? "true" : "false", sanitized ? "true" : "false", truncated ? "true" : "false",
+                ordinal, module, address, flags, caller);
+    }
+    OutputDebugStringA(text);
+done:
+    if (active) TlsSetValue(index, NULL);
+    SetLastError(saved_error);
+    NtCurrentTeb()->LastStatusValue = saved_status;
+}
+
 /******************************************************************
  *      get_proc_address
