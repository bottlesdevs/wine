diff --git a/dlls/inkobjcore/configuration.c b/dlls/inkobjcore/configuration.c
new file mode 100644
--- /dev/null
+++ b/dlls/inkobjcore/configuration.c
@@ -0,0 +1,148 @@
+/*
+ * Copyright 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+struct input_configuration
+{
+    IInkInputProcessingConfiguration IInkInputProcessingConfiguration_iface;
+    LONG ref, mode, right_drag;
+    IUnknown *marshaler;
+};
+
+static struct input_configuration *impl_from_IInkInputProcessingConfiguration(IInkInputProcessingConfiguration *iface)
+{
+    return CONTAINING_RECORD(iface, struct input_configuration, IInkInputProcessingConfiguration_iface);
+}
+
+static HRESULT WINAPI configuration_QueryInterface(IInkInputProcessingConfiguration *iface, REFIID iid, void **out)
+{
+    struct input_configuration *impl = impl_from_IInkInputProcessingConfiguration(iface);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable)
+            || IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IInkInputProcessingConfiguration))
+    {
+        *out = iface;
+        IInkInputProcessingConfiguration_AddRef(iface);
+        return S_OK;
+    }
+    if (IsEqualGUID(iid, &IID_IMarshal)) return IUnknown_QueryInterface(impl->marshaler, iid, out);
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI configuration_AddRef(IInkInputProcessingConfiguration *iface)
+{
+    return InterlockedIncrement(&impl_from_IInkInputProcessingConfiguration(iface)->ref);
+}
+
+static ULONG WINAPI configuration_Release(IInkInputProcessingConfiguration *iface)
+{
+    struct input_configuration *impl = impl_from_IInkInputProcessingConfiguration(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        if (impl->marshaler) IUnknown_Release(impl->marshaler);
+        free(impl);
+        InterlockedDecrement(&ink_object_count);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI configuration_GetIids(IInkInputProcessingConfiguration *iface, ULONG *count, IID **iids)
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = NULL;
+    if (!(*iids = CoTaskMemAlloc(sizeof(**iids)))) return E_OUTOFMEMORY;
+    **iids = IID_IInkInputProcessingConfiguration;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_GetRuntimeClassName(IInkInputProcessingConfiguration *iface, HSTRING *name)
+{
+    const WCHAR *class = RuntimeClass_Windows_UI_Input_Inking_InkInputProcessingConfiguration;
+    if (!name) return E_POINTER;
+    return WindowsCreateString(class, wcslen(class), name);
+}
+
+static HRESULT WINAPI configuration_GetTrustLevel(IInkInputProcessingConfiguration *iface, TrustLevel *level)
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_get_Mode(IInkInputProcessingConfiguration *iface, enum InkInputProcessingMode *value)
+{
+    if (!value) return E_POINTER;
+    *value = InterlockedCompareExchange(&impl_from_IInkInputProcessingConfiguration(iface)->mode, 0, 0);
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_put_Mode(IInkInputProcessingConfiguration *iface, enum InkInputProcessingMode value)
+{
+    if (value < InkInputProcessingMode_None || value > InkInputProcessingMode_Erasing) return E_INVALIDARG;
+    InterlockedExchange(&impl_from_IInkInputProcessingConfiguration(iface)->mode, value);
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_get_RightDragAction(IInkInputProcessingConfiguration *iface, enum InkInputRightDragAction *value)
+{
+    if (!value) return E_POINTER;
+    *value = InterlockedCompareExchange(&impl_from_IInkInputProcessingConfiguration(iface)->right_drag, 0, 0);
+    return S_OK;
+}
+
+static HRESULT WINAPI configuration_put_RightDragAction(IInkInputProcessingConfiguration *iface, enum InkInputRightDragAction value)
+{
+    if (value != InkInputRightDragAction_LeaveUnprocessed && value != InkInputRightDragAction_AllowProcessing)
+        return E_INVALIDARG;
+    InterlockedExchange(&impl_from_IInkInputProcessingConfiguration(iface)->right_drag, value);
+    return S_OK;
+}
+
+static const IInkInputProcessingConfigurationVtbl configuration_vtbl =
+{
+    configuration_QueryInterface, configuration_AddRef, configuration_Release,
+    configuration_GetIids, configuration_GetRuntimeClassName, configuration_GetTrustLevel,
+    configuration_get_Mode, configuration_put_Mode,
+    configuration_get_RightDragAction, configuration_put_RightDragAction,
+};
+
+HRESULT ink_input_configuration_create(IInkInputProcessingConfiguration **out)
+{
+    struct input_configuration *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IInkInputProcessingConfiguration_iface.lpVtbl = &configuration_vtbl;
+    impl->ref = 1;
+    impl->mode = InkInputProcessingMode_Inking;
+    impl->right_drag = InkInputRightDragAction_AllowProcessing;
+    InterlockedIncrement(&ink_object_count);
+    hr = CoCreateFreeThreadedMarshaler((IUnknown *)&impl->IInkInputProcessingConfiguration_iface, &impl->marshaler);
+    if (FAILED(hr)) IInkInputProcessingConfiguration_Release(&impl->IInkInputProcessingConfiguration_iface);
+    else *out = &impl->IInkInputProcessingConfiguration_iface;
+    return hr;
+}
diff --git a/dlls/inkobjcore/core_host.c b/dlls/inkobjcore/core_host.c
new file mode 100644
--- /dev/null
+++ b/dlls/inkobjcore/core_host.c
@@ -0,0 +1,188 @@
+/*
+ * Copyright 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+struct root_reference
+{
+    LONG ref;
+    IContainerVisual *visual;
+};
+
+struct core_host
+{
+    ICoreInkPresenterHost ICoreInkPresenterHost_iface;
+    LONG ref;
+    IUnknown *marshaler;
+    IInkPresenter *presenter;
+    CRITICAL_SECTION lock;
+    struct root_reference *root;
+};
+
+static struct core_host *impl_from_ICoreInkPresenterHost(ICoreInkPresenterHost *iface)
+{
+    return CONTAINING_RECORD(iface, struct core_host, ICoreInkPresenterHost_iface);
+}
+
+static void root_release(struct root_reference *root)
+{
+    if (root && !InterlockedDecrement(&root->ref))
+    {
+        IContainerVisual_Release(root->visual);
+        free(root);
+    }
+}
+
+static HRESULT WINAPI host_QueryInterface(ICoreInkPresenterHost *iface, REFIID iid, void **out)
+{
+    struct core_host *impl = impl_from_ICoreInkPresenterHost(iface);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable)
+            || IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_ICoreInkPresenterHost))
+    {
+        *out = iface;
+        ICoreInkPresenterHost_AddRef(iface);
+        return S_OK;
+    }
+    if (IsEqualGUID(iid, &IID_IMarshal)) return IUnknown_QueryInterface(impl->marshaler, iid, out);
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI host_AddRef(ICoreInkPresenterHost *iface)
+{
+    return InterlockedIncrement(&impl_from_ICoreInkPresenterHost(iface)->ref);
+}
+
+static ULONG WINAPI host_Release(ICoreInkPresenterHost *iface)
+{
+    struct core_host *impl = impl_from_ICoreInkPresenterHost(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        struct root_reference *root = impl->root;
+        impl->root = NULL;
+        root_release(root);
+        if (impl->presenter) IInkPresenter_Release(impl->presenter);
+        if (impl->marshaler) IUnknown_Release(impl->marshaler);
+        DeleteCriticalSection(&impl->lock);
+        free(impl);
+        InterlockedDecrement(&ink_object_count);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI host_GetIids(ICoreInkPresenterHost *iface, ULONG *count, IID **iids)
+{
+    if (!count || !iids) return E_POINTER;
+    *count = 0;
+    *iids = NULL;
+    if (!(*iids = CoTaskMemAlloc(sizeof(**iids)))) return E_OUTOFMEMORY;
+    **iids = IID_ICoreInkPresenterHost;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI host_GetRuntimeClassName(ICoreInkPresenterHost *iface, HSTRING *name)
+{
+    const WCHAR *class = RuntimeClass_Windows_UI_Input_Inking_Core_CoreInkPresenterHost;
+    if (!name) return E_POINTER;
+    return WindowsCreateString(class, wcslen(class), name);
+}
+
+static HRESULT WINAPI host_GetTrustLevel(ICoreInkPresenterHost *iface, TrustLevel *level)
+{
+    if (!level) return E_POINTER;
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI host_get_InkPresenter(ICoreInkPresenterHost *iface, IInkPresenter **value)
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ICoreInkPresenterHost(iface)->presenter;
+    IInkPresenter_AddRef(*value);
+    return S_OK;
+}
+
+static HRESULT WINAPI host_get_RootVisual(ICoreInkPresenterHost *iface, IContainerVisual **value)
+{
+    struct core_host *impl = impl_from_ICoreInkPresenterHost(iface);
+    struct root_reference *root;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection(&impl->lock);
+    if ((root = impl->root)) InterlockedIncrement(&root->ref);
+    LeaveCriticalSection(&impl->lock);
+    if (root)
+    {
+        *value = root->visual;
+        IContainerVisual_AddRef(*value);
+        root_release(root);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI host_put_RootVisual(ICoreInkPresenterHost *iface, IContainerVisual *value)
+{
+    struct core_host *impl = impl_from_ICoreInkPresenterHost(iface);
+    struct root_reference *root = NULL, *old;
+
+    if (value)
+    {
+        if (!(root = malloc(sizeof(*root)))) return E_OUTOFMEMORY;
+        root->ref = 1;
+        root->visual = value;
+        IContainerVisual_AddRef(value);
+    }
+    EnterCriticalSection(&impl->lock);
+    old = impl->root;
+    impl->root = root;
+    LeaveCriticalSection(&impl->lock);
+    root_release(old);
+    return S_OK;
+}
+
+static const ICoreInkPresenterHostVtbl host_vtbl =
+{
+    host_QueryInterface, host_AddRef, host_Release,
+    host_GetIids, host_GetRuntimeClassName, host_GetTrustLevel,
+    host_get_InkPresenter, host_get_RootVisual, host_put_RootVisual,
+};
+
+HRESULT ink_core_host_create(IInspectable **out)
+{
+    struct core_host *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->ICoreInkPresenterHost_iface.lpVtbl = &host_vtbl;
+    impl->ref = 1;
+    InitializeCriticalSection(&impl->lock);
+    InterlockedIncrement(&ink_object_count);
+    hr = CoCreateFreeThreadedMarshaler((IUnknown *)&impl->ICoreInkPresenterHost_iface, &impl->marshaler);
+    if (SUCCEEDED(hr)) hr = ink_presenter_create(&impl->presenter);
+    if (FAILED(hr)) ICoreInkPresenterHost_Release(&impl->ICoreInkPresenterHost_iface);
+    else *out = (IInspectable *)&impl->ICoreInkPresenterHost_iface;
+    return hr;
+}
diff --git a/dlls/inkobjcore/drawing.c b/dlls/inkobjcore/drawing.c
--- a/dlls/inkobjcore/drawing.c
+++ b/dlls/inkobjcore/drawing.c
@@ -229,3 +229,82 @@
     else *out = &impl->IInkDrawingAttributes_iface;
     return hr;
 }
+
+HRESULT ink_drawing_attributes_clone(IInkDrawingAttributes *source, IInkDrawingAttributes **out)
+{
+    IInkDrawingAttributes2 *source2 = NULL, *copy2 = NULL;
+    IInkDrawingAttributes4 *source4 = NULL, *copy4 = NULL;
+    struct drawing_attributes *input, *copy;
+    struct Matrix3x2 transform;
+    struct Color color;
+    struct Size size;
+    enum PenTipShape tip;
+    boolean value;
+    HRESULT hr, query;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!source) return E_POINTER;
+    if (FAILED(hr = ink_drawing_attributes_create(out))) return hr;
+    if (source->lpVtbl == &drawing_vtbl)
+    {
+        input = impl_from_IInkDrawingAttributes(source);
+        copy = impl_from_IInkDrawingAttributes(*out);
+        EnterCriticalSection(&input->lock);
+        copy->color = input->color;
+        copy->size = input->size;
+        copy->pen_tip = input->pen_tip;
+        copy->transform = input->transform;
+        copy->ignore_pressure = input->ignore_pressure;
+        copy->fit_to_curve = input->fit_to_curve;
+        copy->highlighter = input->highlighter;
+        copy->ignore_tilt = input->ignore_tilt;
+        LeaveCriticalSection(&input->lock);
+        return S_OK;
+    }
+
+    hr = IInkDrawingAttributes_get_Color(source, &color);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_put_Color(*out, color);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_get_PenTip(source, &tip);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_put_PenTip(*out, tip);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_get_Size(source, &size);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_put_Size(*out, size);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_get_IgnorePressure(source, &value);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_put_IgnorePressure(*out, value);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_get_FitToCurve(source, &value);
+    if (SUCCEEDED(hr)) hr = IInkDrawingAttributes_put_FitToCurve(*out, value);
+    if (SUCCEEDED(hr))
+    {
+        query = IInkDrawingAttributes_QueryInterface(source, &IID_IInkDrawingAttributes2, (void **)&source2);
+        if (SUCCEEDED(query))
+        {
+            hr = IInkDrawingAttributes_QueryInterface(*out, &IID_IInkDrawingAttributes2, (void **)&copy2);
+            if (SUCCEEDED(hr)) hr = IInkDrawingAttributes2_get_PenTipTransform(source2, &transform);
+            if (SUCCEEDED(hr)) hr = IInkDrawingAttributes2_put_PenTipTransform(copy2, transform);
+            if (SUCCEEDED(hr)) hr = IInkDrawingAttributes2_get_DrawAsHighlighter(source2, &value);
+            if (SUCCEEDED(hr)) hr = IInkDrawingAttributes2_put_DrawAsHighlighter(copy2, value);
+        }
+        else if (query != E_NOINTERFACE) hr = query;
+    }
+    if (SUCCEEDED(hr))
+    {
+        query = IInkDrawingAttributes_QueryInterface(source, &IID_IInkDrawingAttributes4, (void **)&source4);
+        if (SUCCEEDED(query))
+        {
+            hr = IInkDrawingAttributes_QueryInterface(*out, &IID_IInkDrawingAttributes4, (void **)&copy4);
+            if (SUCCEEDED(hr)) hr = IInkDrawingAttributes4_get_IgnoreTilt(source4, &value);
+            if (SUCCEEDED(hr)) hr = IInkDrawingAttributes4_put_IgnoreTilt(copy4, value);
+        }
+        else if (query != E_NOINTERFACE) hr = query;
+    }
+    if (source2) IInkDrawingAttributes2_Release(source2);
+    if (copy2) IInkDrawingAttributes2_Release(copy2);
+    if (source4) IInkDrawingAttributes4_Release(source4);
+    if (copy4) IInkDrawingAttributes4_Release(copy4);
+    if (FAILED(hr))
+    {
+        IInkDrawingAttributes_Release(*out);
+        *out = NULL;
+    }
+    return hr;
+}
diff --git a/dlls/inkobjcore/events.c b/dlls/inkobjcore/events.c
new file mode 100644
--- /dev/null
+++ b/dlls/inkobjcore/events.c
@@ -0,0 +1,141 @@
+/*
+ * Copyright 2026 Mirko Brombin
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+struct ink_handler
+{
+    struct list entry;
+    LONG ref;
+    UINT id;
+    EventRegistrationToken token;
+    IUnknown *handler;
+};
+
+static void handler_release(struct ink_handler *handler)
+{
+    if (!InterlockedDecrement(&handler->ref))
+    {
+        IUnknown_Release(handler->handler);
+        free(handler);
+    }
+}
+
+void ink_events_init(struct ink_events *events)
+{
+    InitializeCriticalSection(&events->lock);
+    list_init(&events->handlers);
+    events->next_token = 0;
+    events->closed = FALSE;
+}
+
+void ink_events_clear(struct ink_events *events)
+{
+    struct list handlers = LIST_INIT(handlers);
+    struct ink_handler *handler, *next;
+
+    EnterCriticalSection(&events->lock);
+    events->closed = TRUE;
+    list_move_tail(&handlers, &events->handlers);
+    LeaveCriticalSection(&events->lock);
+    LIST_FOR_EACH_ENTRY_SAFE(handler, next, &handlers, struct ink_handler, entry)
+    {
+        list_remove(&handler->entry);
+        handler_release(handler);
+    }
+}
+
+HRESULT ink_event_add(struct ink_events *events, UINT id, IUnknown *handler, EventRegistrationToken *token)
+{
+    struct ink_handler *entry;
+    HRESULT hr = S_OK;
+
+    if (!token) return E_POINTER;
+    token->value = 0;
+    if (!handler) return E_POINTER;
+    if (!(entry = malloc(sizeof(*entry)))) return E_OUTOFMEMORY;
+    entry->ref = 1;
+    entry->id = id;
+    entry->handler = handler;
+    IUnknown_AddRef(handler);
+    EnterCriticalSection(&events->lock);
+    if (events->closed) hr = RO_E_CLOSED;
+    else if (events->next_token == MAXLONGLONG) hr = E_UNEXPECTED;
+    else
+    {
+        entry->token.value = ++events->next_token;
+        list_add_tail(&events->handlers, &entry->entry);
+        *token = entry->token;
+    }
+    LeaveCriticalSection(&events->lock);
+    if (FAILED(hr)) handler_release(entry);
+    return hr;
+}
+
+HRESULT ink_event_remove(struct ink_events *events, UINT id, EventRegistrationToken token)
+{
+    struct ink_handler *handler, *found = NULL;
+
+    EnterCriticalSection(&events->lock);
+    LIST_FOR_EACH_ENTRY(handler, &events->handlers, struct ink_handler, entry)
+    {
+        if (handler->id != id || handler->token.value != token.value) continue;
+        list_remove(&handler->entry);
+        found = handler;
+        break;
+    }
+    LeaveCriticalSection(&events->lock);
+    if (found) handler_release(found);
+    return S_OK;
+}
+
+HRESULT ink_event_notify(struct ink_events *events, UINT id, void *sender, void *args, ink_event_callback invoke)
+{
+    struct ink_handler *handler, **snapshot = NULL;
+    size_t count = 0, i = 0;
+    HRESULT hr = S_OK, result;
+
+    EnterCriticalSection(&events->lock);
+    if (events->closed)
+    {
+        LeaveCriticalSection(&events->lock);
+        return RO_E_CLOSED;
+    }
+    LIST_FOR_EACH_ENTRY(handler, &events->handlers, struct ink_handler, entry)
+        if (handler->id == id) ++count;
+    if (count && !(snapshot = malloc(count * sizeof(*snapshot))))
+    {
+        LeaveCriticalSection(&events->lock);
+        return E_OUTOFMEMORY;
+    }
+    LIST_FOR_EACH_ENTRY(handler, &events->handlers, struct ink_handler, entry)
+    {
+        if (handler->id != id) continue;
+        InterlockedIncrement(&handler->ref);
+        snapshot[i++] = handler;
+    }
+    LeaveCriticalSection(&events->lock);
+    for (i = 0; i < count; ++i)
+    {
+        result = invoke(snapshot[i]->handler, sender, args);
+        if (SUCCEEDED(hr) && FAILED(result)) hr = result;
+        handler_release(snapshot[i]);
+    }
+    free(snapshot);
+    return hr;
+}
diff --git a/dlls/inkobjcore/factory.c b/dlls/inkobjcore/factory.c
--- a/dlls/inkobjcore/factory.c
+++ b/dlls/inkobjcore/factory.c
@@ -17,8 +17,6 @@
  */
 
 #include "private.h"
-#include "initguid.h"
-#include "activation.h"
 
 struct ink_factory
 {
@@ -26,7 +24,7 @@
     IInkPointFactory IInkPointFactory_iface;
     IInkPointFactory2 IInkPointFactory2_iface;
     LONG ref;
-    BOOL point;
+    enum { FACTORY_DRAWING, FACTORY_POINT, FACTORY_HOST } kind;
 };
 
 static struct ink_factory *impl_from_IActivationFactory(IActivationFactory *iface)
@@ -43,9 +41,9 @@
