+{
+    return InterlockedIncrement( &user_statics_from_factory( iface )->ref );
+}
+
+static ULONG WINAPI user_factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &user_statics_from_factory( iface )->ref );
+}
