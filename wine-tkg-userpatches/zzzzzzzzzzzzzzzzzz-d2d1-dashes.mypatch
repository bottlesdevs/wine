     ellipse.radiusX = r->radiusX;
-    ellipse.radiusY = r->radiusY;
+    ellipse.radiusY = -r->radiusY;
 
     d2d_ellipse_to_segments(&ellipse, &start_point, segments);
 
-    d2d_point_set(&p, r->rect.left + r->radiusX, r->rect.bottom + r->radiusY);
+    d2d_point_set(&p, r->rect.left + r->radiusX, r->rect.bottom - r->radiusY);
     d2d_point_translate(&start_point, p.x, p.y);
     d2d_bezier_segment_translate(&segments[0], p.x, p.y);
-    d2d_point_set(&p, r->rect.right - r->radiusX, r->rect.bottom + r->radiusY);
+    d2d_point_set(&p, r->rect.right - r->radiusX, r->rect.bottom - r->radiusY);
     d2d_bezier_segment_translate(&segments[1], p.x, p.y);
-    d2d_point_set(&p, r->rect.right - r->radiusX, r->rect.top - r->radiusY);
+    d2d_point_set(&p, r->rect.right - r->radiusX, r->rect.top + r->radiusY);
     d2d_bezier_segment_translate(&segments[2], p.x, p.y);
-    d2d_point_set(&p, r->rect.left + r->radiusX, r->rect.top - r->radiusY);
+    d2d_point_set(&p, r->rect.left + r->radiusX, r->rect.top + r->radiusY);
     d2d_bezier_segment_translate(&segments[3], p.x, p.y);
 
     ret = d2d_figure_begin(&figure, start_point, D2D1_FIGURE_BEGIN_FILLED);
@@ -5058,7 +5386,7 @@
     d2d_point_set(&p, r->rect.right - r->radiusX, r->rect.bottom);
     ret = ret && d2d_figure_add_lines(&figure, &p, 1);
     ret = ret && d2d_figure_add_beziers(&figure, &segments[1], 1);
-    d2d_point_set(&p, r->rect.right, r->rect.top - r->radiusY);
+    d2d_point_set(&p, r->rect.right, r->rect.top + r->radiusY);
     ret = ret && d2d_figure_add_lines(&figure, &p, 1);
     ret = ret && d2d_figure_add_beziers(&figure, &segments[2], 1);
     d2d_point_set(&p, r->rect.left + r->radiusX, r->rect.top);
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -1696,14 +1696,42 @@
         return;
     }
 
+    if (stroke_style_impl)
+    {
+        if (stroke_style_impl->desc.transformType == D2D1_STROKE_TRANSFORM_TYPE_FIXED)
+            stroke_width /= context->drawing_state.transform.m11;
+    }
+
+    if (stroke_style_impl && stroke_style_impl->dash_count)
+    {
+        D2D1_MATRIX_3X2_F transform = context->drawing_state.transform;
+        float scale, tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+        ID2D1PathGeometry *dashed;
+        HRESULT hr;
+
+        if (context->drawing_state.unitMode != D2D1_UNIT_MODE_PIXELS)
+        {
+            transform._11 *= context->desc.dpiX / 96.0f;
+            transform._21 *= context->desc.dpiX / 96.0f;
+            transform._12 *= context->desc.dpiY / 96.0f;
+            transform._22 *= context->desc.dpiY / 96.0f;
+        }
+        scale = D2D1ComputeMaximumScaleFactor(&transform);
+        if (scale > 0.0f && isfinite(scale))
+            tolerance /= scale;
+
+        if (SUCCEEDED(hr = d2d_geometry_create_dashed(geometry, stroke_style_impl, stroke_width,
+                tolerance, &dashed)))
+        {
+            ID2D1DeviceContext6_FillGeometry(iface, (ID2D1Geometry *)dashed, brush, NULL);
+            ID2D1PathGeometry_Release(dashed);
+        }
+        else d2d_device_context_set_error(context, hr);
+        return;
+    }
+
     if (stroke_style)
         FIXME("Ignoring stroke style %p.\n", stroke_style);
-
-    if (stroke_style_impl)
-    {
-        if (stroke_style_impl->desc.transformType == D2D1_STROKE_TRANSFORM_TYPE_FIXED)
-            stroke_width /= context->drawing_state.transform.m11;
-    }
 
     d2d_device_context_draw_geometry(context, geometry_impl, brush_impl, stroke_width);
 }
diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -662,6 +662,8 @@
 HRESULT d2d_geometry_group_init(struct d2d_geometry *geometry, ID2D1Factory *factory,
         D2D1_FILL_MODE fill_mode, ID2D1Geometry **src_geometries, unsigned int geometry_count);
 struct d2d_geometry *unsafe_impl_from_ID2D1Geometry(ID2D1Geometry *iface);
+HRESULT d2d_geometry_create_dashed(ID2D1Geometry *geometry, const struct d2d_stroke_style *style,
+        float width, float tolerance, ID2D1PathGeometry **ret);
 
 struct d2d_geometry_realization
 {
