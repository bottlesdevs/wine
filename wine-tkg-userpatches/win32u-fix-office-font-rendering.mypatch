diff --git a/dlls/win32u/freetype.c b/dlls/win32u/freetype.c
index 1b8fb80fee..e3f91375d4 100644
--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -2824,7 +2824,32 @@ static DWORD get_subpixel_glyph_bitmap( FT_GlyphSlot glyph, FT_BBox bbox, UINT f
         if (matrices)
             pFT_Outline_Transform( &glyph->outline, &matrices[matrix_vert] );

-        pFT_Render_Glyph( glyph, render_mode );
+        if (pFT_Render_Glyph( glyph, render_mode ))
+        {
+            FT_Bitmap bitmap = {0};
+            DWORD gray_pitch = (width + 3) & ~3;
+            INT row;
+
+            bitmap.width = width;
+            bitmap.rows = height;
+            bitmap.pitch = gray_pitch;
+            bitmap.pixel_mode = FT_PIXEL_MODE_GRAY;
+            bitmap.buffer = buf;
+
+            pFT_Outline_Translate( &glyph->outline, -bbox.xMin, -bbox.yMin );
+            memset( buf, 0, buflen );
+            if (pFT_Outline_Get_Bitmap( library, &glyph->outline, &bitmap )) return GDI_ERROR;
+
+            for (row = height - 1; row >= 0; row--)
+            {
+                BYTE *gray = buf + row * gray_pitch;
+                UINT *color = (UINT *)(buf + row * pitch);
+
+                for (x = width - 1; x >= 0; x--)
+                    color[x] = gray[x] * 0x010101;
+            }
+            return needed;
+        }

         src_pitch = glyph->bitmap.pitch;
         src_width = glyph->bitmap.width;
diff --git a/dlls/win32u/ntgdi_private.h b/dlls/win32u/ntgdi_private.h
index 72b36ec7e9..1f7203f71c 100644
--- a/dlls/win32u/ntgdi_private.h
+++ b/dlls/win32u/ntgdi_private.h
@@ -553,6 +553,19 @@ static inline void order_rect( RECT *rect )
     }
 }

+static inline UINT decode_utf16_codepoint( const WCHAR *str, UINT count, UINT *index )
+{
+    UINT high = str[*index];
+
+    if (*index + 1 < count && high >= 0xd800 && high <= 0xdbff &&
+        str[*index + 1] >= 0xdc00 && str[*index + 1] <= 0xdfff)
+    {
+        UINT low = str[++*index];
+        return 0x10000 + ((high - 0xd800) << 10) + (low - 0xdc00);
+    }
+    return high;
+}
+
 static inline void get_bounding_rect( RECT *rect, int x, int y, int width, int height )
 {
     rect->left   = x;
