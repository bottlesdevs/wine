UI Automation core providers used by Office.

diff --git a/dlls/uiautomationcore/tests/uiautomation.c b/dlls/uiautomationcore/tests/uiautomation.c
index c76205f..b5b1469 100644
--- a/dlls/uiautomationcore/tests/uiautomation.c
+++ b/dlls/uiautomationcore/tests/uiautomation.c
@@ -16263,8 +16263,57 @@ static const struct uia_com_classes com_classes[] = {
     { &CLSID_CUIAutomation8, &IID_IUIAutomation4 },
     { &CLSID_CUIAutomation8, &IID_IUIAutomation5 },
     { &CLSID_CUIAutomation8, &IID_IUIAutomation6 },
+    { &CLSID_CUIAutomationRegistrar, &IID_IUnknown },
+    { &CLSID_CUIAutomationRegistrar, &IID_IUIAutomationRegistrar },
 };

+static void test_CUIAutomationRegistrar(void)
+{
+    static const GUID property_guid = {0xa6292a76,0xcff7,0x46dc,{0x81,0xb4,0x93,0xf4,0x02,0x1c,0x34,0x65}};
+    static const GUID event_guid = {0xb13ed8b7,0xe438,0x4d84,{0x99,0x02,0x59,0x49,0xc2,0x7d,0x38,0x21}};
+    struct UIAutomationPropertyInfo property = {property_guid, L"Wine.TestProperty", UIAutomationType_String};
+    struct UIAutomationEventInfo event = {event_guid, L"Wine.TestEvent"};
+    IUIAutomationRegistrar *registrar;
+    PROPERTYID property_id, duplicate_id;
+    EVENTID event_id, duplicate_event_id;
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_CUIAutomationRegistrar, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IUIAutomationRegistrar, (void **)&registrar);
+    ok(hr == S_OK, "Failed to create IUIAutomationRegistrar, hr %#lx.\n", hr);
+    if (FAILED(hr)) return;
+
+    hr = IUIAutomationRegistrar_RegisterProperty(registrar, &property, &property_id);
+    ok(hr == S_OK, "Failed to register property, hr %#lx.\n", hr);
+    ok(property_id != 0, "Unexpected property id %d.\n", property_id);
+    ok(UiaLookupId(AutomationIdentifierType_Property, &property_guid) == property_id,
+            "UiaLookupId did not return registered property id %d.\n", property_id);
+
+    hr = IUIAutomationRegistrar_RegisterProperty(registrar, &property, &duplicate_id);
+    ok(hr == S_OK, "Failed to register property again, hr %#lx.\n", hr);
+    ok(duplicate_id == property_id, "Expected property id %d, got %d.\n", property_id, duplicate_id);
+
+    property.type = UIAutomationType_Bool;
+    hr = IUIAutomationRegistrar_RegisterProperty(registrar, &property, &duplicate_id);
+    ok(FAILED(hr), "Expected failure for conflicting property registration, got %#lx.\n", hr);
+
+    hr = IUIAutomationRegistrar_RegisterEvent(registrar, &event, &event_id);
+    ok(hr == S_OK, "Failed to register event, hr %#lx.\n", hr);
+    ok(event_id != 0, "Unexpected event id %d.\n", event_id);
+    ok(UiaLookupId(AutomationIdentifierType_Event, &event_guid) == event_id,
+            "UiaLookupId did not return registered event id %d.\n", event_id);
+
+    hr = IUIAutomationRegistrar_RegisterEvent(registrar, &event, &duplicate_event_id);
+    ok(hr == S_OK, "Failed to register event again, hr %#lx.\n", hr);
+    ok(duplicate_event_id == event_id, "Expected event id %d, got %d.\n", event_id, duplicate_event_id);
+
+    event.pProgrammaticName = L"Wine.OtherEvent";
+    hr = IUIAutomationRegistrar_RegisterEvent(registrar, &event, &duplicate_event_id);
+    ok(FAILED(hr), "Expected failure for conflicting event registration, got %#lx.\n", hr);
+
+    IUIAutomationRegistrar_Release(registrar);
+}
+
 static void test_CUIAutomation(void)
 {
     BOOL has_cui8 = TRUE, tmp_b;
@@ -18682,6 +18731,7 @@ START_TEST(uiautomation)
     test_UiaGetUpdatedCache();
     test_UiaNavigate();
     test_UiaFind();
+    test_CUIAutomationRegistrar();
     test_CUIAutomation();
     test_default_clientside_providers();
     test_UiaGetRootNode();
diff --git a/dlls/uiautomationcore/uia_ids.c b/dlls/uiautomationcore/uia_ids.c
index 434494a..21147dc 100644
--- a/dlls/uiautomationcore/uia_ids.c
+++ b/dlls/uiautomationcore/uia_ids.c
@@ -23,6 +23,28 @@

 WINE_DEFAULT_DEBUG_CHANNEL(uiautomation);

+struct uia_custom_property
+{
+    struct list entry;
+    struct uia_prop_info info;
+    GUID guid;
+    WCHAR *name;
+};
+
+struct uia_custom_event
+{
+    struct list entry;
+    struct uia_event_info info;
+    GUID guid;
+    WCHAR *name;
+};
+
+static struct list custom_properties = LIST_INIT(custom_properties);
+static struct list custom_events = LIST_INIT(custom_events);
+static SRWLOCK custom_registration_lock = SRWLOCK_INIT;
+static LONG next_custom_event_id = UIA_NotificationEventId;
+static LONG next_custom_property_id = UIA_IsDialogPropertyId;
+
 static int __cdecl uia_property_guid_compare(const void *a, const void *b)
 {
     const GUID *guid = a;
@@ -320,21 +342,44 @@ static const int prop_id_idx[] = {

 static const struct uia_prop_info *uia_prop_info_from_guid(const GUID *guid)
 {
+    struct uia_custom_property *custom;
     struct uia_prop_info *prop;

     if ((prop = bsearch(guid, default_uia_properties, ARRAY_SIZE(default_uia_properties), sizeof(*prop),
             uia_property_guid_compare)))
         return prop;

+    AcquireSRWLockShared(&custom_registration_lock);
+    LIST_FOR_EACH_ENTRY(custom, &custom_properties, struct uia_custom_property, entry)
+    {
+        if (IsEqualGUID(&custom->guid, guid))
+        {
+            ReleaseSRWLockShared(&custom_registration_lock);
+            return &custom->info;
+        }
+    }
+    ReleaseSRWLockShared(&custom_registration_lock);
     return NULL;
 }

 const struct uia_prop_info *uia_prop_info_from_id(PROPERTYID prop_id)
 {
-    if ((prop_id < PROP_ID_MIN) || (prop_id >= PROP_ID_MAX))
-        return NULL;
+    struct uia_custom_property *custom;
+
+    if ((prop_id >= PROP_ID_MIN) && (prop_id < PROP_ID_MAX))
+        return &default_uia_properties[prop_id_idx[prop_id - PROP_ID_MIN]];

-    return &default_uia_properties[prop_id_idx[prop_id - PROP_ID_MIN]];
+    AcquireSRWLockShared(&custom_registration_lock);
+    LIST_FOR_EACH_ENTRY(custom, &custom_properties, struct uia_custom_property, entry)
+    {
+        if (custom->info.prop_id == prop_id)
+        {
+            ReleaseSRWLockShared(&custom_registration_lock);
+            return &custom->info;
+        }
+    }
+    ReleaseSRWLockShared(&custom_registration_lock);
+    return NULL;
 }

 /* Sorted by GUID. */
@@ -426,21 +471,129 @@ static const int event_id_idx[] = {

 static const struct uia_event_info *uia_event_info_from_guid(const GUID *guid)
 {
+    struct uia_custom_event *custom;
     struct uia_event_info *event;

     if ((event = bsearch(guid, default_uia_events, ARRAY_SIZE(default_uia_events), sizeof(*event),
             uia_event_guid_compare)))
         return event;

+    AcquireSRWLockShared(&custom_registration_lock);
+    LIST_FOR_EACH_ENTRY(custom, &custom_events, struct uia_custom_event, entry)
+    {
+        if (IsEqualGUID(&custom->guid, guid))
+        {
+            ReleaseSRWLockShared(&custom_registration_lock);
+            return &custom->info;
+        }
+    }
+    ReleaseSRWLockShared(&custom_registration_lock);
     return NULL;
 }

 const struct uia_event_info *uia_event_info_from_id(EVENTID event_id)
 {
-    if ((event_id < EVENT_ID_MIN) || (event_id >= EVENT_ID_MAX))
-        return NULL;
+    struct uia_custom_event *custom;
+
+    if ((event_id >= EVENT_ID_MIN) && (event_id < EVENT_ID_MAX))
+        return &default_uia_events[event_id_idx[event_id - EVENT_ID_MIN]];
+
+    AcquireSRWLockShared(&custom_registration_lock);
+    LIST_FOR_EACH_ENTRY(custom, &custom_events, struct uia_custom_event, entry)
+    {
+        if (custom->info.event_id == event_id)
+        {
+            ReleaseSRWLockShared(&custom_registration_lock);
+            return &custom->info;
+        }
+    }
+    ReleaseSRWLockShared(&custom_registration_lock);
+    return NULL;
+}
+
+HRESULT uia_register_property(const struct UIAutomationPropertyInfo *property, PROPERTYID *property_id)
+{
+    struct uia_custom_property *custom;
+    HRESULT hr = S_OK;
+
+    if (!property || !property_id) return E_INVALIDARG;
+    *property_id = 0;
+    if (!property->pProgrammaticName || !*property->pProgrammaticName ||
+            IsEqualGUID(&property->guid, &GUID_NULL))
+        return E_INVALIDARG;
+    if (property->type != UIAutomationType_Int && property->type != UIAutomationType_Bool &&
+            property->type != UIAutomationType_String && property->type != UIAutomationType_Double &&
+            property->type != UIAutomationType_Point && property->type != UIAutomationType_Element)
+        return E_INVALIDARG;
+
+    AcquireSRWLockExclusive(&custom_registration_lock);
+    LIST_FOR_EACH_ENTRY(custom, &custom_properties, struct uia_custom_property, entry)
+    {
+        if (!IsEqualGUID(&custom->guid, &property->guid)) continue;
+        if (custom->info.type != property->type || wcscmp(custom->name, property->pProgrammaticName))
+            hr = E_INVALIDARG;
+        else
+            *property_id = custom->info.prop_id;
+        goto done;
+    }
+
+    if (!(custom = calloc(1, sizeof(*custom))) ||
+            !(custom->name = wcsdup(property->pProgrammaticName)))
+    {
+        free(custom);
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+
+    custom->guid = property->guid;
+    custom->info.guid = &custom->guid;
+    custom->info.prop_id = ++next_custom_property_id;
+    custom->info.prop_type = PROP_TYPE_ELEM_PROP;
+    custom->info.type = property->type;
+    list_add_tail(&custom_properties, &custom->entry);
+    *property_id = custom->info.prop_id;
+
+done:
+    ReleaseSRWLockExclusive(&custom_registration_lock);
+    return hr;
+}
+
+HRESULT uia_register_event(const struct UIAutomationEventInfo *event, EVENTID *event_id)
+{
+    struct uia_custom_event *custom;
+    HRESULT hr = S_OK;
+
+    if (!event || !event_id) return E_INVALIDARG;
+    *event_id = 0;
+    if (!event->pProgrammaticName || !*event->pProgrammaticName || IsEqualGUID(&event->guid, &GUID_NULL))
+        return E_INVALIDARG;
+
+    AcquireSRWLockExclusive(&custom_registration_lock);
+    LIST_FOR_EACH_ENTRY(custom, &custom_events, struct uia_custom_event, entry)
+    {
+        if (!IsEqualGUID(&custom->guid, &event->guid)) continue;
+        if (wcscmp(custom->name, event->pProgrammaticName)) hr = E_INVALIDARG;
+        else *event_id = custom->info.event_id;
+        goto done;
+    }
+
+    if (!(custom = calloc(1, sizeof(*custom))) || !(custom->name = wcsdup(event->pProgrammaticName)))
+    {
+        free(custom);
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+
+    custom->guid = event->guid;
+    custom->info.guid = &custom->guid;
+    custom->info.event_id = ++next_custom_event_id;
+    custom->info.event_arg_type = EventArgsType_Simple;
+    list_add_tail(&custom_events, &custom->entry);
+    *event_id = custom->info.event_id;

-    return &default_uia_events[event_id_idx[event_id - EVENT_ID_MIN]];
+done:
+    ReleaseSRWLockExclusive(&custom_registration_lock);
+    return hr;
 }

 /* Sorted by GUID. */
diff --git a/dlls/uiautomationcore/uia_main.c b/dlls/uiautomationcore/uia_main.c
index 8c7a72b..0805b55 100644
--- a/dlls/uiautomationcore/uia_main.c
+++ b/dlls/uiautomationcore/uia_main.c
@@ -403,6 +403,109 @@ BOOL WINAPI DllMain(HINSTANCE hinst, DWORD reason, void *reserved)
     return TRUE;
 }

+struct uia_registrar
+{
+    IUIAutomationRegistrar IUIAutomationRegistrar_iface;
+    LONG ref;
+};
+
+static struct uia_registrar *impl_from_IUIAutomationRegistrar(IUIAutomationRegistrar *iface)
+{
+    return CONTAINING_RECORD(iface, struct uia_registrar, IUIAutomationRegistrar_iface);
+}
+
+static HRESULT WINAPI uia_registrar_QueryInterface(IUIAutomationRegistrar *iface, REFIID riid, void **ppv)
+{
+    *ppv = NULL;
+    if (IsEqualIID(riid, &IID_IUIAutomationRegistrar) || IsEqualIID(riid, &IID_IUnknown))
+        *ppv = iface;
+    else
+        return E_NOINTERFACE;
+
+    IUIAutomationRegistrar_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI uia_registrar_AddRef(IUIAutomationRegistrar *iface)
+{
+    struct uia_registrar *registrar = impl_from_IUIAutomationRegistrar(iface);
+    ULONG ref = InterlockedIncrement(&registrar->ref);
+
+    TRACE("%p, refcount %ld\n", registrar, ref);
+    return ref;
+}
+
+static ULONG WINAPI uia_registrar_Release(IUIAutomationRegistrar *iface)
+{
+    struct uia_registrar *registrar = impl_from_IUIAutomationRegistrar(iface);
+    ULONG ref = InterlockedDecrement(&registrar->ref);
+
+    TRACE("%p, refcount %ld\n", registrar, ref);
+    if (!ref) free(registrar);
+    return ref;
+}
+
+static HRESULT WINAPI uia_registrar_RegisterProperty(IUIAutomationRegistrar *iface,
+        const struct UIAutomationPropertyInfo *property, PROPERTYID *property_id)
+{
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", iface, property, property_id);
+
+    hr = uia_register_property(property, property_id);
+    TRACE("registered %s (%s, type %u) as %d, hr %#lx\n", debugstr_guid(&property->guid),
+            debugstr_w(property->pProgrammaticName), property->type, *property_id, hr);
+    return hr;
+}
+
+static HRESULT WINAPI uia_registrar_RegisterEvent(IUIAutomationRegistrar *iface,
+        const struct UIAutomationEventInfo *event, EVENTID *event_id)
+{
+    HRESULT hr;
+
+    TRACE("%p, %p, %p\n", iface, event, event_id);
+
+    hr = uia_register_event(event, event_id);
+    TRACE("registered %s (%s) as %d, hr %#lx\n", debugstr_guid(&event->guid),
+            debugstr_w(event->pProgrammaticName), *event_id, hr);
+    return hr;
+}
+
+static HRESULT WINAPI uia_registrar_RegisterPattern(IUIAutomationRegistrar *iface,
+        const struct UIAutomationPatternInfo *pattern, PATTERNID *pattern_id,
+        PROPERTYID *available_property_id, UINT property_count, PROPERTYID *property_ids,
+        UINT event_count, EVENTID *event_ids)
+{
+    TRACE("%p, %p, %p, %p, %u, %p, %u, %p\n", iface, pattern, pattern_id,
+            available_property_id, property_count, property_ids, event_count, event_ids);
+    FIXME("custom pattern registration is not implemented\n");
+    return E_NOTIMPL;
+}
+
+static const IUIAutomationRegistrarVtbl uia_registrar_vtbl =
+{
+    uia_registrar_QueryInterface,
+    uia_registrar_AddRef,
+    uia_registrar_Release,
+    uia_registrar_RegisterProperty,
+    uia_registrar_RegisterEvent,
+    uia_registrar_RegisterPattern,
+};
+
+static HRESULT create_uia_registrar(REFIID riid, void **ppv)
+{
+    struct uia_registrar *registrar;
+    HRESULT hr;
+
+    if (!(registrar = calloc(1, sizeof(*registrar)))) return E_OUTOFMEMORY;
+    registrar->IUIAutomationRegistrar_iface.lpVtbl = &uia_registrar_vtbl;
+    registrar->ref = 1;
+
+    hr = IUIAutomationRegistrar_QueryInterface(&registrar->IUIAutomationRegistrar_iface, riid, ppv);
+    IUIAutomationRegistrar_Release(&registrar->IUIAutomationRegistrar_iface);
+    return hr;
+}
+
 /* UIAutomation ClassFactory */
 struct uia_cf {
     IClassFactory IClassFactory_iface;
@@ -467,6 +570,8 @@ static HRESULT WINAPI uia_cf_CreateInstance(IClassFactory *iface, IUnknown *pout
         hr = create_uia_iface(&obj, FALSE);
     else if (IsEqualGUID(cf->clsid, &CLSID_CUIAutomation8))
         hr = create_uia_iface(&obj, TRUE);
+    else if (IsEqualGUID(cf->clsid, &CLSID_CUIAutomationRegistrar))
+        return create_uia_registrar(riid, ppv);
     else
         return E_NOINTERFACE;

@@ -520,7 +625,8 @@ HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **ppv)
 {
     TRACE("(%s, %s, %p)\n", debugstr_guid(clsid), debugstr_guid(riid), ppv);

-    if (IsEqualGUID(clsid, &CLSID_CUIAutomation) || IsEqualGUID(clsid, &CLSID_CUIAutomation8))
+    if (IsEqualGUID(clsid, &CLSID_CUIAutomation) || IsEqualGUID(clsid, &CLSID_CUIAutomation8) ||
+            IsEqualGUID(clsid, &CLSID_CUIAutomationRegistrar))
         return create_uia_cf(clsid, riid, ppv);

     return CLASS_E_CLASSNOTAVAILABLE;
